@page
@model EventTicketSystem.Web.Pages.AI.AIPredictionModel
@{
    ViewData["Title"] = "Dự Đoán AI - Nhu Cầu Vé";
}

<div class="container">
    <h1 class="mb-2">Dự Đoán AI Nhu Cầu Bán Vé</h1>
    <p class="text-muted mb-4">Sử dụng ML.NET (SDCA Regression) để dự báo số vé bán dựa trên lịch sử.</p>

    <!-- Model Metrics -->
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold d-flex justify-content-between align-items-center">
            <span>📊 Chỉ Số Mô Hình</span>
            @if (Model.IsTrained)
            {
                <span class="badge bg-success">Đã Huấn Luyện</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Chưa Huấn Luyện</span>
            }
        </div>
        <div class="card-body">
            <div class="row text-center g-3">
                <div class="col-md-4">
                    <div class="border rounded p-3">
                        <div class="text-muted small">R² (Độ Chính Xác)</div>
                        <div class="fs-3 fw-bold text-primary">@Model.R2.ToString("F4")</div>
                        <div class="text-muted small">Càng gần 1.0 càng tốt</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3">
                        <div class="text-muted small">MAE (Sai Số Tuyệt Đối TB)</div>
                        <div class="fs-3 fw-bold text-warning">@Model.Mae.ToString("F2")</div>
                        <div class="text-muted small">Sai lệch trung bình (vé)</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3">
                        <div class="text-muted small">RMSE (Căn Sai Số Bình Phương)</div>
                        <div class="fs-3 fw-bold text-danger">@Model.Rmse.ToString("F2")</div>
                        <div class="text-muted small">Sai lệch toàn phần (vé)</div>
                    </div>
                </div>
            </div>
            <div class="mt-3 alert alert-info py-2 mb-0">
                <small>
                    <strong>Ghi chú:</strong> Mô hình được huấn luyện trên dữ liệu tổng hợp (800 mẫu).
                    Các đặc trưng: tháng tổ chức, ngày trong tuần, số ngày còn lại, giá vé, sức chứa, danh mục sự kiện.
                </small>
            </div>
        </div>
    </div>

    <!-- Predictions per event -->
    <h4 class="mb-3">Dự Báo Cho Từng Sự Kiện</h4>

    @foreach (var evt in Model.Predictions)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-secondary me-2">@evt.Category</span>
                    <strong>@evt.EventTitle</strong>
                </div>
                <small class="text-muted">📅 @evt.StartDate.ToLocalTime().ToString("dd/MM/yyyy")</small>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Loại Vé</th>
                            <th class="text-end">Giá</th>
                            <th class="text-center">Tổng Chỗ</th>
                            <th class="text-center">Đã Bán</th>
                            <th class="text-center">AI Dự Báo</th>
                            <th class="text-center">Tỉ Lệ Dự Báo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in evt.Tickets)
                        {
                            var pct = t.TotalQuantity > 0 ? (double)t.Predicted / t.TotalQuantity * 100 : 0;
                            <tr>
                                <td>@t.TicketName</td>
                                <td class="text-end">@t.Price.ToString("N0") đ</td>
                                <td class="text-center">@t.TotalQuantity</td>
                                <td class="text-center">@t.SoldQuantity</td>
                                <td class="text-center fw-bold text-primary">@t.Predicted</td>
                                <td class="text-center">
                                    <div class="progress" style="height:18px">
                                        <div class="progress-bar @(pct >= 80 ? "bg-danger" : pct >= 50 ? "bg-warning" : "bg-success")"
                                             style="width:@pct.ToString("F0")%">
                                            @pct.ToString("F0")%
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (!Model.Predictions.Any())
    {
        <div class="alert alert-warning">Không có sự kiện nào đang hoạt động.</div>
    }
</div>
