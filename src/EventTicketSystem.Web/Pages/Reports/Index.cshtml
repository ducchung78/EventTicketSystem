@page
@model EventTicketSystem.Web.Pages.Reports.ReportsIndexModel
@{
    ViewData["Title"] = "Báo Cáo Doanh Thu";
}

<div class="container-fluid px-2">
    <h1 class="mb-4">Báo Cáo Doanh Thu</h1>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-success shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-white-50 small">Tổng Doanh Thu</div>
                            <div class="fs-4 fw-bold">@Model.TongDoanhThu.ToString("N0") đ</div>
                        </div>
                        <span class="display-6 opacity-50">💰</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-white-50 small">Tổng Đơn Hàng</div>
                            <div class="fs-4 fw-bold">@Model.TongDonHang</div>
                        </div>
                        <span class="display-6 opacity-50">📋</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-dark small">Tổng Vé Bán Ra</div>
                            <div class="fs-4 fw-bold text-dark">@Model.TongVeBan</div>
                        </div>
                        <span class="display-6 opacity-50">🎟</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts row 1 -->
    <div class="row g-4 mb-4">
        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">Doanh Thu 30 Ngày Gần Nhất</div>
                <div class="card-body">
                    <canvas id="chartDay" height="120"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header fw-bold">Doanh Thu Theo Tháng (@DateTime.UtcNow.Year)</div>
                <div class="card-body">
                    <canvas id="chartMonth" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart row 2 -->
    <div class="row g-4">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header fw-bold">Doanh Thu Theo Sự Kiện (Top 8)</div>
                <div class="card-body">
                    <canvas id="chartEvent" height="120"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const dayLabels   = @Html.Raw(Model.DayLabels);
        const dayData     = @Html.Raw(Model.DayData);
        const monthLabels = @Html.Raw(Model.MonthLabels);
        const monthData   = @Html.Raw(Model.MonthData);
        const eventLabels = @Html.Raw(Model.EventLabels);
        const eventData   = @Html.Raw(Model.EventData);

        new Chart(document.getElementById('chartDay'), {
            type: 'line',
            data: {
                labels: dayLabels,
                datasets: [{
                    label: 'Doanh thu (đ)',
                    data: dayData,
                    borderColor: 'rgb(25,135,84)',
                    backgroundColor: 'rgba(25,135,84,0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });

        new Chart(document.getElementById('chartMonth'), {
            type: 'bar',
            data: {
                labels: monthLabels,
                datasets: [{
                    label: 'Doanh thu (đ)',
                    data: monthData,
                    backgroundColor: 'rgba(13,110,253,0.7)'
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });

        new Chart(document.getElementById('chartEvent'), {
            type: 'bar',
            data: {
                labels: eventLabels,
                datasets: [{
                    label: 'Doanh thu (đ)',
                    data: eventData,
                    backgroundColor: [
                        'rgba(255,99,132,0.7)','rgba(54,162,235,0.7)','rgba(255,205,86,0.7)',
                        'rgba(75,192,192,0.7)','rgba(153,102,255,0.7)','rgba(255,159,64,0.7)',
                        'rgba(25,135,84,0.7)','rgba(220,53,69,0.7)'
                    ]
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { legend: { display: false } }
            }
        });
    </script>
}
