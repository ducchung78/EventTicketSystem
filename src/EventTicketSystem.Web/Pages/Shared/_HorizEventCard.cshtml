@model EventTicketSystem.Web.Models.Event
@{
    var cheapest = Model.TicketTypes
        .Where(t => t.AvailableQuantity > 0)
        .OrderBy(t => t.Price)
        .FirstOrDefault();

    var catEmoji = Model.Category switch
    {
        "Âm nhạc"   => "🎵",
        "Nghệ thuật" => "🎭",
        "Thể thao"   => "🏆",
        "Hội thảo"   => "💡",
        "Tham quan"  => "🌿",
        _            => "🎟"
    };

    var dateStr = Model.StartDate.ToLocalTime().ToString("dd 'tháng' MM, yyyy");
}

<div class="tc-card">
    <div class="tc-card-img-wrap">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img class="tc-card-img" src="@Model.ImageUrl" alt="@Model.Title" loading="lazy" />
        }
        else
        {
            <div class="tc-card-img-placeholder">
                <span style="font-size:2.5rem; opacity:.22;">🎟</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Category))
        {
            <div class="tc-card-badge">
                <span class="tc-badge-icon">@catEmoji</span>
                <span class="tc-badge-name">@Model.Category</span>
            </div>
        }
    </div>

    <div class="tc-card-body">
        <h3 class="tc-card-title">@Model.Title</h3>

        @if (cheapest != null)
        {
            <div class="tc-card-price">
                <span class="tc-price-prefix">Từ </span>@cheapest.Price.ToString("N0")đ
            </div>
        }
        else
        {
            <div class="tc-card-price" style="color:#666;">Hết vé</div>
        }

        <div class="tc-card-date">
            <span class="tc-date-icon">📅</span>
            <span>@dateStr</span>
        </div>
    </div>

    <a href="/Events/Details/@Model.Id" class="stretched-link" aria-label="@Model.Title"></a>
</div>
