@model EventTicketSystem.Web.Models.Event
@{
    var cheapest = Model.TicketTypes
        .Where(t => t.AvailableQuantity > 0)
        .OrderBy(t => t.Price)
        .FirstOrDefault();
    var dateStr = Model.StartDate.ToLocalTime().ToString("dd 'tháng' MM, yyyy");
}

<a href="/Events/Details/@Model.Id" class="event-card ec-item">
    <div class="event-card-thumb">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Title" loading="lazy" />
        }
        else
        {
            <div class="ph-icon">🎟</div>
        }
    </div>
    <div class="event-card-body">
        <div class="event-card-name">@Model.Title</div>
        @if (cheapest != null)
        {
            <div class="event-card-price">Từ @cheapest.Price.ToString("N0")đ</div>
        }
        else
        {
            <div class="event-card-price" style="color:#555;">Hết vé</div>
        }
        <div class="event-card-date">
            <svg viewBox="0 0 16 16" fill="currentColor"><path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/></svg>
            @dateStr
        </div>
    </div>
</a>
