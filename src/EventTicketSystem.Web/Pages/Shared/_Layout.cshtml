@inject Microsoft.AspNetCore.Identity.UserManager<EventTicketSystem.Web.Models.ApplicationUser> UserMgr
@inject EventTicketSystem.Web.Services.CartService CartSvc
@inject EventTicketSystem.Web.Data.AppDbContext DbCtx
@using Microsoft.EntityFrameworkCore
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TicketHub</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EventTicketSystem.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        EventTicketSystem.Web.Models.ApplicationUser? currentUser = null;
        if (User.Identity?.IsAuthenticated == true)
            currentUser = await UserMgr.GetUserAsync(User);

        int unreadMsgCount = 0;
        if (User.IsInRole("Admin"))
            unreadMsgCount = await DbCtx.ContactMessages.CountAsync(m => !m.IsRead);
    }

    <header>
        @* ===== NAVBAR – xanh lá #00c853 ===== *@
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid px-4">

                <a class="navbar-brand" asp-area="" asp-page="/Index">TicketHub</a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navMain"
                        aria-controls="navMain" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="navMain">

                    @* Search (center) *@
                    <form class="navbar-form" action="/Events" method="get">
                        <div class="navbar-form-inner">
                            <span class="navbar-search-icon">🔍</span>
                            <input type="text" name="search"
                                   class="navbar-search-input"
                                   data-i18n-ph="search-ph"
                                   placeholder="Bạn tìm gì hôm nay?" />
                            <button type="submit" class="btn-search-green"
                                    data-i18n="search-btn">Tìm kiếm</button>
                        </div>
                    </form>

                    @* Right links *@
                    <ul class="navbar-nav ms-auto align-items-center flex-row gap-2">

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a href="/Events/Create" class="btn-navbar-create"
                                   data-i18n="create-event">+ Tạo sự kiện</a>
                            </li>
                        }

                        @{
                            var cartCount = CartSvc.GetCartCount(Context.Session);
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-1 d-flex align-items-center gap-1"
                                   asp-page="/Orders/MyOrders"
                                   style="white-space:nowrap; font-size:.88rem;">
                                    <span style="font-size:1.05rem;">🎫</span>
                                    <span data-i18n="my-tickets">Vé của tôi</span>
                                </a>
                            </li>
                            @* Cart icon — cạnh "Vé của tôi" *@
                            <li class="nav-item">
                                <a href="/Cart" class="cart-nav-link" title="Giỏ hàng">
                                    🛒
                                    <span id="navCartBadge" class="cart-badge"
                                          style="@(cartCount == 0 ? "display:none;" : "")">
                                        @(cartCount > 99 ? "99+" : cartCount.ToString())
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-1"
                                   href="#" data-bs-toggle="dropdown" role="button"
                                   style="font-size:.88rem; white-space:nowrap;">
                                    <span style="font-size:1.05rem;">👤</span>
                                    <span>@(currentUser?.HoTen ?? User.Identity!.Name)</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end nav-dropdown-dark">
                                    <li>
                                        <div class="nav-dd-user-info">
                                            <div class="nav-dd-name">@(currentUser?.HoTen ?? User.Identity!.Name)</div>
                                            <div class="nav-dd-email">@User.Identity!.Name</div>
                                        </div>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><span class="dropdown-item-text" style="padding:.25rem 1rem;"><span class="badge bg-danger" style="font-size:.68rem;">Admin</span></span></li>
                                        <li><hr class="dropdown-divider nav-dd-divider" /></li>
                                        <li><a class="dropdown-item nav-dd-item" href="/Account/Profile">👤 Thông Tin Tài Khoản</a></li>
                                        <li><a class="dropdown-item nav-dd-item" href="/Account/ChangePassword">🔒 Đổi Mật Khẩu</a></li>
                                        <li><hr class="dropdown-divider nav-dd-divider" /></li>
                                        <li><a class="dropdown-item nav-dd-item" asp-page="/Orders/Index" data-i18n="all-orders">📋 Tất Cả Đơn</a></li>
                                        <li><a class="dropdown-item nav-dd-item" asp-page="/Customers/Index" data-i18n="customers">👥 Khách Hàng</a></li>
                                        <li><a class="dropdown-item nav-dd-item" asp-page="/Reports/Index" data-i18n="reports">📊 Báo Cáo</a></li>
                                        <li><a class="dropdown-item nav-dd-item" asp-page="/AI/Index" data-i18n="ai-predict">🤖 Dự Đoán AI</a></li>
                                        <li><a class="dropdown-item nav-dd-item" href="/Coupons">🎟 Mã Giảm Giá</a></li>
                                        <li>
                                            <a class="dropdown-item nav-dd-item d-flex align-items-center justify-content-between" href="/Admin/Messages">
                                                <span>📬 Hòm Thư</span>
                                                @if (unreadMsgCount > 0)
                                                {
                                                    <span style="background:#e53935;color:#fff;font-size:.68rem;font-weight:700;padding:2px 7px;border-radius:50px;">@unreadMsgCount</span>
                                                }
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li><hr class="dropdown-divider nav-dd-divider" /></li>
                                        <li><a class="dropdown-item nav-dd-item" href="/Account/Profile">👤 Thông Tin Tài Khoản</a></li>
                                        <li><a class="dropdown-item nav-dd-item" asp-page="/Orders/MyOrders">🎫 Vé Của Tôi</a></li>
                                        <li><a class="dropdown-item nav-dd-item" href="/Account/ChangePassword">🔒 Đổi Mật Khẩu</a></li>
                                    }
                                    <li><hr class="dropdown-divider nav-dd-divider" /></li>
                                    <li>
                                        <form method="post" asp-page="/Account/Logout">
                                            <button type="submit" class="dropdown-item nav-dd-item nav-dd-logout"
                                                    data-i18n="logout">🚪 Đăng Xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            @* Cart icon for guests *@
                            <li class="nav-item">
                                <a href="/Cart" class="cart-nav-link" title="Giỏ hàng">
                                    🛒
                                    <span id="navCartBadge" class="cart-badge"
                                          style="@(cartCount == 0 ? "display:none;" : "")">
                                        @(cartCount > 99 ? "99+" : cartCount.ToString())
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item auth-links d-flex align-items-center gap-1">
                                <a asp-page="/Account/Login" data-i18n="login">Đăng nhập</a>
                                <span class="auth-sep">|</span>
                                <a asp-page="/Account/Register" data-i18n="register">Đăng ký</a>
                            </li>
                        }

                        @* Language switcher *@
                        <li class="nav-item dropdown">
                            <button class="nav-link border-0 bg-transparent px-2 d-flex align-items-center gap-1 lang-toggle"
                                    data-bs-toggle="dropdown" type="button"
                                    style="font-size:.88rem; font-weight:600;">
                                <span id="langFlag" style="font-size:1.15rem; line-height:1;">🇻🇳</span>
                                <span id="langCode">VI</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" style="min-width:140px; padding:.3rem 0;">
                                <li>
                                    <button class="dropdown-item lang-opt d-flex align-items-center gap-2"
                                            data-lang="vi" type="button">🇻🇳 Tiếng Việt</button>
                                </li>
                                <li>
                                    <button class="dropdown-item lang-opt d-flex align-items-center gap-2"
                                            data-lang="en" type="button">🇬🇧 English</button>
                                </li>
                            </ul>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>

        @* ===== MENU BAR – đen #111 ===== *@
        <nav class="category-nav" aria-label="Danh mục sự kiện">
            <div class="container-fluid px-4">
                <ul class="nav flex-nowrap" style="overflow-x:auto; scrollbar-width:none;">
                    <li class="nav-item"><a class="nav-link cat-link" asp-page="/Events/Index" asp-route-category="Âm nhạc"   data-i18n="cat-music">Nhạc sống</a></li>
                    <li class="nav-item"><a class="nav-link cat-link" asp-page="/Events/Index" asp-route-category="Nghệ thuật" data-i18n="cat-art">Sân khấu &amp; Nghệ thuật</a></li>
                    <li class="nav-item"><a class="nav-link cat-link" asp-page="/Events/Index" asp-route-category="Thể thao"  data-i18n="cat-sport">Thể Thao</a></li>
                    <li class="nav-item"><a class="nav-link cat-link" asp-page="/Events/Index" asp-route-category="Hội thảo"  data-i18n="cat-workshop">Hội thảo &amp; Workshop</a></li>
                    <li class="nav-item"><a class="nav-link cat-link" asp-page="/Events/Index" asp-route-category="Tham quan"  data-i18n="cat-tour">Tham quan &amp; Trải nghiệm</a></li>
                    <li class="nav-item"><a class="nav-link cat-link" asp-page="/Events/Index" data-i18n="cat-other">Khác</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link cat-link cat-mailbox-link" href="/Admin/Messages">
                                📬 Hòm Thư
                                @if (unreadMsgCount > 0)
                                {
                                    <span class="cat-mailbox-badge">@unreadMsgCount</span>
                                }
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link cat-link" href="/Contact">Liên Hệ</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container text-center">
            <p class="fw-semibold mb-1">
                <span style="color:#00c853; font-size:1.15rem; font-weight:800; letter-spacing:-.4px;">TicketHub</span>
            </p>
            <p class="small mb-0" data-i18n="footer-copy">© 2026 TicketHub. Nền tảng đặt vé sự kiện hàng đầu Việt Nam.</p>
        </div>
    </footer>

    <style>
    /* ── Dark user dropdown ── */
    .nav-dropdown-dark {
        background: rgba(18,8,46,.97) !important;
        border: 1px solid rgba(124,77,255,.3) !important;
        border-radius: 14px !important;
        box-shadow: 0 8px 40px rgba(0,0,0,.55), 0 2px 12px rgba(124,77,255,.15) !important;
        padding: .4rem 0 !important;
        min-width: 210px !important;
        backdrop-filter: blur(16px);
    }
    .nav-dd-user-info {
        padding: .7rem 1rem .6rem;
        border-bottom: 1px solid rgba(124,77,255,.15);
        margin-bottom: .25rem;
    }
    .nav-dd-name {
        font-size: .88rem; font-weight: 700; color: #ede0ff; line-height: 1.3;
    }
    .nav-dd-email {
        font-size: .75rem; color: rgba(210,195,255,.4); margin-top: 2px;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .nav-dd-divider {
        border-color: rgba(124,77,255,.15) !important;
        margin: .25rem 0 !important;
    }
    .nav-dd-item {
        color: rgba(210,195,255,.78) !important;
        font-size: .85rem !important;
        padding: .48rem 1rem !important;
        border-radius: 0 !important;
        transition: background .12s, color .12s !important;
    }
    .nav-dd-item:hover, .nav-dd-item:focus {
        background: rgba(124,77,255,.14) !important;
        color: #ede0ff !important;
    }
    .nav-dd-logout {
        color: rgba(239,154,154,.75) !important;
        width: 100%; text-align: left; background: none; border: none;
    }
    .nav-dd-logout:hover, .nav-dd-logout:focus {
        background: rgba(229,57,53,.12) !important;
        color: #ef9a9a !important;
    }

    .cat-mailbox-link { position: relative; }
    .cat-mailbox-badge {
        display: inline-block; background: #e53935; color: #fff;
        font-size: .62rem; font-weight: 700; line-height: 1;
        padding: 2px 5px; border-radius: 50px; min-width: 17px; text-align: center;
        vertical-align: middle; margin-left: 4px;
    }
    .cart-nav-link {
        position: relative; display: inline-flex; align-items: center;
        font-size: 1.2rem; padding: 4px 6px; text-decoration: none;
        transition: opacity .15s;
    }
    .cart-nav-link:hover { opacity: .75; }
    .cart-badge {
        position: absolute; top: -4px; right: -6px;
        background: #e53935; color: #fff;
        font-size: .62rem; font-weight: 700; line-height: 1;
        padding: 2px 5px; border-radius: 50px; min-width: 17px; text-align: center;
        border: 1px solid rgba(0,0,0,.2);
    }
    </style>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @* ===== i18n language switcher ===== *@
    <script>
    (function () {
        var dict = {
            vi: {
                'search-ph':        'Bạn tìm gì hôm nay?',
                'search-btn':       'Tìm kiếm',
                'create-event':     '+ Tạo sự kiện',
                'my-tickets':       'Vé của tôi',
                'login':            'Đăng nhập',
                'register':         'Đăng ký',
                'all-orders':       '📋 Tất Cả Đơn',
                'customers':        '👥 Khách Hàng',
                'reports':          '📊 Báo Cáo',
                'ai-predict':       '🤖 Dự Đoán AI',
                'logout':           '🚪 Đăng Xuất',
                'cat-music':        'Nhạc sống',
                'cat-art':          'Sân khấu & Nghệ thuật',
                'cat-sport':        'Thể Thao',
                'cat-workshop':     'Hội thảo & Workshop',
                'cat-tour':         'Tham quan & Trải nghiệm',
                'cat-other':        'Khác',
                'footer-copy':      '© 2026 TicketHub. Nền tảng đặt vé sự kiện hàng đầu Việt Nam.',
                /* Homepage */
                'hot-events':       'Sự Kiện Nổi Bật',
                'special-events':   'Sự Kiện Đặc Biệt',
                'time-events':      'Sự Kiện Theo Thời Gian',
                'weekend-tab':      'Cuối Tuần Này',
                'month-tab':        'Tháng Này',
                'music-section':    'Nhạc Sống',
                'art-section':      'Sân Khấu Nghệ Thuật',
                'workshop-section': 'Hội Thảo & Workshop',
                'tour-section':     'Tham Quan & Trải Nghiệm',
                'sports-section':   'Thể Thao & Các Loại Khác',
                'venues-section':   'Điểm Đến Thú Vị',
                'see-all':          'Xem tất cả →',
                'see-all-events':   'Xem Tất Cả Sự Kiện →',
                'view-detail':      'Xem chi tiết',
                /* Login */
                'login-title':      'Đăng nhập',
                'login-sub':        'Chào mừng trở lại TicketHub!',
                'login-email-ph':   'Nhập email hoặc số điện thoại',
                'login-pwd-ph':     'Nhập mật khẩu',
                'captcha-txt':      'Tôi không phải robot',
                'btn-continue':     'Tiếp tục',
                'btn-login':        'Đăng Nhập',
                'forgot-pwd':       'Quên mật khẩu?',
                'or-divider':       'Hoặc',
                'google-btn':       'Đăng nhập bằng Google',
                'no-account':       'Chưa có tài khoản?',
                'create-account':   'Tạo tài khoản ngay'
            },
            en: {
                'search-ph':        'What are you looking for?',
                'search-btn':       'Search',
                'create-event':     '+ Create Event',
                'my-tickets':       'My Tickets',
                'login':            'Login',
                'register':         'Register',
                'all-orders':       '📋 All Orders',
                'customers':        '👥 Customers',
                'reports':          '📊 Reports',
                'ai-predict':       '🤖 AI Predictions',
                'logout':           '🚪 Sign Out',
                'cat-music':        'Live Music',
                'cat-art':          'Stage & Arts',
                'cat-sport':        'Sports',
                'cat-workshop':     'Conference & Workshop',
                'cat-tour':         'Tours & Experiences',
                'cat-other':        'Others',
                'footer-copy':      "© 2026 TicketHub. Vietnam’s leading event ticketing platform.",
                'hot-events':       'Featured Events',
                'special-events':   'Special Events',
                'time-events':      'Events by Time',
                'weekend-tab':      'This Weekend',
                'month-tab':        'This Month',
                'music-section':    'Live Music',
                'art-section':      'Stage & Arts',
                'workshop-section': 'Conference & Workshop',
                'tour-section':     'Tours & Experiences',
                'sports-section':   'Sports & Others',
                'venues-section':   'Interesting Venues',
                'see-all':          'See all →',
                'see-all-events':   'View All Events →',
                'view-detail':      'View Details',
                'login-title':      'Sign In',
                'login-sub':        'Welcome back to TicketHub!',
                'login-email-ph':   'Enter email or phone number',
                'login-pwd-ph':     'Enter password',
                'captcha-txt':      'I am not a robot',
                'btn-continue':     'Continue',
                'btn-login':        'Sign In',
                'forgot-pwd':       'Forgot password?',
                'or-divider':       'Or',
                'google-btn':       'Sign in with Google',
                'no-account':       'Don’t have an account?',
                'create-account':   'Create account'
            }
        };

        function applyLang(lang) {
            var d = dict[lang] || dict['vi'];

            /* text nodes */
            document.querySelectorAll('[data-i18n]').forEach(function (el) {
                var k = el.getAttribute('data-i18n');
                if (d[k] !== undefined) el.textContent = d[k];
            });

            /* placeholder attributes */
            document.querySelectorAll('[data-i18n-ph]').forEach(function (el) {
                var k = el.getAttribute('data-i18n-ph');
                if (d[k] !== undefined) el.placeholder = d[k];
            });

            /* flag + code indicator */
            var flagEl = document.getElementById('langFlag');
            var codeEl = document.getElementById('langCode');
            if (flagEl) flagEl.textContent = lang === 'en' ? '🇬🇧' : '🇻🇳';
            if (codeEl) codeEl.textContent = lang === 'en' ? 'EN' : 'VI';

            /* highlight active option */
            document.querySelectorAll('.lang-opt').forEach(function (btn) {
                var active = btn.dataset.lang === lang;
                btn.style.fontWeight = active ? '700' : '';
                btn.style.color     = active ? '#00c853' : '';
            });

            /* persist */
            try { localStorage.setItem('th_lang', lang); } catch (e) {}
        }

        function setLang(lang) { applyLang(lang); }
        window.setLang = setLang;

        document.addEventListener('DOMContentLoaded', function () {
            /* bind lang-opt buttons */
            document.querySelectorAll('.lang-opt').forEach(function (btn) {
                btn.addEventListener('click', function () { applyLang(this.dataset.lang); });
            });

            /* restore saved language */
            var saved = 'vi';
            try { saved = localStorage.getItem('th_lang') || 'vi'; } catch (e) {}
            applyLang(saved);
        });
    })();
    </script>
</body>
</html>
