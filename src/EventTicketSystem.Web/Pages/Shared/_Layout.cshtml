@inject Microsoft.AspNetCore.Identity.UserManager<EventTicketSystem.Web.Models.ApplicationUser> UserMgr
@inject EventTicketSystem.Web.Services.CartService CartSvc
@inject EventTicketSystem.Web.Data.AppDbContext DbCtx
@using Microsoft.EntityFrameworkCore
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | TicketBox - Mua vé hòa nhạc, hội thảo" : "TicketBox - Mua vé hòa nhạc, hội thảo")</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content="Mua vé hòa nhạc, hội thảo, sự kiện thể thao trực tuyến tại TicketBox" />
    <meta name="theme-color" content="#22c55e" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EventTicketSystem.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="bg-lines" aria-hidden="true"><div class="bg-line-3"></div></div>
    @{
        EventTicketSystem.Web.Models.ApplicationUser? currentUser = null;
        if (User.Identity?.IsAuthenticated == true)
            currentUser = await UserMgr.GetUserAsync(User);

        int unreadMsgCount = 0;
        if (User.IsInRole("Admin"))
            unreadMsgCount = await DbCtx.ContactMessages.CountAsync(m => !m.IsRead);

        EventTicketSystem.Web.Models.FooterSettings? fs = await DbCtx.FooterSettings.FirstOrDefaultAsync();
        string fsHotline      = fs?.Hotline          ?? "1900 6208";
        string fsSupportHours = fs?.SupportHours     ?? "8:00 – 22:00 (Thứ 2 – CN)";
        string fsEmail        = fs?.Email            ?? "support@tickethub.vn";
        string fsAddress      = fs?.Address          ?? "Hà Nội & TP. Hồ Chí Minh, Việt Nam";
        string fsBizLicense   = fs?.BusinessLicense  ?? "0123456789";
        string fsLicDate      = fs?.LicenseDate      ?? "01/01/2024";
        string fsLicPlace     = fs?.LicensePlace     ?? "Hà Nội";
    }

    <header>
        @* ===== NAVBAR – xanh lá #00c853 ===== *@
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid px-4">

                <a class="navbar-brand" asp-area="" asp-page="/Index">TicketHub</a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navMain"
                        aria-controls="navMain" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="navMain">

                    @* Search (center) *@
                    <form class="navbar-form" action="/Events" method="get">
                        <div class="navbar-form-inner">
                            <span class="navbar-search-icon">🔍</span>
                            <input type="text" name="search"
                                   class="navbar-search-input"
                                   data-i18n-ph="search-ph"
                                   placeholder="Bạn tìm gì hôm nay?" />
                            <button type="submit" class="btn-search-green"
                                    data-i18n="search-btn">Tìm kiếm</button>
                        </div>
                    </form>

                    @* Right links *@
                    <ul class="navbar-nav ms-auto align-items-center flex-row gap-2">

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a href="/Events/Create" class="btn-navbar-create"
                                   data-i18n="create-event">+ Tạo sự kiện</a>
                            </li>
                        }

                        @{
                            var cartCount = CartSvc.GetCartCount(Context.Session);
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-1 d-flex align-items-center gap-1"
                                   asp-page="/Orders/MyOrders"
                                   style="white-space:nowrap; font-size:.88rem;">
                                    <span style="font-size:1.05rem;">🎫</span>
                                    <span data-i18n="my-tickets">Vé của tôi</span>
                                </a>
                            </li>
                            @* Cart icon — cạnh "Vé của tôi" *@
                            <li class="nav-item">
                                <a href="/Cart" class="cart-nav-link" title="Giỏ hàng">
                                    🛒
                                    <span id="navCartBadge" class="cart-badge"
                                          style="@(cartCount == 0 ? "display:none;" : "")">
                                        @(cartCount > 99 ? "99+" : cartCount.ToString())
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-1"
                                   href="#" data-bs-toggle="dropdown" role="button"
                                   style="font-size:.88rem; white-space:nowrap;">
                                    @if (!string.IsNullOrEmpty(currentUser?.AvatarUrl))
                                    {
                                        <img src="@currentUser.AvatarUrl" alt="" style="width:22px;height:22px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                                    }
                                    else
                                    {
                                        <span style="font-size:1.05rem;">👤</span>
                                    }
                                    <span>@(currentUser?.HoTen ?? User.Identity!.Name)</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end nav-dropdown-dark">
                                    <li>
                                        <div class="nav-dd-user-info">
                                            <div class="nav-dd-name">@(currentUser?.HoTen ?? User.Identity!.Name)</div>
                                            <div class="nav-dd-email">@User.Identity!.Name</div>
                                        </div>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><span class="dropdown-item-text" style="padding:.25rem 1rem;"><span class="badge bg-danger" style="font-size:.68rem;">Admin</span></span></li>
                                        <li><hr class="dropdown-divider nav-dd-divider" /></li>
                                        <li><a class="dropdown-item nav-dd-item" href="/Account/Profile">👤 Thông Tin Tài Khoản</a></li>
                                        <li><a class="dropdown-item nav-dd-item" href="/Account/ChangePassword">🔒 Đổi Mật Khẩu</a></li>
                                        <li><hr class="dropdown-divider nav-dd-divider" /></li>
                                        <li><a class="dropdown-item nav-dd-item" asp-page="/Orders/Index" data-i18n="all-orders">📋 Tất Cả Đơn</a></li>
                                        <li><a class="dropdown-item nav-dd-item" asp-page="/Customers/Index" data-i18n="customers">👥 Khách Hàng</a></li>
                                        <li><a class="dropdown-item nav-dd-item" asp-page="/Reports/Index" data-i18n="reports">📊 Báo Cáo</a></li>
                                        <li><a class="dropdown-item nav-dd-item" asp-page="/AI/Index" data-i18n="ai-predict">🤖 Dự Đoán AI</a></li>
                                        <li><a class="dropdown-item nav-dd-item" href="/Coupons">🎟 Mã Giảm Giá</a></li>
                                        <li><a class="dropdown-item nav-dd-item" href="/Admin/PaymentMethods"><i class="bi bi-credit-card me-1"></i>Phương Thức Thanh Toán</a></li>
                                        <li>
                                            <a class="dropdown-item nav-dd-item d-flex align-items-center justify-content-between" href="/Admin/Messages">
                                                <span>📬 Hòm Thư</span>
                                                @if (unreadMsgCount > 0)
                                                {
                                                    <span style="background:#e53935;color:#fff;font-size:.68rem;font-weight:700;padding:2px 7px;border-radius:50px;">@unreadMsgCount</span>
                                                }
                                            </a>
                                        </li>
                                        <li><a class="dropdown-item nav-dd-item" href="/Admin/RefundRequests">🔄 Hoàn Vé</a></li>
                                        <li><a class="dropdown-item nav-dd-item" asp-page="/Admin/FooterSettings">⚙️ Cài đặt Footer</a></li>
                                        @if (User.IsInRole("SuperAdmin"))
                                        {
                                            <li><hr class="dropdown-divider nav-dd-divider" /></li>
                                            <li><a class="dropdown-item nav-dd-item" href="/Admin/Staff">👥 Nhân Viên</a></li>
                                            <li><a class="dropdown-item nav-dd-item" href="/Admin/AISettings">⚙️ Cấu Hình AI</a></li>
                                        }
                                    }
                                    else
                                    {
                                        <li><hr class="dropdown-divider nav-dd-divider" /></li>
                                        <li><a class="dropdown-item nav-dd-item" href="/Account/Profile">👤 Thông Tin Tài Khoản</a></li>
                                        <li><a class="dropdown-item nav-dd-item" asp-page="/Orders/MyOrders">🎫 Vé Của Tôi</a></li>
                                        <li><a class="dropdown-item nav-dd-item" href="/Account/ChangePassword">🔒 Đổi Mật Khẩu</a></li>
                                    }
                                    <li><hr class="dropdown-divider nav-dd-divider" /></li>
                                    <li>
                                        <form method="post" asp-page="/Account/Logout">
                                            <button type="submit" class="dropdown-item nav-dd-item nav-dd-logout"
                                                    data-i18n="logout">🚪 Đăng Xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            @* Cart icon for guests *@
                            <li class="nav-item">
                                <a href="/Cart" class="cart-nav-link" title="Giỏ hàng">
                                    🛒
                                    <span id="navCartBadge" class="cart-badge"
                                          style="@(cartCount == 0 ? "display:none;" : "")">
                                        @(cartCount > 99 ? "99+" : cartCount.ToString())
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item auth-links d-flex align-items-center gap-1">
                                <a asp-page="/Account/Login" data-i18n="login">Đăng nhập</a>
                                <span class="auth-sep">|</span>
                                <a asp-page="/Account/Register" data-i18n="register">Đăng ký</a>
                            </li>
                        }

                        @* Language switcher *@
                        <li class="nav-item dropdown">
                            <button class="nav-link border-0 bg-transparent px-2 d-flex align-items-center gap-1 lang-toggle"
                                    data-bs-toggle="dropdown" type="button"
                                    style="font-size:.88rem; font-weight:600;">
                                <span id="langFlag" style="font-size:1.15rem; line-height:1;">🇻🇳</span>
                                <span id="langCode">VI</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" style="min-width:140px; padding:.3rem 0;">
                                <li>
                                    <button class="dropdown-item lang-opt d-flex align-items-center gap-2"
                                            data-lang="vi" type="button">🇻🇳 Tiếng Việt</button>
                                </li>
                                <li>
                                    <button class="dropdown-item lang-opt d-flex align-items-center gap-2"
                                            data-lang="en" type="button">🇬🇧 English</button>
                                </li>
                            </ul>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>

        @* ===== MENU BAR – đen #111 ===== *@
        <nav class="category-nav" aria-label="Danh mục sự kiện">
            <div class="container-fluid px-4">
                <ul class="nav flex-nowrap" style="overflow-x:auto; scrollbar-width:none;">
                    <li class="nav-item"><a class="nav-link cat-link cat-home-link" asp-page="/Index"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16" style="margin-right:4px;vertical-align:-1px;"><path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5v-5h3v5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z"/></svg>Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link cat-link" asp-page="/Events/Index" asp-route-category="Âm nhạc"   data-i18n="cat-music">Nhạc sống</a></li>
                    <li class="nav-item"><a class="nav-link cat-link" asp-page="/Events/Index" asp-route-category="Nghệ thuật" data-i18n="cat-art">Sân khấu &amp; Nghệ thuật</a></li>
                    <li class="nav-item"><a class="nav-link cat-link" asp-page="/Events/Index" asp-route-category="Thể thao"  data-i18n="cat-sport">Thể Thao</a></li>
                    <li class="nav-item"><a class="nav-link cat-link" asp-page="/Events/Index" asp-route-category="Hội thảo"  data-i18n="cat-workshop">Hội thảo &amp; Workshop</a></li>
                    <li class="nav-item"><a class="nav-link cat-link" asp-page="/Events/Index" asp-route-category="Tham quan"  data-i18n="cat-tour">Tham quan &amp; Trải nghiệm</a></li>
                    <li class="nav-item"><a class="nav-link cat-link" asp-page="/Events/Index" data-i18n="cat-other">Khác</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link cat-link cat-mailbox-link" href="/Admin/Messages">
                                📬 Hòm Thư
                                @if (unreadMsgCount > 0)
                                {
                                    <span class="cat-mailbox-badge">@unreadMsgCount</span>
                                }
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link cat-link" href="/Contact">Liên Hệ</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4 pb-2">
                <div class="col-12 col-md-4">
                    <span class="footer-col-title" style="color:#00C853; font-size:1.1rem; font-weight:800; letter-spacing:-.3px;">TicketHub</span>
                    <ul class="list-unstyled footer-links">
                        <li style="font-size:.84rem; margin-bottom:.5rem;">📞 Hotline: <strong style="color:#ddd;">@fsHotline</strong></li>
                        <li style="font-size:.84rem; margin-bottom:.5rem;">🕐 Hỗ trợ: @fsSupportHours</li>
                        <li style="font-size:.84rem; margin-bottom:.5rem;">📧 <a href="mailto:@fsEmail">@fsEmail</a></li>
                        <li style="font-size:.84rem; margin-bottom:.5rem;">📍 @fsAddress</li>
                        <li style="margin-top:.75rem;">
                            <a href="/tra-cuu-don-hang" style="color:#00C853; font-weight:600; font-size:.84rem;">🔍 Tra cứu đơn hàng</a>
                        </li>
                    </ul>
                </div>
                <div class="col-6 col-md-4">
                    <span class="footer-col-title">Dành cho Khách hàng</span>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-page="/Events/Index">Khám phá sự kiện</a></li>
                        <li><a asp-page="/Orders/MyOrders">Vé của tôi</a></li>
                        <li><a href="/tra-cuu-don-hang">Tra cứu đơn hàng</a></li>
                        <li><a href="/Contact">Liên hệ hỗ trợ</a></li>
                    </ul>
                    <span class="footer-col-title mt-3">Dành cho Ban Tổ chức</span>
                    <ul class="list-unstyled footer-links">
                        <li><a href="/Events/Create">Tạo sự kiện</a></li>
                        <li><a asp-page="/Reports/Index">Báo cáo & Thống kê</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-4">
                    <span class="footer-col-title">Về TicketHub</span>
                    <ul class="list-unstyled footer-links">
                        <li><a href="/About">Giới thiệu</a></li>
                        <li><a href="/Terms">Điều khoản sử dụng</a></li>
                        <li><a href="/Privacy">Chính sách bảo mật</a></li>
                        <li><a href="/Contact">Liên hệ</a></li>
                    </ul>
                    <div class="mt-3" style="font-size:.8rem; color:#444;">
                        <div>Giấy phép ĐKKD số: @fsBizLicense</div>
                        <div>Cấp ngày @fsLicDate tại @fsLicPlace</div>
                    </div>
                </div>
            </div>
            <div class="footer-copy" data-i18n="footer-copy">
                © 2026 TicketHub. Nền tảng đặt vé sự kiện hàng đầu Việt Nam.
            </div>
        </div>
    </footer>

    <style>
    /* ── Dark user dropdown ── */
    .nav-dropdown-dark {
        background: #1e1e1e !important;
        border: 1px solid #2a2a2a !important;
        border-radius: 8px !important;
        box-shadow: 0 8px 32px rgba(0,0,0,.55) !important;
        padding: .4rem 0 !important;
        min-width: 210px !important;
    }
    .nav-dd-user-info {
        padding: .7rem 1rem .6rem;
        border-bottom: 1px solid #2a2a2a;
        margin-bottom: .25rem;
    }
    .nav-dd-name {
        font-size: .88rem; font-weight: 700; color: #fff; line-height: 1.3;
    }
    .nav-dd-email {
        font-size: .75rem; color: #555; margin-top: 2px;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .nav-dd-divider {
        border-color: #2a2a2a !important;
        margin: .25rem 0 !important;
    }
    .nav-dd-item {
        color: #aaaaaa !important;
        font-size: .85rem !important;
        padding: .48rem 1rem !important;
        border-radius: 0 !important;
        transition: background .12s, color .12s !important;
    }
    .nav-dd-item:hover, .nav-dd-item:focus {
        background: #2a2a2a !important;
        color: #fff !important;
    }
    .nav-dd-logout {
        color: rgba(239,154,154,.75) !important;
        width: 100%; text-align: left; background: none; border: none;
    }
    .nav-dd-logout:hover, .nav-dd-logout:focus {
        background: rgba(229,57,53,.12) !important;
        color: #ef9a9a !important;
    }

    .cat-mailbox-link { position: relative; }
    .cat-mailbox-badge {
        display: inline-block; background: #e53935; color: #fff;
        font-size: .62rem; font-weight: 700; line-height: 1;
        padding: 2px 5px; border-radius: 50px; min-width: 17px; text-align: center;
        vertical-align: middle; margin-left: 4px;
    }
    .cart-nav-link {
        position: relative; display: inline-flex; align-items: center;
        font-size: 1.2rem; padding: 4px 6px; text-decoration: none;
        transition: opacity .15s;
    }
    .cart-nav-link:hover { opacity: .75; }
    .cart-badge {
        position: absolute; top: -4px; right: -6px;
        background: #e53935; color: #fff;
        font-size: .62rem; font-weight: 700; line-height: 1;
        padding: 2px 5px; border-radius: 50px; min-width: 17px; text-align: center;
        border: 1px solid rgba(0,0,0,.2);
    }
    </style>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @* ===== FLOATING AI CHAT ===== *@
    <style>
    #aiChatFab {
        position: fixed; bottom: 28px; right: 28px;
        width: 52px; height: 52px; border-radius: 50%;
        background: #00C853; color: #111;
        border: none; cursor: pointer; z-index: 9000;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; box-shadow: 0 4px 18px rgba(0,200,83,.45);
        transition: transform .18s, box-shadow .18s;
    }
    #aiChatFab:hover { transform: scale(1.1); box-shadow: 0 6px 24px rgba(0,200,83,.6); }
    #aiChatPanel {
        position: fixed; bottom: 92px; right: 28px;
        width: 330px; max-width: calc(100vw - 40px);
        height: 440px; max-height: calc(100vh - 120px);
        background: #1c1c1c; border: 1px solid #2a2a2a;
        border-radius: 14px; box-shadow: 0 8px 40px rgba(0,0,0,.6);
        display: flex; flex-direction: column; z-index: 8999;
        overflow: hidden;
        transform: scale(.92) translateY(12px);
        opacity: 0; pointer-events: none;
        transition: transform .22s cubic-bezier(.34,1.56,.64,1), opacity .18s;
    }
    #aiChatPanel.open {
        transform: scale(1) translateY(0);
        opacity: 1; pointer-events: all;
    }
    .ai-chat-header {
        background: #00C853; color: #111;
        padding: .7rem 1rem; font-weight: 700; font-size: .92rem;
        display: flex; align-items: center; justify-content: space-between;
        flex-shrink: 0;
    }
    .ai-chat-header-title { display: flex; align-items: center; gap: 8px; }
    .ai-chat-close {
        background: none; border: none; color: #111;
        font-size: 1.1rem; cursor: pointer; line-height: 1;
        padding: 0; opacity: .7;
    }
    .ai-chat-close:hover { opacity: 1; }
    .ai-chat-messages {
        flex: 1; overflow-y: auto; padding: .8rem;
        display: flex; flex-direction: column; gap: .6rem;
        scrollbar-width: thin; scrollbar-color: #333 transparent;
    }
    .ai-msg {
        max-width: 85%; padding: .55rem .8rem;
        border-radius: 14px; font-size: .85rem; line-height: 1.5;
        word-break: break-word;
    }
    .ai-msg.bot {
        background: #2a2a2a; color: #e0e0e0;
        align-self: flex-start; border-bottom-left-radius: 4px;
    }
    .ai-msg.user {
        background: #00C853; color: #111; font-weight: 600;
        align-self: flex-end; border-bottom-right-radius: 4px;
    }
    .ai-chat-footer {
        flex-shrink: 0; padding: .7rem;
        border-top: 1px solid #2a2a2a;
        display: flex; gap: .5rem; align-items: center;
    }
    .ai-chat-input {
        flex: 1; background: #2a2a2a; border: 1px solid #3a3a3a;
        border-radius: 8px; color: #fff; padding: .45rem .75rem;
        font-size: .85rem; outline: none;
        transition: border-color .15s;
    }
    .ai-chat-input:focus { border-color: #00C853; }
    .ai-chat-input::placeholder { color: #555; }
    .ai-chat-send {
        background: #00C853; color: #111; border: none;
        border-radius: 8px; padding: .45rem .7rem;
        font-size: .9rem; font-weight: 700; cursor: pointer;
        transition: background .15s;
        display: flex; align-items: center;
    }
    .ai-chat-send:hover { background: #00a846; }
    @@media (max-width: 480px) {
        #aiChatFab { bottom: 16px; right: 16px; }
        #aiChatPanel { bottom: 80px; right: 12px; width: calc(100vw - 24px); }
    }
    </style>

    <button id="aiChatFab" title="Chat với AI TicketHub" aria-label="Mở hộp chat AI">
        💬
    </button>
    <div id="aiChatPanel" role="dialog" aria-label="Chat AI">
        <div class="ai-chat-header">
            <div class="ai-chat-header-title">
                <span>🤖</span>
                <span>Trợ lý TicketHub AI</span>
            </div>
            <button class="ai-chat-close" id="aiChatClose" aria-label="Đóng">✕</button>
        </div>
        <div class="ai-chat-messages" id="aiChatMessages">
            <div class="ai-msg bot">Xin chào! Tôi là trợ lý AI của TicketHub. Tôi có thể giúp bạn tìm sự kiện, tra cứu vé, hoặc hỗ trợ mua vé. Bạn cần hỏi gì? 😊</div>
        </div>
        <div class="ai-chat-footer">
            <input id="aiChatInput" class="ai-chat-input" type="text"
                   placeholder="Nhập tin nhắn..." autocomplete="off" maxlength="500" />
            <button class="ai-chat-send" id="aiChatSendBtn" title="Gửi">
                ➤
            </button>
        </div>
    </div>
    <script>
    (function () {
        var fab      = document.getElementById('aiChatFab');
        var panel    = document.getElementById('aiChatPanel');
        var closeBtn = document.getElementById('aiChatClose');
        var input    = document.getElementById('aiChatInput');
        var sendBtn  = document.getElementById('aiChatSendBtn');
        var messages = document.getElementById('aiChatMessages');
        var busy     = false;

        function togglePanel() {
            panel.classList.toggle('open');
            if (panel.classList.contains('open')) input.focus();
        }
        fab.addEventListener('click', togglePanel);
        closeBtn.addEventListener('click', function () { panel.classList.remove('open'); });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && panel.classList.contains('open'))
                panel.classList.remove('open');
        });

        function appendMsg(text, role, isHtml) {
            var d = document.createElement('div');
            d.className = 'ai-msg ' + role;
            if (isHtml) d.innerHTML = text; else d.textContent = text;
            messages.appendChild(d);
            messages.scrollTop = messages.scrollHeight;
            return d;
        }

        function setLoading(on) {
            busy = on;
            input.disabled  = on;
            sendBtn.disabled = on;
            sendBtn.style.opacity = on ? '.45' : '';
        }

        function showTyping() {
            var d = document.createElement('div');
            d.className = 'ai-msg bot ai-typing';
            d.innerHTML = '<span></span><span></span><span></span>';
            messages.appendChild(d);
            messages.scrollTop = messages.scrollHeight;
            return d;
        }

        async function sendMessage() {
            if (busy) return;
            var text = input.value.trim();
            if (!text) return;

            appendMsg(text, 'user');
            input.value = '';
            setLoading(true);
            var typing = showTyping();

            try {
                var res = await fetch('/api/chat/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text })
                });

                typing.remove();

                if (res.status === 401) {
                    appendMsg('Bạn cần <a href="/Account/Login" style="color:#00C853;">đăng nhập</a> để dùng tính năng AI chat.', 'bot', true);
                    return;
                }
                if (res.status === 429) {
                    appendMsg('Bạn đang gửi tin nhắn quá nhanh. Vui lòng chờ 1 phút rồi thử lại. ⏳', 'bot');
                    return;
                }

                var data = await res.json().catch(function() { return {}; });

                if (!res.ok || data.error) {
                    appendMsg(data.error || 'AI tạm thời không khả dụng. Vui lòng thử lại sau. 🙏', 'bot');
                    return;
                }

                appendMsg(data.response || '(Không có phản hồi)', 'bot');

            } catch (err) {
                typing.remove();
                appendMsg('Không thể kết nối đến máy chủ. Vui lòng kiểm tra mạng và thử lại. 🔌', 'bot');
            } finally {
                setLoading(false);
                input.focus();
            }
        }

        sendBtn.addEventListener('click', sendMessage);
        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
        });
    })();
    </script>
    <style>
    .ai-typing { display: flex !important; align-items: center; gap: 5px; padding: .55rem .9rem !important; }
    .ai-typing span {
        width: 7px; height: 7px; border-radius: 50%;
        background: #00C853; display: inline-block;
        animation: aiDot .9s ease-in-out infinite;
    }
    .ai-typing span:nth-child(2) { animation-delay: .15s; }
    .ai-typing span:nth-child(3) { animation-delay: .3s; }
    @@keyframes aiDot {
        0%, 60%, 100% { transform: translateY(0); opacity: .4; }
        30%            { transform: translateY(-6px); opacity: 1; }
    }
    .ai-msg.bot a { color: #00C853; }
    </style>

