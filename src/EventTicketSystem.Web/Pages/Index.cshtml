@page
@model IndexModel
@{
    ViewData["Title"] = "Trang Chủ";
    var hotList  = Model.HotEvents;
    var slideCount = (hotList.Count + 1) / 2;
}

<style>
    /* ===== Homepage ===== */
    .horiz-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; padding-bottom: 8px; }
    .horiz-scroll::-webkit-scrollbar { height: 4px; }
    .horiz-scroll::-webkit-scrollbar-track { background: #1a1a1a; }
    .horiz-scroll::-webkit-scrollbar-thumb { background: #333; border-radius: 2px; }

    .section-title { color: #ffffff; font-size: 1.2rem; font-weight: 600; margin-bottom: 0; }
    .section-emoji { font-size: 1.3rem; line-height: 1; }
    .section-divider { border: none; border-top: 1px solid #2a2a2a; margin: 0 0 2.5rem; }

    /* Tabs – underline style */
    #calendarTab { border-bottom: none; gap: 0; }
    #calendarTab .nav-link {
        color: #666 !important;
        background: transparent !important;
        border: none !important;
        border-bottom: 2px solid transparent !important;
        border-radius: 0 !important;
        font-size: .88rem;
        font-weight: 500;
        padding: .4rem 1rem .38rem;
        transition: color .15s, border-color .15s;
    }
    #calendarTab .nav-link.active,
    #calendarTab .nav-link:hover {
        color: #fff !important;
        background: transparent !important;
        border-bottom-color: #00C853 !important;
    }

    /* "Xem tất cả" link */
    .btn-see-all {
        color: #aaaaaa;
        background: transparent;
        border: none;
        font-size: .82rem;
        padding: 0;
        text-decoration: none;
        transition: color .15s;
    }
    .btn-see-all:hover { color: #00C853; }

    /* ===== HERO 2-PANEL ===== */
    .h2-wrap { padding: 12px 16px 0; }
    .h2-slide { display: none; }
    .h2-slide.active { display: block; animation: h2FadeIn .35s ease; }
    @@keyframes h2FadeIn { from { opacity: 0; } to { opacity: 1; } }

    .h2-panels { display: flex; gap: 4px; height: 320px; }

    .h2-panel {
        flex: 1; border-radius: 6px; overflow: hidden;
        position: relative; background: #222; cursor: pointer;
    }

    .h2-img {
        width: 100%; height: 100%; object-fit: cover; display: block;
        transition: transform .4s ease;
    }
    .h2-panel:hover .h2-img { transform: scale(1.03); }

    .h2-overlay {
        position: absolute; inset: 0; pointer-events: none;
        background: linear-gradient(transparent 40%, rgba(0,0,0,.60) 100%);
    }

    .h2-detail-btn {
        position: absolute; bottom: 14px; left: 14px; z-index: 2;
        background: rgba(255,255,255,.15); color: #fff !important;
        font-weight: 500; border-radius: 4px; padding: 8px 18px;
        text-decoration: none; font-size: .84rem;
        border: 1px solid rgba(255,255,255,.5);
        transition: background .18s, color .18s; display: inline-block;
    }
    .h2-detail-btn:hover { background: #fff; color: #000 !important; }

    .h2-arrow {
        position: absolute; top: 50%; transform: translateY(-50%);
        background: rgba(0,0,0,.55); color: #fff; border: none;
        width: 36px; height: 36px; border-radius: 50%;
        font-size: 1.4rem; cursor: pointer; z-index: 3;
        display: flex; align-items: center; justify-content: center;
        transition: background .18s; backdrop-filter: blur(4px);
        line-height: 1; padding: 0;
    }
    .h2-arrow:hover { background: rgba(0,0,0,.82); }
    .h2-arrow-prev { left: 10px; }
    .h2-arrow-next { right: 10px; }

    .h2-dots {
        display: flex; justify-content: center; gap: 6px;
        padding: 8px 0 12px; background: #111111;
    }
    .h2-dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: rgba(255,255,255,.3); cursor: pointer;
        border: none; padding: 0;
        transition: background .18s, transform .18s;
    }
    .h2-dot.active { background: #fff; transform: scale(1.4); }

    /* ===== HOT EVENTS GRID ===== */
    .hot-grid-card { position: relative; cursor: pointer; }
    .hot-grid-img-wrap {
        position: relative; border-radius: 6px; overflow: hidden;
        aspect-ratio: 16 / 10; background: #222;
    }
    .hot-grid-img-wrap img {
        width: 100%; height: 100%; object-fit: cover; display: block;
        transition: transform .22s ease;
    }
    .hot-grid-card:hover .hot-grid-img-wrap img { transform: scale(1.02); }
    .hot-grid-card:hover .hot-grid-img-wrap {
        box-shadow: 0 8px 24px rgba(0,200,83,.15);
    }

    /* ===== TRENDING SECTION ===== */
    .trend-scroll-wrap { position: relative; }
    .trend-list {
        display: flex; gap: 0; overflow-x: auto; scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
    }
    .trend-list::-webkit-scrollbar { display: none; }

    .trend-card {
        position: relative; flex-shrink: 0;
        width: 260px; height: 185px;
        border-radius: 6px; overflow: hidden;
        margin-right: 10px; cursor: pointer;
        background: #222; text-decoration: none;
        transition: transform .2s;
        display: block;
    }
    .trend-card:last-child { margin-right: 0; }
    .trend-card:hover { transform: scale(1.02); }

    .trend-card-img {
        width: 100%; height: 100%; object-fit: cover; display: block;
    }
    .trend-card-img-ph {
        width: 100%; height: 100%;
        background: #222;
        display: flex; align-items: center; justify-content: center;
    }

    .trend-rank {
        position: absolute; bottom: -12px; left: 10px; z-index: 2;
        font-size: 110px; font-weight: 900;
        color: #00C853; opacity: .9; line-height: 1;
        pointer-events: none; user-select: none;
        text-shadow: 2px 3px 12px rgba(0,0,0,.75);
    }

    .trend-scroll-btn {
        position: absolute; right: -14px; top: 50%; transform: translateY(-50%);
        background: rgba(0,0,0,.65); color: #fff; border: none;
        width: 34px; height: 34px; border-radius: 50%;
        font-size: 1.2rem; cursor: pointer; z-index: 5;
        display: flex; align-items: center; justify-content: center;
        backdrop-filter: blur(4px); transition: background .18s;
    }
    .trend-scroll-btn:hover { background: #00C853; }

    /* ===== CITY DESTINATION STRIP ===== */
    .city-strip {
        display: flex; gap: 4px;
        height: 300px; border-radius: 10px; overflow: hidden;
    }
    .city-card-lg {
        flex: 1; position: relative; overflow: hidden;
        text-decoration: none; display: block; cursor: pointer;
    }
    .city-card-lg img {
        width: 100%; height: 100%; object-fit: cover; display: block;
        transition: transform .45s ease;
    }
    .city-card-lg:hover img { transform: scale(1.06); }
    .city-card-grid {
        flex: 1; display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 4px;
    }
    .city-mini {
        position: relative; overflow: hidden;
        text-decoration: none; display: block;
    }
    .city-mini img {
        width: 100%; height: 100%; object-fit: cover; display: block;
        transition: transform .45s ease;
    }
    .city-mini:hover img { transform: scale(1.1); }
    /* gradient xanh lá phủ từ dưới lên */
    .city-card-lg::after, .city-mini::after {
        content: ''; position: absolute; inset: 0; pointer-events: none;
        background: linear-gradient(to top,
            rgba(0,50,25,.80) 0%,
            rgba(0,120,60,.18) 50%,
            transparent 100%);
    }
    .city-label {
        position: absolute; bottom: 14px; left: 14px; right: 14px;
        z-index: 2; color: #fff; font-size: .98rem; font-weight: 700;
        text-shadow: 0 2px 10px rgba(0,0,0,.65);
        line-height: 1.3;
    }
    .city-mini-label {
        position: absolute; bottom: 7px; left: 8px; right: 8px;
        z-index: 2; color: #fff; font-size: .68rem; font-weight: 600;
        text-shadow: 0 1px 6px rgba(0,0,0,.8);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    @@media (max-width: 767px) {
        .city-strip { flex-direction: column; height: auto; border-radius: 8px; }
        .city-card-lg { height: 155px; }
        .city-card-grid { height: 155px; }
    }
</style>

@* ===== HERO 2-PANEL ===== *@
@if (hotList.Any())
{
    <div class="mx-n4 mt-0" style="background:#111111;">
        <div class="h2-wrap" id="h2Wrap">
            @for (int si = 0; si < slideCount; si++)
            {
                var i1 = si * 2;
                var i2 = si * 2 + 1;
                var ev1 = hotList[i1];
                var ev2 = i2 < hotList.Count ? hotList[i2] : null;

                <div class="h2-slide @(si == 0 ? "active" : "")">
                    <div class="h2-panels">
                        @* LEFT PANEL *@
                        <div class="h2-panel">
                            @if (!string.IsNullOrEmpty(ev1.ImageUrl))
                            {
                                <img class="h2-img" src="@ev1.ImageUrl" alt="@ev1.Title" loading="lazy" />
                            }
                            <div class="h2-overlay"></div>
                            @if (slideCount > 1)
                            {
                                <button class="h2-arrow h2-arrow-prev" onclick="h2Move(-1)" aria-label="Trước">&#8249;</button>
                            }
                            <a href="/Events/Details/@ev1.Id" class="h2-detail-btn" data-i18n="view-detail">Xem chi tiết</a>
                        </div>

                        @* RIGHT PANEL *@
                        @if (ev2 != null)
                        {
                            <div class="h2-panel">
                                @if (!string.IsNullOrEmpty(ev2.ImageUrl))
                                {
                                    <img class="h2-img" src="@ev2.ImageUrl" alt="@ev2.Title" loading="lazy" />
                                }
                                <div class="h2-overlay"></div>
                                @if (slideCount > 1)
                                {
                                    <button class="h2-arrow h2-arrow-next" onclick="h2Move(1)" aria-label="Sau">&#8250;</button>
                                }
                                <a href="/Events/Details/@ev2.Id" class="h2-detail-btn" data-i18n="view-detail">Xem chi tiết</a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @if (slideCount > 1)
        {
            <div class="h2-dots" id="h2Dots">
                @for (int di = 0; di < slideCount; di++)
                {
                    <button class="h2-dot @(di == 0 ? "active" : "")"
                            onclick="h2Goto(@di)" aria-label="Slide @(di + 1)"></button>
                }
            </div>
        }
    </div>
}

@* ===== TRENDING: SỰ KIỆN XU HƯỚNG ===== *@
@if (Model.TrendingEvents.Any())
{
    <div class="mx-n4 section-wave-bg" style="padding-left:16px; padding-right:16px;">
        <div class="d-flex align-items-center mb-3 pt-3">
            <h2 style="color:#fff; font-size:1.2rem; font-weight:600; margin:0;">⭐ Sự kiện xu hướng</h2>
        </div>
        <div class="trend-scroll-wrap">
            <div class="trend-list" id="trendList">
                @for (int ti = 0; ti < Model.TrendingEvents.Count; ti++)
                {
                    var tevt = Model.TrendingEvents[ti];
                    <a href="/Events/Details/@tevt.Id" class="trend-card">
                        @if (!string.IsNullOrEmpty(tevt.ImageUrl))
                        {
                            <img class="trend-card-img" src="@tevt.ImageUrl" alt="@tevt.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="trend-card-img-ph">
                                <span style="font-size:2rem; opacity:.2;">🎟</span>
                            </div>
                        }
                        <div class="h2-overlay"></div>
                        <span class="trend-rank">@(ti + 1)</span>
                    </a>
                }
            </div>
            <button class="trend-scroll-btn"
                    onclick="document.getElementById('trendList').scrollBy({left:300,behavior:'smooth'})"
                    aria-label="Cuộn phải">&#8250;</button>
        </div>
    </div>
}

<div class="container pb-5 pt-4">

    @* ===== 1. SỰ KIỆN NỔI BẬT ===== *@
    @if (Model.HotEvents.Any())
    {
        <div class="mb-5">
            <div class="d-flex align-items-center gap-2 mb-4">
                <h2 class="section-title" data-i18n="hot-events">Sự Kiện Nổi Bật</h2>
                <a href="/Events" class="btn-see-all ms-auto" data-i18n="see-all">Xem tất cả →</a>
            </div>

            <div class="row row-cols-2 row-cols-md-4 g-3">
                @foreach (var evt in Model.HotEvents)
                {
                    var cheapest = evt.TicketTypes.Where(t => t.AvailableQuantity > 0).OrderBy(t => t.Price).FirstOrDefault();
                    var dateStr = evt.StartDate.ToLocalTime().ToString("dd 'tháng' MM, yyyy");
                    <div class="col">
                        <a href="/Events/Details/@evt.Id" class="event-card">
                            <div class="event-card-thumb">
                                @if (!string.IsNullOrEmpty(evt.ImageUrl))
                                {
                                    <img src="@evt.ImageUrl" alt="@evt.Title" loading="lazy" />
                                }
                                else
                                {
                                    <div class="ph-icon">🎟</div>
                                }
                            </div>
                            <div class="event-card-body">
                                <div class="event-card-name">@evt.Title</div>
                                @if (cheapest != null)
                                {
                                    <div class="event-card-price">Từ @cheapest.Price.ToString("N0")đ</div>
                                }
                                else
                                {
                                    <div class="event-card-price" style="color:#555;">Hết vé</div>
                                }
                                <div class="event-card-date">
                                    <svg viewBox="0 0 16 16" fill="currentColor"><path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/></svg>
                                    @dateStr
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
        <hr class="section-divider" />
    }

    @* ===== 2. SỰ KIỆN ĐẶC BIỆT ===== *@
    @if (Model.SpecialEvents.Any())
    {
        <div class="mb-5 section-wave-bg" style="border-radius:8px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="section-emoji">⭐</span>
                    <h2 class="section-title" data-i18n="special-events">Sự Kiện Đặc Biệt</h2>
                </div>
                <a href="/Events" class="btn-see-all" data-i18n="see-all">Xem tất cả →</a>
            </div>
            <div class="horiz-scroll">
                <div class="d-flex gap-3" style="flex-wrap:nowrap;">
                    @foreach (var evt in Model.SpecialEvents)
                    {
                        @await Html.PartialAsync("_HorizEventCard", evt)
                    }
                </div>
            </div>
        </div>
        <hr class="section-divider" />
    }

    @* ===== 3. CUỐI TUẦN & THÁNG NÀY ===== *@
    @if (Model.WeekendEvents.Any() || Model.ThisMonthEvents.Any())
    {
        <div class="mb-5">
            <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                <div class="d-flex align-items-center gap-2">
                    <span class="section-emoji">📅</span>
                    <h2 class="section-title" data-i18n="time-events">Sự Kiện Theo Thời Gian</h2>
                </div>
                <ul class="nav gap-1 mb-0" id="calendarTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="weekend-tab"
                                data-bs-toggle="tab" data-bs-target="#weekendPane"
                                type="button" role="tab" data-i18n="weekend-tab">
                            Cuối Tuần Này
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="month-tab"
                                data-bs-toggle="tab" data-bs-target="#monthPane"
                                type="button" role="tab" data-i18n="month-tab">
                            Tháng Này
                        </button>
                    </li>
                </ul>
            </div>
            <div class="tab-content" id="calendarTabContent">
                <div class="tab-pane fade show active" id="weekendPane" role="tabpanel">
                    @if (Model.WeekendEvents.Any())
                    {
                        <div class="horiz-scroll">
                            <div class="d-flex gap-3" style="flex-wrap:nowrap;">
                                @foreach (var evt in Model.WeekendEvents)
                                {
                                    @await Html.PartialAsync("_HorizEventCard", evt)
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="py-3 ps-1" style="color:#555;">Không có sự kiện cuối tuần này.</p>
                    }
                </div>
                <div class="tab-pane fade" id="monthPane" role="tabpanel">
                    @if (Model.ThisMonthEvents.Any())
                    {
                        <div class="horiz-scroll">
                            <div class="d-flex gap-3" style="flex-wrap:nowrap;">
                                @foreach (var evt in Model.ThisMonthEvents)
                                {
                                    @await Html.PartialAsync("_HorizEventCard", evt)
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="py-3 ps-1" style="color:#555;">Không có sự kiện trong tháng này.</p>
                    }
                </div>
            </div>
        </div>
        <hr class="section-divider" />
    }

    @* ===== 4. NHẠC SỐNG ===== *@
    @if (Model.MusicEvents.Any())
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="section-emoji">🎵</span>
                    <h2 class="section-title" data-i18n="music-section">Nhạc Sống</h2>
                </div>
                <a asp-page="/Events/Index" asp-route-category="Âm nhạc" class="btn-see-all" data-i18n="see-all">Xem tất cả →</a>
            </div>
            <div class="horiz-scroll">
                <div class="d-flex gap-3" style="flex-wrap:nowrap;">
                    @foreach (var evt in Model.MusicEvents)
                    {
                        @await Html.PartialAsync("_HorizEventCard", evt)
                    }
                </div>
            </div>
        </div>
        <hr class="section-divider" />
    }

    @* ===== 5. SÂN KHẤU NGHỆ THUẬT ===== *@
    @if (Model.ArtEvents.Any())
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="section-emoji">🎭</span>
                    <h2 class="section-title" data-i18n="art-section">Sân Khấu Nghệ Thuật</h2>
                </div>
                <a asp-page="/Events/Index" asp-route-category="Nghệ thuật" class="btn-see-all" data-i18n="see-all">Xem tất cả →</a>
            </div>
            <div class="horiz-scroll">
                <div class="d-flex gap-3" style="flex-wrap:nowrap;">
                    @foreach (var evt in Model.ArtEvents)
                    {
                        @await Html.PartialAsync("_HorizEventCard", evt)
                    }
                </div>
            </div>
        </div>
        <hr class="section-divider" />
    }

    @* ===== 6. HỘI THẢO & WORKSHOP ===== *@
    @if (Model.WorkshopEvents.Any())
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="section-emoji">💡</span>
                    <h2 class="section-title" data-i18n="workshop-section">Hội Thảo &amp; Workshop</h2>
                </div>
                <a asp-page="/Events/Index" asp-route-category="Hội thảo" class="btn-see-all" data-i18n="see-all">Xem tất cả →</a>
            </div>
            <div class="horiz-scroll">
                <div class="d-flex gap-3" style="flex-wrap:nowrap;">
                    @foreach (var evt in Model.WorkshopEvents)
                    {
                        @await Html.PartialAsync("_HorizEventCard", evt)
                    }
                </div>
            </div>
        </div>
        <hr class="section-divider" />
    }

    @* ===== 7. THAM QUAN & TRẢI NGHIỆM ===== *@
    @if (Model.TourEvents.Any())
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="section-emoji">🌿</span>
                    <h2 class="section-title" data-i18n="tour-section">Tham Quan &amp; Trải Nghiệm</h2>
                </div>
                <a asp-page="/Events/Index" asp-route-category="Tham quan" class="btn-see-all" data-i18n="see-all">Xem tất cả →</a>
            </div>
            <div class="horiz-scroll">
                <div class="d-flex gap-3" style="flex-wrap:nowrap;">
                    @foreach (var evt in Model.TourEvents)
                    {
                        @await Html.PartialAsync("_HorizEventCard", evt)
                    }
                </div>
            </div>
        </div>
        <hr class="section-divider" />
    }

    @* ===== 8. THỂ THAO ===== *@
    @if (Model.SportsEvents.Any())
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="section-emoji">🏆</span>
                    <h2 class="section-title" data-i18n="sports-section">Thể Thao &amp; Các Loại Khác</h2>
                </div>
                <a asp-page="/Events/Index" asp-route-category="Thể thao" class="btn-see-all" data-i18n="see-all">Xem tất cả →</a>
            </div>
            <div class="horiz-scroll">
                <div class="d-flex gap-3" style="flex-wrap:nowrap;">
                    @foreach (var evt in Model.SportsEvents)
                    {
                        @await Html.PartialAsync("_HorizEventCard", evt)
                    }
                </div>
            </div>
        </div>
        <hr class="section-divider" />
    }

    @* ===== 9. ĐIỂM ĐẾN THÚ VỊ ===== *@
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-2">
                <span class="section-emoji">📍</span>
                <h2 class="section-title" data-i18n="venues-section">Điểm Đến Thú Vị</h2>
            </div>
            <a href="/Events" class="btn-see-all" data-i18n="see-all">Xem tất cả →</a>
        </div>
        <div class="city-strip">
            @* 3 thẻ thành phố lớn *@
            @foreach (var city in IndexModel.MainCities)
            {
                <a asp-page="/Events/Index" asp-route-search="@city.SearchTerm" class="city-card-lg">
                    <img src="@city.ImageUrl" alt="@city.Name" loading="lazy" />
                    <span class="city-label">@city.Name</span>
                </a>
            }
            @* Thẻ thứ 4: lưới 2×2 *@
            <div class="city-card-grid">
                @foreach (var city in IndexModel.MiniCities)
                {
                    <a asp-page="/Events/Index" asp-route-search="@city.SearchTerm" class="city-mini">
                        <img src="@city.ImageUrl" alt="@city.Name" loading="lazy" />
                        <span class="city-mini-label">@city.Name</span>
                    </a>
                }
            </div>
        </div>
    </div>

    @if (!Model.HotEvents.Any() && !Model.SpecialEvents.Any() && !Model.MusicEvents.Any())
    {
        <div class="text-center py-5">
            <p style="color:#555;">Hiện chưa có sự kiện nào. Hãy quay lại sau!</p>
        </div>
    }

    <div class="text-center mt-4">
        <a href="/Events" class="btn-see-all px-5 py-2" style="font-size:.9rem;" data-i18n="see-all-events">Xem Tất Cả Sự Kiện →</a>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var slides = document.querySelectorAll('.h2-slide');
    var dots   = document.querySelectorAll('.h2-dot');
    if (!slides.length) return;

    var current = 0;
    var timer;

    function show(idx) {
        slides[current].classList.remove('active');
        if (dots.length) dots[current].classList.remove('active');
        current = (idx + slides.length) % slides.length;
        slides[current].classList.add('active');
        if (dots.length) dots[current].classList.add('active');
    }

    function start() { timer = setInterval(function () { show(current + 1); }, 4500); }
    function stop()  { clearInterval(timer); }

    window.h2Move = function (d) { stop(); show(current + d); start(); };
    window.h2Goto = function (i) { stop(); show(i); start(); };

    var wrap = document.getElementById('h2Wrap');
    if (wrap) {
        wrap.addEventListener('mouseenter', stop);
        wrap.addEventListener('mouseleave', start);
    }

    start();
})();
</script>
}
