@page "{id:int}"
@model EventTicketSystem.Web.Pages.Events.SelectSeatsModel
@using EventTicketSystem.Web.Models
@{
    ViewData["Title"] = $"Chọn Ghế – {Model.Event?.Title}";
    var evt    = Model.Event!;
    var imgUrl = evt.ImageUrl ?? "";
}

<style>
/* ── Wrapper ── */
.ss-wrap { padding: 1.5rem 0 8rem; }
.ss-back { color:rgba(210,195,255,.5); font-size:.85rem; text-decoration:none; margin-bottom:.75rem; display:inline-flex; align-items:center; gap:6px; }
.ss-back:hover { color:#ede0ff; }
.ss-title { font-size:1.25rem; font-weight:800; color:#ede0ff; margin-bottom:.15rem; }
.ss-sub   { color:rgba(210,195,255,.45); font-size:.83rem; margin-bottom:1.25rem; }

.ss-card {
    background:rgba(20,10,52,.82); border:1px solid rgba(124,77,255,.28);
    border-radius:16px; padding:1.25rem 1.5rem; margin-bottom:1rem; overflow-x:auto;
}

/* ── Legend ── */
.legend-row { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:1.25rem; }
.legend-item { display:flex; align-items:center; gap:7px; font-size:.76rem; color:rgba(210,195,255,.65); }
.l-dot { width:20px; height:20px; border-radius:4px; flex-shrink:0; }

/* ── Screen arc ── */
.screen-wrap { text-align:center; margin-bottom:1.75rem; }
.screen-arc {
    display:inline-block; width:60%; max-width:480px; height:14px;
    background:linear-gradient(90deg, transparent 0%, rgba(68,138,255,.4) 25%, rgba(68,138,255,.8) 50%, rgba(68,138,255,.4) 75%, transparent 100%);
    border-radius:50% 50% 0 0 / 100% 100% 0 0;
}
.screen-label { display:block; font-size:.7rem; font-weight:700; letter-spacing:.18em; color:rgba(210,195,255,.3); text-transform:uppercase; margin-top:8px; }

/* ── Grid ── */
.grid-rows { display:inline-flex; flex-direction:column; gap:4px; min-width:max-content; }
.grid-row  { display:flex; align-items:center; gap:4px; }
.row-lbl   { width:22px; font-size:.68rem; font-weight:700; color:rgba(210,195,255,.4); text-align:center; flex-shrink:0; }

/* ── Seat cell ── */
.ss-seat {
    width:38px; height:38px; border-radius:7px; position:relative; overflow:hidden;
    flex-shrink:0; display:flex; align-items:center; justify-content:center;
    border:2px solid transparent; user-select:none; transition:transform .1s, border-color .15s;
}
.ss-seat.couple { width:80px; }

.ss-seat.available { border-color:rgba(124,77,255,.4); background:rgba(124,77,255,.12); cursor:pointer; }
.ss-seat.available:hover { border-color:rgba(124,77,255,.75); transform:scale(1.1); }
.ss-seat.vip-avail { border-color:rgba(233,30,99,.4); background:rgba(233,30,99,.1); cursor:pointer; }
.ss-seat.vip-avail:hover { border-color:rgba(233,30,99,.7); transform:scale(1.1); }
.ss-seat.selected {
    border-color:#448aff; background:rgba(68,138,255,.3);
    transform:scale(1.08);
    box-shadow:0 0 12px rgba(68,138,255,.5);
    cursor:pointer;
}
.ss-seat.sold     { cursor:default; }
.ss-seat.disabled { cursor:default; }
.ss-seat.empty    { background:transparent; border-color:rgba(255,255,255,.08); border-style:dashed; cursor:default; }

.seat-img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.35; pointer-events:none; }
.seat-sold-overlay {
    position:absolute; inset:0; background:rgba(0,0,0,.62); z-index:2;
    display:flex; align-items:center; justify-content:center; font-size:.9rem;
}
.seat-check {
    position:absolute; top:2px; right:3px; z-index:3;
    font-size:.7rem; color:#69f0ae; font-weight:900; display:none;
}
.ss-seat.selected .seat-check { display:block; }
.seat-lbl {
    position:relative; z-index:1; font-size:.52rem; font-weight:800;
    color:#fff; text-shadow:0 1px 4px rgba(0,0,0,.9); text-align:center; line-height:1.2;
    pointer-events:none;
}
.seat-type-dot {
    position:absolute; bottom:2px; left:50%; transform:translateX(-50%); z-index:3;
    width:6px; height:6px; border-radius:50%;
}
.dot-vip { background:#f06292; }

/* ── Sticky bottom panel ── */
.ss-sticky {
    position:fixed; bottom:0; left:0; right:0; z-index:200;
    background:rgba(10,6,28,.96); backdrop-filter:blur(20px);
    border-top:1px solid rgba(124,77,255,.35);
    padding:12px 20px;
    display:flex; align-items:center; gap:14px; flex-wrap:wrap;
}
.ss-sticky-left { flex:1; min-width:0; }
.ss-sticky-chips { display:flex; gap:6px; flex-wrap:wrap; min-height:28px; align-items:center; }
.ss-chip {
    display:inline-flex; align-items:center; gap:5px;
    background:rgba(68,138,255,.15); border:1px solid rgba(68,138,255,.3);
    border-radius:20px; padding:3px 10px; font-size:.76rem; color:#90caf9;
}
.ss-chip-del { cursor:pointer; color:rgba(239,154,154,.7); font-size:.8rem; }
.ss-chip-del:hover { color:#ef9a9a; }
.ss-empty-note { font-size:.8rem; color:rgba(210,195,255,.3); }
.ss-total-row { font-size:.78rem; color:rgba(210,195,255,.5); margin-top:4px; }
.ss-total-amt { font-size:1rem; font-weight:800; color:#ffd740; }

.btn-continue {
    background:linear-gradient(90deg,#7c4dff,#448aff); border:none;
    border-radius:12px; color:#fff; font-weight:700; font-size:.93rem;
    padding:.7rem 1.5rem; cursor:pointer; white-space:nowrap; flex-shrink:0;
    box-shadow:0 4px 16px rgba(124,77,255,.4); transition:opacity .15s;
}
.btn-continue:hover:not(:disabled) { opacity:.87; }
.btn-continue:disabled { opacity:.35; cursor:default; }

/* ── Error banner ── */
.ss-err { background:rgba(229,57,53,.1); border:1px solid rgba(229,57,53,.25); border-radius:10px; padding:10px 16px; color:#ef9a9a; font-size:.88rem; margin-bottom:1rem; }
</style>

<div class="container-xl px-3 px-md-4 ss-wrap">

    <a href="/Events/Details/@evt.Id" class="ss-back">← @evt.Title</a>
    <div class="ss-title">🪑 Chọn Ghế</div>
    <div class="ss-sub">Nhấp vào ghế để chọn · Tối đa 8 chỗ ngồi · Ghế giữ 10 phút sau khi đặt</div>

    @if (TempData["SeatError"] is string seatErr)
    {
        <div class="ss-err">⚠️ @seatErr</div>
    }

    @* ── Legend ── *@
    <div class="legend-row">
        <div class="legend-item"><div class="l-dot" style="background:rgba(124,77,255,.2);border:2px solid rgba(124,77,255,.5);"></div>Ghế thường</div>
        <div class="legend-item"><div class="l-dot" style="background:rgba(233,30,99,.12);border:2px solid rgba(233,30,99,.45);"></div>Ghế VIP</div>
        <div class="legend-item"><div class="l-dot" style="background:rgba(68,138,255,.3);border:2px solid #448aff;"></div>Đang chọn</div>
        <div class="legend-item"><div class="l-dot" style="background:rgba(0,0,0,.5);border:2px solid rgba(255,255,255,.12);"></div>Đã đặt</div>
    </div>

    @* ── Seat Grid Card ── *@
    <div class="ss-card">
        <div class="screen-wrap">
            <div class="screen-arc"></div>
            <span class="screen-label">Màn Hình / Sân Khấu</span>
        </div>

        <div style="overflow-x:auto;">
            <div class="grid-rows" id="seatGrid">
                @for (int r = 0; r < Model.GridRows; r++)
                {
                    <div class="grid-row">
                        <div class="row-lbl">@((char)('A' + r))</div>
                        @for (int c = 0; c < Model.GridCols; c++)
                        {
                            @* Skip partner column *@
                            bool isPartner = c > 0
                                && Model.SeatGrid.TryGetValue((r, c - 1), out var leftSeat)
                                && leftSeat.SeatType == SeatType.Couple;
                            if (isPartner) continue;

                            Model.SeatGrid.TryGetValue((r, c), out var seat);
                            if (seat == null)
                            {
                                @* Empty aisle slot *@
                                <div class="ss-seat empty"></div>
                            }
                            else
                            {
                                bool isCouple = seat.SeatType == SeatType.Couple;
                                bool isVip    = seat.SeatType == SeatType.VIP;
                                bool isSold   = seat.Status == SeatStatus.Sold || seat.Status == SeatStatus.Reserved;
                                bool isDisabled = seat.Status == SeatStatus.Disabled;
                                string availCss = isVip ? "vip-avail" : "available";

                                if (isSold || isDisabled)
                                {
                                    <div class="ss-seat sold @(isCouple ? "couple" : "")"
                                         title="@seat.Label – @(isSold ? "Đã đặt" : "Không khả dụng")"
                                         style="background:rgba(30,20,60,.7);border-color:rgba(255,255,255,.1);">
                                        @if (!string.IsNullOrEmpty(imgUrl))
                                        { <img src="@imgUrl" alt="" class="seat-img" style="opacity:.12;filter:grayscale(100%);" /> }
                                        <div class="seat-sold-overlay">@(isSold ? "🔒" : "—")</div>
                                    </div>
                                }
                                else
                                {
                                    string priceStr = (seat.TicketType?.Price ?? 0).ToString("0", System.Globalization.CultureInfo.InvariantCulture);
                                    <div class="ss-seat @availCss @(isCouple ? "couple" : "")"
                                         id="cs-@seat.Id"
                                         data-id="@seat.Id"
                                         data-label="@seat.Label"
                                         data-price="@priceStr"
                                         data-couple="@(isCouple ? "true" : "false")"
                                         title="@seat.Label · @(seat.TicketType?.Name ?? "") · @(seat.TicketType?.Price.ToString("N0") ?? "0")đ"
                                         onclick="toggleSeat(this)">
                                        @if (!string.IsNullOrEmpty(imgUrl))
                                        { <img src="@imgUrl" alt="" class="seat-img" /> }
                                        <span class="seat-lbl">@seat.Label</span>
                                        <span class="seat-check">✓</span>
                                        @if (isVip)
                                        { <span class="seat-type-dot dot-vip"></span> }
                                    </div>
                                }
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@* ── Sticky bottom panel ── *@
<div class="ss-sticky">
    <div class="ss-sticky-left">
        <div class="ss-sticky-chips" id="seatChips">
            <span class="ss-empty-note" id="emptyNote">Chưa chọn ghế nào</span>
        </div>
        <div class="ss-total-row" id="totalRow" style="display:none;">
            <span id="seatCountTxt"></span> · <span class="ss-total-amt" id="totalAmt"></span>
        </div>
    </div>

    <form method="post" asp-page-handler="AddToCart" id="addCartForm">
        <input type="hidden" name="eventId" value="@evt.Id" />
        <input type="hidden" name="selectedSeatIds" id="selectedSeatIds" />
        <button type="submit" class="btn-continue" id="btnContinue" disabled>
            Tiếp tục →
        </button>
    </form>
</div>

<script>
const MAX_PHYSICAL = 8;
// Map: seatId → { label, price, isCouple }
const selected = new Map();

function physicalCount() {
    let n = 0;
    for (const v of selected.values()) n += v.isCouple ? 2 : 1;
    return n;
}

function toggleSeat(el) {
    const id      = parseInt(el.dataset.id);
    const label   = el.dataset.label;
    const price   = parseFloat(el.dataset.price) || 0;
    const isCouple = el.dataset.couple === 'true';
    const seats   = isCouple ? 2 : 1;

    if (selected.has(id)) {
        selected.delete(id);
        el.classList.remove('selected');
        const origCss = el.getAttribute('data-origcss') || 'available';
        el.classList.add(origCss);
    } else {
        if (physicalCount() + seats > MAX_PHYSICAL) {
            alert(`Bạn chỉ có thể chọn tối đa ${MAX_PHYSICAL} chỗ ngồi.`);
            return;
        }
        // Save original class before overwrite
        if (!el.getAttribute('data-origcss')) {
            const origCss = el.classList.contains('vip-avail') ? 'vip-avail' : 'available';
            el.setAttribute('data-origcss', origCss);
        }
        selected.set(id, { label, price, isCouple });
        el.classList.remove('available', 'vip-avail');
        el.classList.add('selected');
    }
    updatePanel();
}

function removeSeat(id) {
    selected.delete(id);
    const el = document.getElementById('cs-' + id);
    if (el) {
        el.classList.remove('selected');
        const orig = el.getAttribute('data-origcss') || 'available';
        el.classList.add(orig);
    }
    updatePanel();
}

function updatePanel() {
    const chips   = document.getElementById('seatChips');
    const empty   = document.getElementById('emptyNote');
    const totalRow = document.getElementById('totalRow');
    const countTxt = document.getElementById('seatCountTxt');
    const amtEl   = document.getElementById('totalAmt');
    const btn     = document.getElementById('btnContinue');
    const hidden  = document.getElementById('selectedSeatIds');

    // Remove old chips
    chips.querySelectorAll('.ss-chip').forEach(c => c.remove());

    const ids = [...selected.keys()];
    hidden.value = ids.join(',');

    let total = 0;
    ids.forEach(id => {
        const { label, price, isCouple } = selected.get(id);
        total += price * (isCouple ? 2 : 1);

        const chip = document.createElement('span');
        chip.className = 'ss-chip';
        chip.innerHTML = `${label} <span class="ss-chip-del" onclick="removeSeat(${id})">✕</span>`;
        chips.appendChild(chip);
    });

    const pCount = physicalCount();
    if (pCount > 0) {
        empty.style.display  = 'none';
        totalRow.style.display = '';
        countTxt.textContent = `${pCount} chỗ ngồi`;
        amtEl.textContent    = total.toLocaleString('vi') + 'đ';
    } else {
        empty.style.display  = '';
        totalRow.style.display = 'none';
    }

    btn.disabled = pCount === 0;
}
</script>
