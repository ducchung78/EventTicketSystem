@page "{eventId:int}"
@model EventTicketSystem.Web.Pages.Events.SeatMap.SeatMapIndexModel
@using EventTicketSystem.Web.Models
@{
    ViewData["Title"] = $"Sơ Đồ Ghế – {Model.Event?.Title}";
    var evt      = Model.Event!;
    var hasSeats = Model.Seats.Count > 0;
    var imgUrl   = evt.ImageUrl ?? "";
}

<style>
/* ── Layout ── */
.sm-wrap  { padding: 2rem 0 4rem; }
.sm-back  { color:rgba(210,195,255,.5); font-size:.85rem; text-decoration:none; margin-bottom:1rem; display:inline-flex; align-items:center; gap:6px; }
.sm-back:hover { color:#ede0ff; }
.sm-header { font-size:1.4rem; font-weight:800; color:#ede0ff; margin-bottom:.2rem; }
.sm-sub   { color:rgba(210,195,255,.4); font-size:.85rem; margin-bottom:1.5rem; }

.sm-card {
    background:rgba(20,10,52,.82);
    border:1px solid rgba(124,77,255,.28);
    border-radius:16px; padding:1.5rem 1.75rem; margin-bottom:1.25rem;
}
.sm-card-title { font-size:1rem; font-weight:700; color:#ede0ff; margin-bottom:1.25rem; padding-bottom:.75rem; border-bottom:1px solid rgba(124,77,255,.18); }

/* ── Alert ── */
.sm-ok  { background:rgba(0,200,83,.1); border:1px solid rgba(0,200,83,.25); border-radius:10px; padding:10px 16px; color:#69f0ae; font-size:.88rem; margin-bottom:1rem; }
.sm-err { background:rgba(229,57,53,.1); border:1px solid rgba(229,57,53,.25); border-radius:10px; padding:10px 16px; color:#ef9a9a; font-size:.88rem; margin-bottom:1rem; }

/* ── Config row ── */
.cfg-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(180px,1fr)); gap:12px; margin-bottom:1.25rem; }
.cfg-item label { display:block; font-size:.72rem; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:rgba(124,77,255,.8); margin-bottom:5px; }
.cfg-item input, .cfg-item select {
    width:100%; background:rgba(255,255,255,.05); border:1.5px solid rgba(124,77,255,.25);
    border-radius:8px; color:#ede0ff; font-size:.88rem; padding:7px 10px; outline:none;
}
.cfg-item input:focus, .cfg-item select:focus { border-color:rgba(124,77,255,.55); }
.cfg-item select option { background:#1a0a40; }

.btn-generate {
    background:linear-gradient(90deg,#7c4dff,#448aff); border:none; border-radius:10px;
    color:#fff; font-weight:700; font-size:.9rem; padding:9px 24px; cursor:pointer;
    box-shadow:0 3px 14px rgba(124,77,255,.35); transition:opacity .15s;
}
.btn-generate:hover { opacity:.88; }
.btn-save {
    background:linear-gradient(90deg,#00c853,#00bfa5); border:none; border-radius:10px;
    color:#fff; font-weight:700; font-size:.9rem; padding:9px 24px; cursor:pointer;
    box-shadow:0 3px 14px rgba(0,200,83,.3); transition:opacity .15s;
}
.btn-save:hover { opacity:.88; }
.btn-reset-sm {
    background:rgba(229,57,53,.1); border:1px solid rgba(229,57,53,.3); border-radius:8px;
    color:#ef9a9a; font-size:.82rem; font-weight:600; padding:7px 18px; cursor:pointer;
}
.btn-reset-sm:hover { background:rgba(229,57,53,.2); }

/* ── Legend ── */
.legend-row { display:flex; gap:14px; flex-wrap:wrap; margin-bottom:1.25rem; align-items:center; }
.legend-item { display:flex; align-items:center; gap:7px; font-size:.78rem; color:rgba(210,195,255,.65); }
.l-dot { width:22px; height:22px; border-radius:5px; flex-shrink:0; }
.l-normal { background:rgba(149,117,205,.3); border:2px solid rgba(149,117,205,.65); }
.l-vip    { background:rgba(233,30,99,.2);   border:2px solid rgba(233,30,99,.55); }
.l-couple { background:rgba(149,117,205,.3); border:2px solid rgba(149,117,205,.65); width:46px; border-radius:5px; }
.l-empty  { background:transparent; border:2px dashed rgba(255,255,255,.2); }

/* ── Screen bar (curved arc) ── */
.screen-wrap { text-align:center; margin-bottom:1.75rem; }
.screen-arc {
    display:inline-block; width:60%; max-width:480px; height:14px;
    background:linear-gradient(90deg, transparent 0%, rgba(68,138,255,.4) 25%, rgba(68,138,255,.8) 50%, rgba(68,138,255,.4) 75%, transparent 100%);
    border-radius:50% 50% 0 0 / 100% 100% 0 0;
}
.screen-label { display:block; font-size:.7rem; font-weight:700; letter-spacing:.18em; color:rgba(210,195,255,.3); text-transform:uppercase; margin-top:8px; }

/* ── Seat grid ── */
.grid-scroll { overflow-x:auto; padding-bottom:8px; }
.grid-rows   { display:inline-flex; flex-direction:column; gap:4px; min-width:max-content; }
.grid-row    { display:flex; align-items:center; gap:4px; }
.row-lbl     { width:22px; font-size:.68rem; font-weight:700; color:rgba(210,195,255,.4); text-align:center; flex-shrink:0; }

/* ── Seat cell ── */
.sc {
    width:36px; height:36px; border-radius:6px; position:relative; overflow:hidden;
    flex-shrink:0; display:flex; align-items:center; justify-content:center;
    border:2px solid transparent; cursor:pointer; user-select:none;
    transition:transform .1s, opacity .1s;
}
.sc:hover:not(.sc-empty) { transform:scale(1.12); }
.sc.couple   { width:76px; }
.sc-normal   { background:rgba(149,117,205,.25); border-color:rgba(149,117,205,.6); }
.sc-vip      { background:rgba(233,30,99,.18); border-color:rgba(233,30,99,.55); }
.sc-couple   { background:rgba(149,117,205,.25); border-color:rgba(149,117,205,.6); }
.sc-empty    { background:transparent; border-color:rgba(255,255,255,.1); border-style:dashed; cursor:default; }
.sc-avail    { background:rgba(0,200,83,.2); border-color:rgba(0,200,83,.4); }
.sc-sold     { background:rgba(255,255,255,.08); border-color:rgba(255,255,255,.06); cursor:default; }
.sc-disabled { background:rgba(229,57,53,.18); border-color:rgba(229,57,53,.35); }
.sc-reserved { background:rgba(255,167,38,.18); border-color:rgba(255,167,38,.35); cursor:default; }

.sc-img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.32; pointer-events:none; }
.sc-lbl {
    position:relative; z-index:1; font-size:.52rem; font-weight:800;
    color:#fff; text-shadow:0 1px 4px rgba(0,0,0,.9); text-align:center; line-height:1.1;
    pointer-events:none;
}
.sc-badge {
    position:absolute; top:2px; right:3px; z-index:2;
    font-size:.6rem; line-height:1; pointer-events:none;
}

/* ── Stats bar ── */
.stats-row { display:flex; gap:16px; flex-wrap:wrap; margin-bottom:1rem; font-size:.78rem; color:rgba(210,195,255,.5); }
.stats-item strong { color:rgba(210,195,255,.9); }

/* ── Zone info bar (State B viewer) ── */
.zone-info { font-size:.8rem; color:rgba(210,195,255,.45); margin-bottom:.75rem; }

.info-band {
    background:rgba(255,167,38,.08); border:1px solid rgba(255,167,38,.25);
    border-radius:8px; padding:10px 14px; font-size:.82rem; color:#ffa726; margin-bottom:1rem;
}
</style>

<form id="__afForm" method="post" style="display:none;"></form>

<div class="container-xl px-3 px-md-4 sm-wrap">

    <a href="/Events/Details/@evt.Id" class="sm-back">← Quay lại sự kiện</a>
    <div class="sm-header">🗺️ Sơ Đồ Ghế</div>
    <div class="sm-sub">@evt.Title</div>

    @if (TempData["Success"] is string ok)  { <div class="sm-ok">✅ @ok</div> }
    @if (TempData["Error"]   is string err) { <div class="sm-err">⚠️ @err</div> }

    @* ══════════════════ STATE A: EDITOR ══════════════════ *@
    @if (!hasSeats)
    {
        <div class="sm-card">
            <div class="sm-card-title">⚙️ Cấu Hình Sơ Đồ</div>

            <div class="cfg-grid">
                <div class="cfg-item">
                    <label>Ghế thường → loại vé</label>
                    <select id="normalTt">
                        <option value="0">-- Không gán --</option>
                        @foreach (var tt in evt.TicketTypes.OrderBy(t => t.Price))
                        {
                            <option value="@tt.Id">@tt.Name (@tt.Price.ToString("N0")đ)</option>
                        }
                    </select>
                </div>
                <div class="cfg-item">
                    <label>Ghế VIP → loại vé</label>
                    <select id="vipTt">
                        <option value="0">-- Không gán --</option>
                        @foreach (var tt in evt.TicketTypes.OrderByDescending(t => t.Price))
                        {
                            <option value="@tt.Id">@tt.Name (@tt.Price.ToString("N0")đ)</option>
                        }
                    </select>
                </div>
                <div class="cfg-item">
                    <label>Số hàng (1–26)</label>
                    <input type="number" id="numRows" value="5" min="1" max="26"
                           oninput="onDimChange()" />
                </div>
                <div class="cfg-item">
                    <label>Số cột (1–50)</label>
                    <input type="number" id="numCols" value="10" min="1" max="50"
                           oninput="onDimChange()" />
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn-generate" onclick="generateGrid()">🪑 Tạo Sơ Đồ</button>
            </div>
        </div>

        @* Legend *@
        <div class="legend-row">
            <span style="font-size:.78rem;color:rgba(210,195,255,.5);font-weight:600;">Click để đổi loại:</span>
            <div class="legend-item"><div class="l-dot l-normal"></div>Ghế thường</div>
            <div class="legend-item"><div class="l-dot l-vip"></div>Ghế VIP</div>
            <div class="legend-item"><div class="l-dot l-couple"></div>Ghế đôi (2 chỗ)</div>
            <div class="legend-item"><div class="l-dot l-empty"></div>Lối đi / trống</div>
        </div>

        @* Grid container (hidden until generated) *@
        <div id="editorCard" class="sm-card" style="display:none;">
            <div class="screen-wrap">
                <div class="screen-arc"></div>
                <span class="screen-label">Màn Hình / Sân Khấu</span>
            </div>
            <div class="grid-scroll">
                <div class="grid-rows" id="seatGrid"></div>
            </div>

            <div class="d-flex gap-2 flex-wrap mt-3">
                <button type="button" class="btn-save" onclick="saveGrid()">💾 Lưu Sơ Đồ</button>
            </div>
        </div>

        @* Hidden form for save *@
        <form id="saveGridForm" method="post" asp-page-handler="SaveGrid">
            <input type="hidden" name="eventId" value="@evt.Id" />
            <input type="hidden" name="gridJson" id="gridJsonInput" />
        </form>

        <script>
        const eventId   = @evt.Id;
        const imgUrl    = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(imgUrl));

        let numRows = 5, numCols = 10;
        // grid[r][c]: 'normal' | 'vip' | 'couple' | 'empty' | 'partner'
        let grid = [];

        function onDimChange() {
            // Don't auto-regenerate (would lose edits); just update vars
            const r = parseInt(document.getElementById('numRows').value) || 5;
            const c = parseInt(document.getElementById('numCols').value) || 10;
            document.getElementById('numRows').value = Math.max(1, Math.min(26, r));
            document.getElementById('numCols').value = Math.max(1, Math.min(50, c));
        }

        function generateGrid() {
            numRows = Math.max(1, Math.min(26, parseInt(document.getElementById('numRows').value) || 5));
            numCols = Math.max(1, Math.min(50, parseInt(document.getElementById('numCols').value) || 10));
            grid = Array.from({length: numRows}, () => Array(numCols).fill('normal'));
            renderGrid();
            document.getElementById('editorCard').style.display = 'block';
        }

        function renderGrid() {
            const container = document.getElementById('seatGrid');
            container.innerHTML = '';

            for (let r = 0; r < numRows; r++) {
                const rowEl = document.createElement('div');
                rowEl.className = 'grid-row';

                // Row label
                const lbl = document.createElement('div');
                lbl.className = 'row-lbl';
                lbl.textContent = String.fromCharCode(65 + r);
                rowEl.appendChild(lbl);

                for (let c = 0; c < numCols; c++) {
                    const type = grid[r][c];
                    if (type === 'partner') continue;

                    const cell = document.createElement('div');
                    cell.className = 'sc sc-' + type + (type === 'couple' ? ' couple' : '');
                    cell.dataset.row = r;
                    cell.dataset.col = c;

                    // Event image
                    if (imgUrl && type !== 'empty') {
                        const img = document.createElement('img');
                        img.src     = imgUrl;
                        img.alt     = '';
                        img.className = 'sc-img';
                        cell.appendChild(img);
                    }

                    // Seat label
                    const seatLbl = document.createElement('span');
                    seatLbl.className = 'sc-lbl';
                    if (type === 'couple') {
                        seatLbl.textContent = `${String.fromCharCode(65+r)}${c+1}–${c+2}`;
                    } else if (type !== 'empty') {
                        seatLbl.textContent = `${String.fromCharCode(65+r)}${c+1}`;
                    }
                    cell.appendChild(seatLbl);

                    cell.addEventListener('click', () => cycleCell(r, c));
                    rowEl.appendChild(cell);
                }

                container.appendChild(rowEl);
            }
        }

        function cycleCell(r, c) {
            const cur = grid[r][c];
            if (cur === 'partner') return;

            const cycle = ['normal', 'vip', 'couple', 'empty'];
            let nextIdx = (cycle.indexOf(cur) + 1) % cycle.length;
            let next    = cycle[nextIdx];

            // Free old partner if switching from couple
            if (cur === 'couple' && c + 1 < numCols && grid[r][c + 1] === 'partner')
                grid[r][c + 1] = 'normal';

            if (next === 'couple') {
                // Need a free right neighbour
                if (c + 1 >= numCols || grid[r][c + 1] === 'couple' || grid[r][c + 1] === 'partner') {
                    next = 'empty'; // skip couple
                    grid[r][c] = next;
                } else {
                    grid[r][c]     = 'couple';
                    grid[r][c + 1] = 'partner';
                }
            } else {
                grid[r][c] = next;
            }

            renderGrid();
        }

        async function saveGrid() {
            const cells = [];
            for (let r = 0; r < numRows; r++) {
                for (let c = 0; c < numCols; c++) {
                    const t = grid[r][c];
                    if (t === 'empty' || t === 'partner') continue;
                    cells.push({ row: r, col: c, type: t });
                }
            }
            if (cells.length === 0) { alert('Sơ đồ chưa có ghế nào.'); return; }

            const payload = {
                eventId,
                rows: numRows,
                cols: numCols,
                normalTicketTypeId: parseInt(document.getElementById('normalTt').value) || 0,
                vipTicketTypeId:    parseInt(document.getElementById('vipTt').value)    || 0,
                cells
            };
            document.getElementById('gridJsonInput').value = JSON.stringify(payload);
            document.getElementById('saveGridForm').submit();
        }
        </script>
    }

    @* ══════════════════ STATE B: VIEWER ══════════════════ *@
    else
    {
        <div class="sm-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div class="sm-card-title mb-0">🪑 Quản Lý Ghế</div>
                <div class="d-flex gap-2">
                    @if (!Model.HasSoldSeats)
                    {
                        <form method="post" asp-page-handler="Reset"
                              onsubmit="return confirm('Xóa toàn bộ sơ đồ? Hành động này không thể hoàn tác.')">
                            <input type="hidden" name="eventId" value="@evt.Id" />
                            <button class="btn-reset-sm" type="submit">🗑 Xóa & Tạo Lại</button>
                        </form>
                    }
                </div>
            </div>

            @if (Model.HasSoldSeats)
            {
                <div class="info-band">⚠️ Đã có ghế được bán — chỉ có thể bật/tắt ghế trống.</div>
            }

            @* Stats *@
            <div class="stats-row">
                <span>Tổng: <strong>@Model.Seats.Count</strong></span>
                <span>Trống: <strong style="color:#69f0ae;">@Model.Seats.Count(s => s.Status == SeatStatus.Available)</strong></span>
                <span>Đã bán: <strong style="color:#ef9a9a;">@Model.Seats.Count(s => s.Status == SeatStatus.Sold)</strong></span>
                <span>Vô hiệu: <strong style="color:rgba(210,195,255,.5);">@Model.Seats.Count(s => s.Status == SeatStatus.Disabled)</strong></span>
                <span>Đặt trước: <strong style="color:#ffa726;">@Model.Seats.Count(s => s.Status == SeatStatus.Reserved)</strong></span>
            </div>

            @* Legend *@
            <div class="legend-row mb-3">
                <div class="legend-item"><div class="l-dot" style="background:rgba(0,200,83,.25);border:2px solid rgba(0,200,83,.5);"></div>Trống (click bật/tắt)</div>
                <div class="legend-item"><div class="l-dot" style="background:rgba(255,255,255,.1);border:2px solid rgba(255,255,255,.1);"></div>Đã bán</div>
                <div class="legend-item"><div class="l-dot" style="background:rgba(229,57,53,.2);border:2px solid rgba(229,57,53,.4);"></div>Vô hiệu</div>
                <div class="legend-item"><div class="l-dot" style="background:rgba(255,167,38,.2);border:2px solid rgba(255,167,38,.4);"></div>Đặt trước</div>
            </div>

            @* Grid *@
            <div class="screen-wrap">
                <div class="screen-arc"></div>
                <span class="screen-label">Màn Hình / Sân Khấu</span>
            </div>

            <div class="grid-scroll">
                <div class="grid-rows">
                    @for (int r = 0; r < Model.GridRows; r++)
                    {
                        <div class="grid-row">
                            <div class="row-lbl">@((char)('A' + r))</div>
                            @for (int c = 0; c < Model.GridCols; c++)
                            {
                                @* Skip partner column *@
                                bool isPartner = c > 0
                                    && Model.SeatGrid.TryGetValue((r, c - 1), out var leftSeat)
                                    && leftSeat.SeatType == SeatType.Couple;
                                if (isPartner) continue;

                                Model.SeatGrid.TryGetValue((r, c), out var seat);
                                if (seat == null)
                                {
                                    @* Empty slot (aisle) *@
                                    <div class="sc sc-empty"
                                         style="width:36px;height:36px;"></div>
                                }
                                else
                                {
                                    bool isCouple    = seat.SeatType == SeatType.Couple;
                                    bool clickable   = seat.Status == SeatStatus.Available || seat.Status == SeatStatus.Disabled;
                                    string statusCss = seat.Status switch
                                    {
                                        SeatStatus.Sold     => "sc-sold",
                                        SeatStatus.Disabled => "sc-disabled",
                                        SeatStatus.Reserved => "sc-reserved",
                                        _                   => "sc-avail"
                                    };

                                    <div class="sc @statusCss @(isCouple ? "couple" : "")"
                                         id="s-@seat.Id"
                                         title="@seat.Label · @seat.Status"
                                         @(clickable ? $"onclick=\"toggleSeat({seat.Id})\"" : "")
                                         style="cursor:@(clickable ? "pointer" : "default")">
                                        @if (!string.IsNullOrEmpty(imgUrl))
                                        {
                                            <img src="@imgUrl" alt="" class="sc-img" />
                                        }
                                        <span class="sc-lbl">@seat.Label</span>
                                        @if (seat.Status == SeatStatus.Sold)
                                        {
                                            <span class="sc-badge">🔒</span>
                                        }
                                        @if (seat.Status == SeatStatus.Disabled)
                                        {
                                            <span class="sc-badge" style="color:rgba(239,154,154,.7);">✕</span>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <script>
        const eventId = @evt.Id;
        const afToken = () =>
            document.querySelector('#__afForm input[name="__RequestVerificationToken"]')?.value ?? '';

        async function toggleSeat(seatId) {
            const el = document.getElementById('s-' + seatId);
            if (!el) return;

            const fd = new FormData();
            fd.append('eventId', eventId);
            fd.append('seatId',  seatId);
            fd.append('__RequestVerificationToken', afToken());

            try {
                const res  = await fetch(`/Events/SeatMap/${eventId}?handler=ToggleSeat`, { method:'POST', body:fd });
                const data = await res.json();
                if (data.status === 'Available') {
                    el.className = el.className.replace(/sc-(sold|disabled|reserved|avail)/g, 'sc-avail');
                    el.setAttribute('onclick', `toggleSeat(${seatId})`);
                    el.style.cursor = 'pointer';
                    el.querySelector('.sc-badge')?.remove();
                } else if (data.status === 'Disabled') {
                    el.className = el.className.replace(/sc-(sold|disabled|reserved|avail)/g, 'sc-disabled');
                    el.querySelector('.sc-badge')?.remove();
                    const badge = document.createElement('span');
                    badge.className = 'sc-badge';
                    badge.style.color = 'rgba(239,154,154,.7)';
                    badge.textContent = '✕';
                    el.appendChild(badge);
                }
            } catch(e) { console.error('Toggle failed', e); }
        }
        </script>
    }
</div>
