@page "{eventId:int}"
@model EventTicketSystem.Web.Pages.Events.SeatMap.SeatMapIndexModel
@using EventTicketSystem.Web.Models
@{
    ViewData["Title"] = $"Sơ Đồ Ghế – {Model.Event?.Title}";
    var evt     = Model.Event!;
    var hasSeats = Model.Seats.Count > 0;
}

<style>
    .sm-wrap { padding: 2rem 0 3rem; }
    .sm-back { color:rgba(210,195,255,.5); font-size:.85rem; text-decoration:none; margin-bottom:1rem; display:inline-flex; align-items:center; gap:6px; }
    .sm-back:hover { color:#ede0ff; }
    .sm-header { font-size:1.45rem; font-weight:800; color:#ede0ff; margin-bottom:.25rem; }
    .sm-sub { color:rgba(210,195,255,.5); font-size:.88rem; margin-bottom:1.5rem; }

    /* Config card */
    .sm-card {
        background:rgba(20,10,52,.82); border:1px solid rgba(124,77,255,.28);
        border-radius:16px; padding:1.75rem 2rem; margin-bottom:1.5rem;
    }
    .sm-card-title { font-size:1rem; font-weight:700; color:#ede0ff; margin-bottom:1.25rem; padding-bottom:.75rem; border-bottom:1px solid rgba(124,77,255,.18); }

    /* Zone table */
    .zone-table { width:100%; border-collapse:collapse; margin-bottom:1rem; }
    .zone-table th { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:rgba(124,77,255,.75); padding:8px 10px; text-align:left; border-bottom:1px solid rgba(124,77,255,.2); }
    .zone-table td { padding:7px 8px; vertical-align:middle; }
    .zone-table input, .zone-table select {
        background:rgba(255,255,255,.05); border:1.5px solid rgba(124,77,255,.25); border-radius:8px;
        color:#ede0ff; font-size:.88rem; padding:6px 10px; width:100%;
    }
    .zone-table input:focus, .zone-table select:focus { outline:none; border-color:rgba(124,77,255,.55); }
    .zone-table select option { background:#1a0a40; }
    .zone-table .td-del { width:40px; text-align:center; }
    .btn-del-zone { background:none; border:none; color:rgba(239,154,154,.6); font-size:1.1rem; cursor:pointer; padding:4px 8px; border-radius:6px; }
    .btn-del-zone:hover { background:rgba(229,57,53,.12); color:#ef9a9a; }

    .btn-add-zone { background:rgba(124,77,255,.1); border:1px solid rgba(124,77,255,.3); border-radius:8px; color:rgba(179,136,255,.9); font-size:.84rem; font-weight:600; padding:7px 16px; cursor:pointer; transition:background .15s; }
    .btn-add-zone:hover { background:rgba(124,77,255,.22); }

    .btn-generate { background:linear-gradient(90deg,#7c4dff,#448aff); border:none; border-radius:10px; color:#fff; font-weight:700; font-size:.92rem; padding:10px 28px; cursor:pointer; box-shadow:0 3px 14px rgba(124,77,255,.35); transition:opacity .15s; }
    .btn-generate:hover { opacity:.88; }

    /* Seat grid */
    .legend-row { display:flex; gap:14px; flex-wrap:wrap; margin-bottom:1.25rem; align-items:center; }
    .legend-item { display:flex; align-items:center; gap:6px; font-size:.78rem; color:rgba(210,195,255,.65); }
    .legend-dot { width:16px; height:16px; border-radius:4px; }
    .ld-avail   { background:#00c853; }
    .ld-sold    { background:rgba(255,255,255,.15); }
    .ld-dis     { background:rgba(229,57,53,.5); border:1px solid rgba(229,57,53,.4); }

    .zone-tab-row { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:1.25rem; }
    .zone-tab { padding:6px 16px; border-radius:20px; font-size:.82rem; font-weight:600; cursor:pointer; border:1px solid rgba(124,77,255,.3); background:rgba(124,77,255,.08); color:rgba(210,195,255,.7); transition:all .15s; }
    .zone-tab.active { background:rgba(124,77,255,.25); border-color:rgba(124,77,255,.55); color:#ede0ff; }

    .stage-bar { background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.1); border-radius:8px; text-align:center; padding:8px; font-size:.75rem; font-weight:700; letter-spacing:.12em; color:rgba(210,195,255,.35); text-transform:uppercase; margin-bottom:1.25rem; }

    .seat-zone-panel { display:none; }
    .seat-zone-panel.active { display:block; }

    .seat-row { display:flex; align-items:center; margin-bottom:6px; gap:5px; }
    .seat-row-label { width:24px; font-size:.72rem; font-weight:700; color:rgba(210,195,255,.4); text-align:center; flex-shrink:0; }
    .seat {
        width:32px; height:32px; border-radius:5px; font-size:.65rem; font-weight:700;
        display:flex; align-items:center; justify-content:center; cursor:pointer;
        transition:transform .12s, opacity .12s; user-select:none; flex-shrink:0;
        border:1px solid transparent;
    }
    .seat:hover:not(.seat-sold):not(.seat-reserved) { transform:scale(1.15); }
    .seat-avail   { background:rgba(0,200,83,.25); border-color:rgba(0,200,83,.4); color:#69f0ae; }
    .seat-avail:hover { background:rgba(0,200,83,.4); }
    .seat-sold    { background:rgba(255,255,255,.1); border-color:rgba(255,255,255,.08); color:rgba(210,195,255,.3); cursor:default; }
    .seat-disabled{ background:rgba(229,57,53,.2); border-color:rgba(229,57,53,.35); color:rgba(239,154,154,.6); }
    .seat-disabled:hover { background:rgba(229,57,53,.35); }
    .seat-reserved{ background:rgba(255,167,38,.2); border-color:rgba(255,167,38,.35); color:#ffa726; cursor:default; }

    .zone-info-bar { font-size:.8rem; color:rgba(210,195,255,.5); margin-bottom:1rem; }

    .btn-reset { background:rgba(229,57,53,.1); border:1px solid rgba(229,57,53,.3); border-radius:8px; color:#ef9a9a; font-size:.82rem; font-weight:600; padding:7px 18px; cursor:pointer; transition:background .15s; }
    .btn-reset:hover { background:rgba(229,57,53,.2); }

    .sm-alert-ok  { background:rgba(0,200,83,.1); border:1px solid rgba(0,200,83,.25); border-radius:10px; padding:10px 16px; color:#69f0ae; font-size:.88rem; margin-bottom:1rem; }
    .sm-alert-err { background:rgba(229,57,53,.1); border:1px solid rgba(229,57,53,.25); border-radius:10px; padding:10px 16px; color:#ef9a9a; font-size:.88rem; margin-bottom:1rem; }
</style>

<form id="__afForm" method="post" style="display:none;"></form>

<div class="container-xl px-3 px-md-4 sm-wrap">

    <a href="/Events/Details/@evt.Id" class="sm-back">← Quay lại sự kiện</a>

    <div class="sm-header">🗺️ Sơ Đồ Ghế</div>
    <div class="sm-sub">@evt.Title</div>

    @if (TempData["Success"] is string ok)  { <div class="sm-alert-ok">✅ @ok</div> }
    @if (TempData["Error"]   is string err) { <div class="sm-alert-err">⚠️ @err</div> }

    @* ── State A: No seats yet → Configuration form ── *@
    @if (!hasSeats)
    {
        <div class="sm-card">
            <div class="sm-card-title">⚙️ Cấu Hình Khu Vực</div>
            <p style="font-size:.85rem;color:rgba(210,195,255,.5);margin-bottom:1.25rem;">
                Thêm các khu vực (zone), chỉ định loại vé và số hàng × ghế/hàng. Tối đa 26 hàng (A–Z), 99 ghế/hàng.
            </p>

            <table class="zone-table" id="zoneTable">
                <thead>
                    <tr>
                        <th>Tên khu</th>
                        <th>Loại vé</th>
                        <th>Số hàng</th>
                        <th>Ghế/hàng</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="zoneTbody"></tbody>
            </table>

            <div class="d-flex align-items-center gap-3 flex-wrap">
                <button type="button" class="btn-add-zone" onclick="addZoneRow()">+ Thêm khu vực</button>
                <button type="button" class="btn-generate" onclick="generateSeats()">🪑 Tạo Sơ Đồ</button>
            </div>

            @* Hidden form to submit config *@
            <form id="configForm" method="post" asp-page-handler="Configure">
                <input type="hidden" name="eventId" value="@evt.Id" />
                <input type="hidden" name="zonesJson" id="zonesJson" />
            </form>
        </div>

        <script>
        const ticketTypes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            evt.TicketTypes.Select(t => new { id = t.Id, name = t.Name, price = t.Price })
        ));

        let zoneRowId = 0;
        function addZoneRow(zone='', ttId=0, rows=5, cols=10) {
            zoneRowId++;
            const rid = zoneRowId;
            const ttOptions = ticketTypes.map(t =>
                `<option value="${t.id}" ${t.id===ttId?'selected':''}>${t.name} (${t.price.toLocaleString('vi')}đ)</option>`
            ).join('');
            const tr = document.createElement('tr');
            tr.id = 'zr-' + rid;
            tr.innerHTML = `
                <td><input type="text" value="${zone}" placeholder="VD: VIP, A, B1" id="zzn-${rid}" maxlength="20" /></td>
                <td><select id="ztt-${rid}"><option value="0">-- Không gán --</option>${ttOptions}</select></td>
                <td><input type="number" value="${rows}" min="1" max="26" id="zrw-${rid}" /></td>
                <td><input type="number" value="${cols}" min="1" max="99" id="zcl-${rid}" /></td>
                <td class="td-del"><button type="button" class="btn-del-zone" onclick="document.getElementById('zr-${rid}').remove()">✕</button></td>
            `;
            document.getElementById('zoneTbody').appendChild(tr);
        }

        function generateSeats() {
            const rows = document.querySelectorAll('#zoneTbody tr');
            if (rows.length === 0) { alert('Vui lòng thêm ít nhất 1 khu vực.'); return; }
            const zones = [];
            let valid = true;
            rows.forEach(tr => {
                const rid = tr.id.replace('zr-','');
                const zoneName = document.getElementById('zzn-'+rid)?.value?.trim();
                if (!zoneName) { valid = false; return; }
                zones.push({
                    Zone: zoneName,
                    TicketTypeId: parseInt(document.getElementById('ztt-'+rid)?.value || '0'),
                    Rows: parseInt(document.getElementById('zrw-'+rid)?.value || '5'),
                    SeatsPerRow: parseInt(document.getElementById('zcl-'+rid)?.value || '10')
                });
            });
            if (!valid || zones.length === 0) { alert('Vui lòng điền tên khu vực cho tất cả các hàng.'); return; }
            document.getElementById('zonesJson').value = JSON.stringify(zones);
            document.getElementById('configForm').submit();
        }

        // Auto-add 2 default rows
        addZoneRow('VIP', @(evt.TicketTypes.OrderByDescending(t => t.Price).FirstOrDefault()?.Id ?? 0), 3, 10);
        addZoneRow('A',   @(evt.TicketTypes.OrderBy(t => t.Price).FirstOrDefault()?.Id ?? 0), 5, 20);
        </script>
    }

    @* ── State B: Seats exist → Grid management ── *@
    else
    {
        <div class="sm-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div class="sm-card-title mb-0">🪑 Quản Lý Ghế</div>
                <div class="d-flex gap-2 flex-wrap">
                    @if (!Model.HasSoldSeats)
                    {
                        <form method="post" asp-page-handler="Reset" onsubmit="return confirm('Xóa toàn bộ sơ đồ ghế? Hành động này không thể hoàn tác.')">
                            <input type="hidden" name="eventId" value="@evt.Id" />
                            <button class="btn-reset" type="submit">🗑 Xóa & Tạo Lại</button>
                        </form>
                    }
                </div>
            </div>

            @if (Model.HasSoldSeats)
            {
                <div style="background:rgba(255,167,38,.08);border:1px solid rgba(255,167,38,.25);border-radius:8px;padding:10px 14px;font-size:.82rem;color:#ffa726;margin-bottom:1rem;">
                    ⚠️ Đã có ghế được bán — cấu trúc bị khóa. Bạn chỉ có thể bật/tắt ghế trống.
                </div>
            }

            @* Legend *@
            <div class="legend-row">
                <div class="legend-item"><div class="legend-dot ld-avail"></div>Trống (click để vô hiệu)</div>
                <div class="legend-item"><div class="legend-dot ld-sold"></div>Đã bán</div>
                <div class="legend-item"><div class="legend-dot ld-dis"></div>Vô hiệu (click để mở)</div>
                <div style="margin-left:auto;font-size:.78rem;color:rgba(210,195,255,.4);">
                    Tổng: @Model.Seats.Count | Trống: @Model.Seats.Count(s => s.Status == SeatStatus.Available) | Bán: @Model.Seats.Count(s => s.Status == SeatStatus.Sold) | Vô hiệu: @Model.Seats.Count(s => s.Status == SeatStatus.Disabled)
                </div>
            </div>

            @* Zone tabs *@
            <div class="zone-tab-row">
                @{int zi = 0;}
                @foreach (var zone in Model.SeatsByZone.Keys)
                {
                    var zoneSeats = Model.SeatsByZone[zone];
                    var tt = zoneSeats.First().TicketType;
                    <button class="zone-tab @(zi == 0 ? "active" : "")" onclick="switchZone('@zone', this)">
                        @zone @(tt != null ? $"({tt.Name})" : "")
                    </button>
                    zi++;
                }
            </div>

            @* Seat grids per zone *@
            @{int zIdx = 0;}
            @foreach (var (zone, zoneSeats) in Model.SeatsByZone)
            {
                var rows = zoneSeats.GroupBy(s => s.RowLabel).OrderBy(g => g.Key).ToList();
                var tt = zoneSeats.First().TicketType;
                <div class="seat-zone-panel @(zIdx == 0 ? "active" : "")" id="zone-panel-@zone">
                    <div class="zone-info-bar">
                        @zone
                        @if (tt != null) { <span>· @tt.Name · @tt.Price.ToString("N0")đ/ghế</span> }
                        · @zoneSeats.Count ghế
                    </div>
                    <div class="stage-bar">— Sân Khấu / Màn Hình —</div>
                    @foreach (var rowGrp in rows)
                    {
                        <div class="seat-row">
                            <div class="seat-row-label">@rowGrp.Key</div>
                            @foreach (var seat in rowGrp.OrderBy(s => s.SeatNumber))
                            {
                                var cls = seat.Status switch
                                {
                                    SeatStatus.Sold     => "seat-sold",
                                    SeatStatus.Disabled => "seat-disabled",
                                    SeatStatus.Reserved => "seat-reserved",
                                    _                   => "seat-avail"
                                };
                                var clickable = seat.Status == SeatStatus.Available || seat.Status == SeatStatus.Disabled;
                                <div class="seat @cls"
                                     id="seat-@seat.Id"
                                     title="@seat.Label · @seat.Status"
                                     @(clickable ? $"onclick=\"toggleSeat({seat.Id})\"" : "")>
                                    @seat.SeatNumber
                                </div>
                            }
                        </div>
                    }
                </div>
                zIdx++;
            }
        </div>

        <script>
        const eventId = @evt.Id;
        const afToken = () => document.querySelector('#__afForm input[name="__RequestVerificationToken"]')?.value ?? '';

        function switchZone(zone, btn) {
            document.querySelectorAll('.seat-zone-panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.zone-tab').forEach(b => b.classList.remove('active'));
            document.getElementById('zone-panel-' + zone)?.classList.add('active');
            btn.classList.add('active');
        }

        async function toggleSeat(seatId) {
            const el = document.getElementById('seat-' + seatId);
            if (!el) return;

            const fd = new FormData();
            fd.append('eventId', eventId);
            fd.append('seatId', seatId);
            fd.append('__RequestVerificationToken', afToken());

            try {
                const res = await fetch(`/Events/SeatMap/${eventId}?handler=ToggleSeat`, { method: 'POST', body: fd });
                const data = await res.json();
                if (data.status === 'Available') {
                    el.className = 'seat seat-avail';
                    el.setAttribute('onclick', `toggleSeat(${seatId})`);
                    el.title = el.title.replace(/·.*$/, '· Available');
                } else if (data.status === 'Disabled') {
                    el.className = 'seat seat-disabled';
                    el.setAttribute('onclick', `toggleSeat(${seatId})`);
                    el.title = el.title.replace(/·.*$/, '· Disabled');
                }
            } catch (e) {
                console.error('Toggle failed', e);
            }
        }
        </script>
    }
</div>
