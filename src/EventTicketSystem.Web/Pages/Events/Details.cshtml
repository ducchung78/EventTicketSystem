@page "{id:int}"
@model EventTicketSystem.Web.Pages.Events.EventDetailsModel
@{
    ViewData["Title"] = Model.Event?.Title ?? "Chi Tiết Sự Kiện";
    var evt      = Model.Event;
    var minPrice = evt?.TicketTypes.Where(t => t.AvailableQuantity > 0).OrderBy(t => t.Price).FirstOrDefault()?.Price;
    var hasTickets  = evt?.TicketTypes.Any() ?? false;
    var hasBuyable  = evt?.TicketTypes.Any(t => t.AvailableQuantity > 0) ?? false;
}

@if (evt == null)
{
    <div class="container py-5">
        <div class="alert alert-danger">Không tìm thấy sự kiện.</div>
        <a href="/Events" class="btn btn-secondary">Quay Lại</a>
    </div>
    return;
}

@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-danger alert-dismissible mx-n4 rounded-0 mb-0" role="alert">
        <div class="container">@errMsg</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["CartSuccess"] is string cartOk)
{
    <div class="alert alert-success alert-dismissible mx-n4 rounded-0 mb-0" role="alert">
        <div class="container">🛒 @cartOk <a href="/Cart" class="alert-link ms-2">Xem giỏ hàng →</a></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<style>
/* ── Base page ── */
.tb-page {
    background: #12151F;
    min-height: 100vh;
    padding: 24px 0 60px;
}
.tb-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* ── Breadcrumb ── */
.tb-breadcrumb {
    font-size: .78rem;
    color: rgba(255,255,255,.35);
    margin-bottom: 20px;
}
.tb-breadcrumb a { color: rgba(255,255,255,.45); text-decoration: none; }
.tb-breadcrumb a:hover { color: #2DC275; }
.tb-breadcrumb span { margin: 0 6px; }

/* ── Section A: Hero card ── */
.tb-hero {
    background: #1A1D2A;
    border: none;
    outline: none;
    box-shadow: none;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    margin-bottom: 20px;
    min-height: 360px;
}
.tb-hero-left {
    flex: 0 0 40%;
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #13151F;
}
.tb-hero-right {
    flex: 0 0 60%;
    position: relative;
    overflow: hidden;
    border-radius: 0 16px 16px 0;
}
.tb-hero-right img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
}
.tb-hero-right-ph {
    width: 100%;
    height: 100%;
    min-height: 360px;
    background: linear-gradient(135deg, #1a1d2a, #2a2d3a);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5rem;
    opacity: .3;
    border-radius: 0;
}

.tb-cat-badge {
    display: inline-block;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .06em;
    padding: 4px 12px;
    border-radius: 50px;
    background: rgba(45,194,117,.15);
    color: #2DC275;
    border: 1px solid rgba(45,194,117,.35);
    margin-bottom: 14px;
    text-transform: uppercase;
}

.tb-hero-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.25;
    margin-bottom: 18px;
}

.tb-meta-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 10px;
    font-size: .88rem;
}
.tb-meta-icon { color: #2DC275; font-size: 1rem; flex-shrink: 0; margin-top: 1px; }
.tb-meta-text { color: rgba(255,255,255,.75); line-height: 1.4; }
.tb-meta-text strong { color: #fff; display: block; }
.tb-more-dates {
    display: inline-block;
    font-size: .72rem;
    font-weight: 600;
    padding: 2px 10px;
    border-radius: 20px;
    border: 1px solid rgba(255,255,255,.25);
    color: rgba(255,255,255,.55);
    margin-top: 5px;
}

.tb-price-label {
    font-size: .75rem;
    color: rgba(255,255,255,.4);
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-bottom: 3px;
}
.tb-price-value {
    font-size: 1.75rem;
    font-weight: 800;
    color: #2DC275;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
}
.tb-price-value span { font-size: .85rem; }

.tb-btn-buy {
    display: block;
    width: 100%;
    padding: 14px;
    border-radius: 10px;
    background: #2DC275;
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition: background .2s ease, transform .15s ease;
}
.tb-btn-buy:hover { background: #25a863; color: #fff; transform: translateY(-1px); }
.tb-btn-buy:disabled, .tb-btn-buy.disabled {
    background: rgba(255,255,255,.1);
    color: rgba(255,255,255,.35);
    cursor: default;
    transform: none;
}

/* ── Section cards ── */
.tb-section {
    background: #1E2130;
    border-radius: 14px;
    margin-bottom: 16px;
    overflow: hidden;
}
.tb-section-header {
    padding: 18px 24px 16px;
    border-bottom: 1px solid rgba(255,255,255,.06);
}
.tb-section-title {
    font-size: 1rem;
    font-weight: 700;
    color: #2DC275;
    margin: 0;
    border-left: 4px solid #2DC275;
    padding-left: 12px;
}
.tb-section-body {
    padding: 20px 24px;
}

/* ── Section B: Giới thiệu ── */
.tb-desc-text {
    color: rgba(255,255,255,.72);
    line-height: 1.85;
    font-size: .92rem;
}
.tb-desc-collapsed {
    max-height: 120px;
    overflow: hidden;
    position: relative;
}
.tb-desc-collapsed::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 48px;
    background: linear-gradient(transparent, #1E2130);
}
.tb-desc-collapsed.expanded { max-height: none; }
.tb-desc-collapsed.expanded::after { display: none; }
.tb-expand-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 10px;
    background: none;
    border: none;
    color: #2DC275;
    font-size: .84rem;
    font-weight: 600;
    cursor: pointer;
    padding: 4px 0;
}
.tb-expand-btn:hover { opacity: .8; }

/* ── Gallery carousel ── */
.gc-wrap { margin-top: 18px; display: none; }
.gc-stage {
    position: relative; display: flex; align-items: center;
    background: rgba(10,6,28,.7); border-radius: 12px; overflow: hidden;
    min-height: 200px;
}
.gc-img-box {
    flex: 1; display: flex; align-items: center; justify-content: center;
    padding: 14px 60px;
}
.gc-img { max-width: 100%; max-height: 380px; object-fit: contain; border-radius: 8px; transition: opacity .2s; }
.gc-nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 42px; height: 42px; border-radius: 50%; border: 1px solid rgba(45,194,117,.4);
    background: rgba(45,194,117,.2); color: #fff; font-size: 1rem;
    cursor: pointer; z-index: 2; display: flex; align-items: center; justify-content: center;
    transition: background .15s;
}
.gc-nav:hover { background: rgba(45,194,117,.5); }
.gc-prev { left: 10px; } .gc-next { right: 10px; }
.gc-footer { padding: 10px 14px 4px; }
.gc-caption { font-size: .78rem; color: rgba(255,255,255,.4); text-align: center; min-height: 1.1em; margin-bottom: 8px; }
.gc-dots { display: flex; gap: 6px; justify-content: center; flex-wrap: wrap; }
.gc-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.2); cursor: pointer; transition: background .15s; }
.gc-dot.active { background: #2DC275; }

/* ── Section C: Lịch diễn ── */
#section-schedule {}
.tb-schedule-item {
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 10px;
}
.tb-schedule-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    cursor: pointer;
    transition: background .15s;
    gap: 12px;
}
.tb-schedule-row:hover { background: rgba(255,255,255,.03); }
.tb-schedule-left { display: flex; align-items: center; gap: 14px; }
.tb-schedule-chevron {
    color: rgba(255,255,255,.35);
    font-size: .9rem;
    transition: transform .25s ease;
    flex-shrink: 0;
}
.tb-schedule-item.open .tb-schedule-chevron { transform: rotate(180deg); }
.tb-schedule-time {
    font-size: .97rem;
    font-weight: 700;
    color: #fff;
}
.tb-schedule-date {
    font-size: .85rem;
    color: #2DC275;
    margin-top: 2px;
}
.tb-schedule-body {
    display: none;
    padding: 0 20px 16px;
    border-top: 1px solid rgba(255,255,255,.06);
}
.tb-schedule-item.open .tb-schedule-body { display: block; }

/* ── Ticket type table inside accordion ── */
.tb-tkt-table {
    width: 100%;
    margin-top: 12px;
}
.tb-tkt-head {
    display: flex;
    padding: 6px 0;
    border-bottom: 1px solid rgba(255,255,255,.08);
    font-size: .72rem;
    font-weight: 600;
    color: rgba(255,255,255,.35);
    text-transform: uppercase;
    letter-spacing: .04em;
}
.tb-tkt-row {
    display: flex;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255,255,255,.05);
    font-size: .88rem;
}
.tb-tkt-row:last-child { border-bottom: none; }
.tb-tkt-row.tb-tkt-clickable {
    cursor: pointer;
    transition: background .2s ease;
    border-radius: 6px;
    padding-left: 6px;
    padding-right: 6px;
}
.tb-tkt-row.tb-tkt-clickable:hover { background: rgba(255,255,255,.06); }
.tb-tkt-name { flex: 1; color: rgba(255,255,255,.8); }
.tb-tkt-price { font-weight: 700; color: #2DC275; flex-shrink: 0; }
.tb-tkt-sold { color: rgba(255,255,255,.25); font-size: .78rem; }

/* ── Buy button in schedule ── */
.tb-btn-buy-sm {
    flex-shrink: 0;
    padding: 9px 24px;
    border-radius: 8px;
    background: #2DC275;
    color: #fff;
    font-size: .88rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: background .2s ease;
}
.tb-btn-buy-sm:hover { background: #25a863; color: #fff; }

/* ── Related events cards ── */
.tb-rel-section { margin-top: 32px; }
.tb-rel-title {
    text-align: center;
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 20px;
}
.tb-rel-card {
    background: #1E2130;
    border-radius: 12px;
    overflow: hidden;
    transition: transform .2s ease, box-shadow .2s ease;
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
}
.tb-rel-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,.4);
    text-decoration: none;
    color: inherit;
}
.tb-rel-img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
}
.tb-rel-img-ph {
    width: 100%;
    aspect-ratio: 16/9;
    background: #2a2d3a;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    opacity: .3;
}
.tb-rel-body { padding: 14px; }
.tb-rel-name {
    font-size: .9rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
}
.tb-rel-price {
    font-size: .82rem;
    color: #2DC275;
    font-weight: 600;
    margin-bottom: 4px;
}
.tb-rel-date {
    font-size: .75rem;
    color: rgba(255,255,255,.4);
}

/* ── Admin strip ── */
.tb-admin-strip {
    margin-top: 12px;
    padding: 12px 0;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    border-top: 1px solid rgba(255,255,255,.06);
}

/* ── Buy modal overrides (green accent) ── */
.tb-modal .modal-content {
    background: #1E2130;
    border: 1px solid rgba(45,194,117,.25);
    border-radius: 16px;
}
.tb-modal .modal-header {
    background: linear-gradient(90deg, #2DC275, #25a863);
    border-radius: 16px 16px 0 0;
    border-bottom: none;
}
.tb-modal .modal-body { background: #1E2130; color: rgba(255,255,255,.8); }
.tb-modal .modal-footer { background: #1E2130; border-top: 1px solid rgba(255,255,255,.06); }
.tb-modal .form-control {
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.15);
    color: #fff;
    border-radius: 8px;
}
.tb-modal .form-control:focus {
    background: rgba(255,255,255,.1);
    border-color: #2DC275;
    box-shadow: 0 0 0 2px rgba(45,194,117,.2);
    color: #fff;
}
.tb-modal .form-control::placeholder { color: rgba(255,255,255,.3); }
.tb-modal .form-label { color: rgba(255,255,255,.7); font-size: .84rem; }
.tb-modal .bg-light {
    background: rgba(255,255,255,.06) !important;
    border-radius: 10px;
}

/* ── Coupon bar ── */
.coupon-bar { padding: 0; }
.coupon-bar-inner {
    display: flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(45,194,117,.2);
    border-radius: 10px; padding: 8px 10px;
    transition: border-color .15s;
}
.coupon-bar-inner:focus-within { border-color: rgba(45,194,117,.6); box-shadow: 0 0 0 2px rgba(45,194,117,.12); }
.coupon-icon { font-size: 1rem; flex-shrink: 0; }
.coupon-bar-input {
    flex: 1; border: none; background: transparent;
    color: #fff; font-size: .88rem; outline: none;
    text-transform: uppercase; letter-spacing: .04em;
}
.coupon-bar-input::placeholder { color: rgba(255,255,255,.3); text-transform: none; letter-spacing: 0; }
.btn-apply-coupon-green {
    padding: 5px 14px; border-radius: 8px; flex-shrink: 0;
    background: #2DC275; border: none; color: #fff;
    font-weight: 700; font-size: .8rem; cursor: pointer;
    transition: opacity .15s;
}
.btn-apply-coupon-green:hover { opacity: .85; }
.coupon-feedback { font-size: .78rem; margin-top: 6px; padding: 5px 10px; border-radius: 6px; }
.coupon-feedback.ok  { background: rgba(45,194,117,.12); color: #2DC275; border: 1px solid rgba(45,194,117,.25); }
.coupon-feedback.err { background: rgba(229,57,53,.1); color: #ef9a9a; border: 1px solid rgba(229,57,53,.2); }

/* ── Total summary ── */
.total-summary {
    background: rgba(45,194,117,.07);
    border: 1px solid rgba(45,194,117,.18);
    border-radius: 12px; padding: 12px 16px;
}
.total-row-item {
    display: flex; justify-content: space-between; align-items: center;
    font-size: .84rem; color: rgba(255,255,255,.55); padding: 3px 0;
}
.total-gross-val { color: rgba(255,255,255,.35); text-decoration: line-through; }
.total-discount-item { color: #2DC275 !important; }
.total-discount-val { color: #2DC275; font-weight: 600; }
.total-final-item {
    margin-top: 8px; padding-top: 8px;
    border-top: 1px solid rgba(45,194,117,.15);
}
.total-final-lbl { font-weight: 700; font-size: .95rem; color: rgba(255,255,255,.9); }
.total-final-val { font-weight: 800; font-size: 1.45rem; color: #2DC275; }

/* ── Modal footer buttons ── */
.btn-modal-close {
    padding: 9px 18px; border-radius: 50px;
    border: 1px solid rgba(255,255,255,.15);
    background: transparent; color: rgba(255,255,255,.5);
    font-size: .85rem; cursor: pointer;
}
.btn-modal-close:hover { border-color: rgba(255,255,255,.35); color: rgba(255,255,255,.8); }
.btn-modal-cart {
    padding: 9px 18px; border-radius: 50px;
    background: rgba(45,194,117,.12);
    border: 1px solid rgba(45,194,117,.35);
    color: #2DC275; font-weight: 700; font-size: .85rem;
    cursor: pointer;
}
.btn-modal-cart:hover { background: rgba(45,194,117,.25); }
.btn-modal-pay {
    padding: 9px 22px; border-radius: 50px; flex: 1;
    background: #2DC275; border: none; color: #fff;
    font-weight: 700; font-size: .88rem; cursor: pointer;
    box-shadow: 0 2px 14px rgba(45,194,117,.35);
    transition: opacity .15s;
}
.btn-modal-pay:hover { opacity: .88; }

/* Toast */
#cartToast {
    background: rgba(18,21,31,.97);
    border: 1px solid rgba(45,194,117,.3);
    border-radius: 14px; min-width: 280px;
    backdrop-filter: blur(12px);
}

@@media (max-width: 900px) {
    .tb-hero { flex-direction: column-reverse; }
    .tb-hero-left, .tb-hero-right { flex: none; width: 100%; }
    .tb-hero-right img { max-height: 240px; }
}
@@media (max-width: 600px) {
    .tb-hero-left { padding: 20px 16px; }
    .tb-hero-title { font-size: 1.25rem; }
    .tb-section-body { padding: 16px; }
}
</style>

<div class="tb-page">
<div class="tb-inner">

    @* ── Breadcrumb ── *@
    <nav class="tb-breadcrumb" aria-label="breadcrumb">
        <a href="/">Trang Chủ</a><span>/</span>
        <a href="/Events">Sự Kiện</a><span>/</span>
        <span style="color:rgba(255,255,255,.65);">@evt.Title</span>
    </nav>

    @* ── Section A: Hero Card ── *@
    <div class="tb-hero">
        @* Cột trái 40% — thông tin + giá + nút mua *@
        <div class="tb-hero-left">
            <div>
                @if (!string.IsNullOrEmpty(evt.Category))
                {
                    <div class="tb-cat-badge">@evt.Category</div>
                }
                @if (evt.IsHot)   { <span class="badge bg-danger me-1" style="font-size:.7rem;">🔥 HOT</span> }
                @if (evt.IsSpecial) { <span class="badge me-1" style="background:rgba(255,215,64,.2);color:#ffd740;border:1px solid rgba(255,215,64,.3);font-size:.7rem;">⭐ Đặc Biệt</span> }

                <h1 class="tb-hero-title">@evt.Title</h1>

                <div class="tb-meta-row">
                    <i class="bi bi-calendar-event tb-meta-icon"></i>
                    <div class="tb-meta-text">
                        <strong>
                            @evt.StartDate.ToLocalTime().ToString("HH:mm")
                            @if (evt.EndDate.HasValue)
                            { <text> – @evt.EndDate.Value.ToLocalTime().ToString("HH:mm")</text> },
                            @evt.StartDate.ToLocalTime().ToString("dd") Tháng @evt.StartDate.ToLocalTime().ToString("MM, yyyy")
                        </strong>
                    </div>
                </div>

                <div class="tb-meta-row">
                    <i class="bi bi-geo-alt tb-meta-icon"></i>
                    <div class="tb-meta-text">
                        <strong>@evt.Venue</strong>
                    </div>
                </div>
            </div>

            <div>
                @if (hasBuyable && minPrice.HasValue)
                {
                    <div class="tb-price-label">Giá từ</div>
                    <div class="tb-price-value">
                        @if (minPrice == 0)
                        {
                            <span style="font-size:1.5rem;">Miễn phí</span>
                        }
                        else
                        {
                            @String.Format("{0:N0} đ", minPrice.Value)
                            <i class="bi bi-chevron-right" style="font-size:1rem;opacity:.6;"></i>
                        }
                    </div>
                    <button id="btn-buy-hero" class="tb-btn-buy">Mua vé ngay</button>
                }
                else if (!hasTickets)
                {
                    <div style="color:rgba(255,255,255,.35);font-size:.88rem;">Chưa có thông tin vé</div>
                }
                else
                {
                    <span class="tb-btn-buy disabled">Đã hết vé</span>
                }
            </div>
        </div>

        @* Cột phải 60% — banner image *@
        <div class="tb-hero-right">
            @if (!string.IsNullOrEmpty(evt.ImageUrl))
            {
                <img src="@evt.ImageUrl" alt="@evt.Title" />
            }
            else
            {
                <div class="tb-hero-right-ph">🎫</div>
            }
        </div>
    </div>

    @* ── Section B: Giới thiệu ── *@
    @if (!string.IsNullOrEmpty(evt.Description))
    {
        <div class="tb-section">
            <div class="tb-section-header">
                <h2 class="tb-section-title">Giới thiệu</h2>
            </div>
            <div class="tb-section-body">
                <div class="tb-desc-text tb-desc-collapsed" id="descText">
                    @Html.Raw(evt.Description.Replace("\n", "<br/>"))
                </div>
                <button class="tb-expand-btn" id="descExpandBtn" onclick="toggleDesc()">
                    <i class="bi bi-chevron-down" id="descChevron"></i> Xem thêm
                </button>

                @* Gallery carousel – hiện khi expand *@
                @if (Model.GalleryImages.Any())
                {
                    <div class="gc-wrap" id="gcWrap">
                        <div class="gc-stage">
                            <button class="gc-nav gc-prev" onclick="gcMove(-1)" aria-label="Ảnh trước">&#9664;</button>
                            <div class="gc-img-box">
                                <img id="gcImg" src="@Model.GalleryImages[0].ImagePath" alt="" class="gc-img" />
                            </div>
                            <button class="gc-nav gc-next" onclick="gcMove(1)" aria-label="Ảnh tiếp">&#9654;</button>
                        </div>
                        <div class="gc-footer">
                            <div id="gcCaption" class="gc-caption">@(Model.GalleryImages[0].Caption ?? "")</div>
                            <div id="gcDots" class="gc-dots">
                                @for (int d = 0; d < Model.GalleryImages.Count; d++)
                                {
                                    <span class="gc-dot @(d == 0 ? "active" : "")" data-idx="@d" onclick="gcGoto(@d)"></span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ── Section C: Lịch diễn ── *@
    <div class="tb-section" id="section-schedule">
        <div class="tb-section-header">
            <h2 class="tb-section-title">Lịch diễn</h2>
        </div>
        <div class="tb-section-body">
            @* Sự kiện hiện tại chỉ có 1 suất diễn (StartDate/EndDate) *@
            <div class="tb-schedule-item open" id="scheduleItem0">
                <div class="tb-schedule-row" onclick="toggleSchedule('scheduleItem0')">
                    <div class="tb-schedule-left">
                        <i class="bi bi-chevron-down tb-schedule-chevron"></i>
                        <div>
                            <div class="tb-schedule-time">
                                @evt.StartDate.ToLocalTime().ToString("HH:mm")
                                @if (evt.EndDate.HasValue)
                                { <text>– @evt.EndDate.Value.ToLocalTime().ToString("HH:mm")</text> }
                            </div>
                            <div class="tb-schedule-date">
                                @evt.StartDate.ToLocalTime().ToString("dd") Tháng @evt.StartDate.ToLocalTime().ToString("MM, yyyy")
                            </div>
                        </div>
                    </div>
                    @if (hasBuyable)
                    {
                        @if (evt.HasSeatMap)
                        {
                            <a asp-page="/Events/SelectSeats" asp-route-id="@evt.Id" class="tb-btn-buy-sm">Mua vé ngay</a>
                        }
                        else
                        {
                            <button type="button" class="tb-btn-buy-sm" onclick="openFirstTicket(); event.stopPropagation();">Mua vé ngay</button>
                        }
                    }
                    else if (hasTickets)
                    {
                        <span class="badge bg-secondary px-3 py-2">Hết vé</span>
                    }
                </div>

                @* Accordion body: bảng thông tin vé *@
                <div class="tb-schedule-body">
                    @if (hasTickets)
                    {
                        <div class="tb-tkt-table">
                            <div class="tb-tkt-head">
                                <div style="flex:1;">Loại vé</div>
                                <div>Giá</div>
                            </div>
                            @foreach (var tt in evt.TicketTypes.OrderBy(t => t.Price))
                            {
                                var tktClickable = evt.HasSeatMap && tt.AvailableQuantity > 0;
                                <div class="tb-tkt-row @(tktClickable ? "tb-tkt-clickable" : string.Empty)"
                                     onclick="@(tktClickable ? $"location.href='/Events/SelectSeats/{evt.Id}?ticketTypeId={tt.Id}'" : null)"
                                     title="@(tktClickable ? "Click để chọn ghế loại này" : null)">
                                    <div class="tb-tkt-name">@tt.Name
                                        @if (!string.IsNullOrEmpty(tt.Description))
                                        {
                                            <div style="font-size:.74rem;color:rgba(255,255,255,.35);margin-top:2px;">@tt.Description</div>
                                        }
                                    </div>
                                    @if (tt.AvailableQuantity <= 0)
                                    {
                                        <span class="tb-tkt-sold">Hết vé</span>
                                    }
                                    else if (tt.Price == 0)
                                    {
                                        <div class="tb-tkt-price">Miễn phí</div>
                                    }
                                    else
                                    {
                                        <div class="tb-tkt-price">@String.Format("{0:N0} đ", tt.Price)</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p style="color:rgba(255,255,255,.35);font-size:.85rem;margin:0;">Chưa có thông tin vé.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Admin links ── *@
    @if (User.IsInRole("Admin"))
    {
        <div class="tb-admin-strip">
            <a href="/Events/Edit/@evt.Id" class="btn btn-sm btn-outline-secondary">✏️ Chỉnh sửa</a>
            <a href="/Events/SeatMap/@evt.Id" class="btn btn-sm" style="background:rgba(45,194,117,.15);border:1px solid rgba(45,194,117,.4);color:#2DC275;">🗺️ Cấu hình ghế</a>
        </div>
    }

    @* ── Section E: Có thể bạn cũng thích ── *@
    @if (Model.RelatedEvents.Any())
    {
        <div class="tb-rel-section">
            <h2 class="tb-rel-title">Có thể bạn cũng thích</h2>
            <div class="row g-3">
                @foreach (var rel in Model.RelatedEvents)
                {
                    var relMin = rel.TicketTypes.Where(t => t.AvailableQuantity > 0).OrderBy(t => t.Price).FirstOrDefault()?.Price;
                    <div class="col-lg-3 col-md-6 col-12">
                        <a href="/Events/Details/@rel.Id" class="tb-rel-card">
                            @if (!string.IsNullOrEmpty(rel.ImageUrl))
                            {
                                <img class="tb-rel-img" src="@rel.ImageUrl" alt="@rel.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="tb-rel-img-ph">🎟</div>
                            }
                            <div class="tb-rel-body">
                                <div class="tb-rel-name">@rel.Title</div>
                                @if (relMin.HasValue)
                                {
                                    <div class="tb-rel-price">Từ @String.Format("{0:N0} đ", relMin.Value)</div>
                                }
                                else
                                {
                                    <div class="tb-rel-price" style="color:rgba(255,255,255,.3);">Hết vé</div>
                                }
                                <div class="tb-rel-date">
                                    <i class="bi bi-calendar3" style="font-size:.7rem;"></i>
                                    @rel.StartDate.ToLocalTime().ToString("dd") Tháng @rel.StartDate.ToLocalTime().ToString("MM, yyyy")
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }

</div>
</div>

@* ── Buy Modal ── *@
<div class="modal fade tb-modal" id="buyModal" tabindex="-1" aria-labelledby="buyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold text-white" id="buyModalLabel">🎟 Đặt Vé</h5>
                    <p class="text-white small mb-0 opacity-75" id="modalTicketDesc"></p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Buy">
                <div class="modal-body p-4">
                    <input type="hidden" name="eventId" value="@evt.Id" />
                    <input type="hidden" name="ticketTypeId" id="modalTicketTypeId" />

                    <div class="d-flex justify-content-between align-items-center p-3 rounded-3 mb-3 bg-light">
                        <div>
                            <div class="fw-semibold text-white" id="modalTicketName">—</div>
                            <small style="color:rgba(255,255,255,.45);">Giá / vé</small>
                        </div>
                        <div class="fw-bold fs-5" style="color:#2DC275;" id="modalTicketPrice">—</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số lượng vé</label>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-outline-secondary px-3" onclick="changeQty(-1)">−</button>
                            <input type="number" name="qty" id="modalQty"
                                   class="form-control text-center fw-bold fs-5 text-white" style="width:80px;"
                                   value="1" min="1" max="10" readonly />
                            <button type="button" class="btn btn-outline-secondary px-3" onclick="changeQty(1)">+</button>
                            <span style="color:rgba(255,255,255,.4);font-size:.8rem;" id="modalMaxQtyLabel"></span>
                        </div>
                    </div>

                    @* Coupon bar *@
                    <div class="coupon-bar mb-3">
                        <div class="coupon-bar-inner">
                            <span class="coupon-icon">🏷</span>
                            <input type="text" id="buyCouponInput" class="coupon-bar-input"
                                   placeholder="Nhập mã giảm giá..." autocomplete="off" />
                            <button type="button" class="btn-apply-coupon-green" onclick="applyBuyCoupon()">Áp dụng</button>
                        </div>
                        <div id="buyCouponMsg" class="coupon-feedback" style="display:none;"></div>
                    </div>
                    <input type="hidden" name="couponCode" id="buyCouponCode" />

                    <div class="total-summary mb-3">
                        <div class="total-row-item" id="grossRow" style="display:none;">
                            <span>Tạm tính</span>
                            <s class="total-gross-val" id="modalGross"></s>
                        </div>
                        <div class="total-row-item total-discount-item" id="modalDiscountRow" style="display:none;">
                            <span>Giảm</span>
                            <span class="total-discount-val" id="modalDiscountAmt"></span>
                        </div>
                        <div class="total-row-item total-final-item">
                            <span class="total-final-lbl">Thanh toán</span>
                            <span class="total-final-val" id="modalTotal">0đ</span>
                        </div>
                    </div>
                    <hr style="border-color:rgba(255,255,255,.1);" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" name="customerName" class="form-control"
                               value="@(Model.CurrentUser?.HoTen ?? "")" placeholder="Nguyễn Văn A" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                        <input type="email" name="customerEmail" class="form-control"
                               value="@(Model.CurrentUser?.Email ?? "")" placeholder="email@example.com" required />
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-semibold">Số điện thoại</label>
                        <input type="tel" name="customerPhone" class="form-control"
                               value="@(Model.CurrentUser?.PhoneNumber ?? "")" placeholder="0901234567" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 gap-2">
                    <button type="button" class="btn-modal-close" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn-modal-cart" id="btnAddToCart" onclick="addToCartFromModal()">
                        🛒 Thêm vào giỏ
                    </button>
                    <button type="submit" class="btn-modal-pay">Thanh Toán →</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Bootstrap Toast *@
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:9999;">
    <div id="cartToast" class="toast border-0 shadow-lg" role="alert" aria-live="assertive">
        <div class="d-flex align-items-start p-3 gap-3">
            <span style="font-size:1.6rem;line-height:1;">🛒</span>
            <div class="flex-grow-1">
                <div class="fw-semibold mb-1" id="cartToastMsg" style="color:#fff;font-size:.9rem;"></div>
                <a href="/Cart" class="small text-decoration-none fw-semibold" style="color:#2DC275;">Xem giỏ hàng →</a>
            </div>
            <button type="button" class="btn-close btn-close-white opacity-50 flex-shrink-0" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script>
/* ── Bootstrap Icons (lazy) ── */
(function() {
    if (!document.querySelector('link[href*="bootstrap-icons"]')) {
        var l = document.createElement('link');
        l.rel = 'stylesheet';
        l.href = 'https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css';
        document.head.appendChild(l);
    }
})();

/* ── Hero "Mua vé ngay" → scroll tới lịch diễn ── */
var heroBuyBtn = document.getElementById('btn-buy-hero');
if (heroBuyBtn) {
    heroBuyBtn.addEventListener('click', function() {
        document.getElementById('section-schedule').scrollIntoView({ behavior: 'smooth' });
    });
}

/* ── Toggle accordion lịch diễn ── */
function toggleSchedule(id) {
    document.getElementById(id).classList.toggle('open');
}

/* ── Toggle mô tả expand/collapse ── */
var descOpen = false;
function toggleDesc() {
    descOpen = !descOpen;
    var el  = document.getElementById('descText');
    var btn = document.getElementById('descExpandBtn');
    var chev = document.getElementById('descChevron');
    el.classList.toggle('expanded', descOpen);
    if (descOpen) {
        btn.innerHTML = '<i class="bi bi-chevron-up" id="descChevron"></i> Thu gọn';
        var gc = document.getElementById('gcWrap');
        if (gc) gc.style.display = 'block';
    } else {
        btn.innerHTML = '<i class="bi bi-chevron-down" id="descChevron"></i> Xem thêm';
        var gc = document.getElementById('gcWrap');
        if (gc) gc.style.display = 'none';
    }
}

/* ── Buyable tickets ── */
const _buyableTickets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    evt.TicketTypes
       .Where(t => t.AvailableQuantity > 0)
       .OrderBy(t => t.Price)
       .Select(t => new { id = t.Id, name = t.Name, price = (double)t.Price, available = t.AvailableQuantity })
       .ToList()
));

function openFirstTicket() {
    if (_buyableTickets.length === 0) return;
    var t = _buyableTickets[0];
    openBuyModal(t.id, t.name, t.price, t.available);
}

/* ── Buy modal state ── */
let modalPrice = 0, modalMaxQty = 10, modalDiscount = 0, modalEventId = 0, modalTtId = 0;

function openBuyModal(ttId, name, price, maxQty) {
    modalTtId     = ttId;
    modalEventId  = @evt.Id;
    modalPrice    = price;
    modalDiscount = 0;
    modalMaxQty   = Math.min(maxQty, 10);

    document.getElementById('modalTicketTypeId').value      = ttId;
    document.getElementById('modalTicketName').textContent  = name;
    document.getElementById('modalTicketDesc').textContent  = name;
    document.getElementById('modalTicketPrice').textContent = price.toLocaleString('vi-VN') + 'đ';
    document.getElementById('modalMaxQtyLabel').textContent = '(tối đa ' + modalMaxQty + ')';
    document.getElementById('modalQty').max                 = modalMaxQty;
    document.getElementById('modalQty').value               = 1;
    document.getElementById('buyCouponInput').value         = '';
    document.getElementById('buyCouponCode').value          = '';
    resetCouponUI();
    updateTotal();
    new bootstrap.Modal(document.getElementById('buyModal')).show();
}

function resetCouponUI() {
    modalDiscount = 0;
    document.getElementById('buyCouponCode').value          = '';
    var msg = document.getElementById('buyCouponMsg');
    msg.style.display = 'none';
    msg.className     = 'coupon-feedback';
    document.getElementById('grossRow').style.display        = 'none';
    document.getElementById('modalDiscountRow').style.display = 'none';
}

function changeQty(d) {
    var el = document.getElementById('modalQty');
    el.value = Math.min(Math.max(parseInt(el.value) + d, 1), modalMaxQty);
    resetCouponUI();
    updateTotal();
}

function updateTotal() {
    var qty   = parseInt(document.getElementById('modalQty').value) || 1;
    var gross = modalPrice * qty;
    var net   = gross - modalDiscount;
    if (modalDiscount > 0) {
        document.getElementById('grossRow').style.display        = '';
        document.getElementById('modalGross').textContent        = gross.toLocaleString('vi-VN') + 'đ';
        document.getElementById('modalDiscountRow').style.display = '';
        document.getElementById('modalDiscountAmt').textContent  = '−' + modalDiscount.toLocaleString('vi-VN') + 'đ';
    } else {
        document.getElementById('grossRow').style.display        = 'none';
        document.getElementById('modalDiscountRow').style.display = 'none';
    }
    document.getElementById('modalTotal').textContent = net.toLocaleString('vi-VN') + 'đ';
}

document.getElementById('modalQty').addEventListener('input', function() { resetCouponUI(); updateTotal(); });

async function applyBuyCoupon() {
    var code  = document.getElementById('buyCouponInput').value.trim();
    var qty   = parseInt(document.getElementById('modalQty').value) || 1;
    var gross = modalPrice * qty;
    var msg   = document.getElementById('buyCouponMsg');
    if (!code) {
        msg.textContent = '✗ Vui lòng nhập mã giảm giá.';
        msg.className   = 'coupon-feedback err';
        msg.style.display = '';
        return;
    }
    var res  = await fetch('/api/coupons/validate?code=' + encodeURIComponent(code) + '&total=' + gross);
    var data = await res.json();
    if (data.valid) {
        modalDiscount = data.discount;
        document.getElementById('buyCouponCode').value = code;
        msg.textContent = '✓ ' + data.message;
        msg.className   = 'coupon-feedback ok';
    } else {
        modalDiscount = 0;
        document.getElementById('buyCouponCode').value = '';
        msg.textContent = '✗ ' + data.error;
        msg.className   = 'coupon-feedback err';
    }
    msg.style.display = '';
    updateTotal();
}

document.getElementById('buyCouponInput').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); applyBuyCoupon(); }
});

async function addToCartFromModal() {
    var qty = parseInt(document.getElementById('modalQty').value) || 1;
    var btn = document.getElementById('btnAddToCart');
    btn.disabled = true; btn.textContent = '⏳ Đang thêm...';
    try {
        var res  = await fetch('/api/cart/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ eventId: modalEventId, ticketTypeId: modalTtId, qty: qty })
        });
        var data = await res.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('buyModal')).hide();
            showCartToast(data.message);
            updateNavBadge(data.count);
        } else {
            alert(data.message || 'Không thể thêm vào giỏ hàng.');
        }
    } catch { alert('Lỗi kết nối. Vui lòng thử lại.'); }
    finally { btn.disabled = false; btn.textContent = '🛒 Thêm vào giỏ'; }
}

function showCartToast(message) {
    document.getElementById('cartToastMsg').textContent = message;
    new bootstrap.Toast(document.getElementById('cartToast'), { delay: 3500 }).show();
}

function updateNavBadge(count) {
    var badge = document.getElementById('navCartBadge');
    if (badge) {
        badge.textContent = count > 99 ? '99+' : String(count);
        badge.style.display = count > 0 ? '' : 'none';
    } else if (count > 0) {
        var link = document.querySelector('.cart-nav-link');
        if (link) {
            var b = document.createElement('span');
            b.id = 'navCartBadge'; b.className = 'cart-badge';
            b.textContent = count > 99 ? '99+' : String(count);
            link.appendChild(b);
        }
    }
}
</script>

@if (Model.GalleryImages.Any())
{
    var gcJson = System.Text.Json.JsonSerializer.Serialize(
        Model.GalleryImages.Select(i => new { src = i.ImagePath, caption = i.Caption ?? "" }));
    <script>
    var gcImages = @Html.Raw(gcJson);
    var gcIdx = 0;
    function gcMove(delta) { gcIdx = (gcIdx + delta + gcImages.length) % gcImages.length; gcShow(gcIdx); }
    function gcGoto(idx)   { gcIdx = idx; gcShow(idx); }
    function gcShow(idx) {
        var img = document.getElementById('gcImg');
        img.style.opacity = '0';
        setTimeout(function() { img.src = gcImages[idx].src; img.alt = gcImages[idx].caption; img.style.opacity = '1'; }, 150);
        document.getElementById('gcCaption').textContent = gcImages[idx].caption;
        document.querySelectorAll('.gc-dot').forEach(function(d, i) { d.classList.toggle('active', i === idx); });
    }
    (function() {
        var stage = document.querySelector('.gc-stage');
        if (!stage) return;
        var tx = 0;
        stage.addEventListener('touchstart', function(e) { tx = e.changedTouches[0].clientX; }, { passive: true });
        stage.addEventListener('touchend',   function(e) {
            var dx = e.changedTouches[0].clientX - tx;
            if (Math.abs(dx) > 45) gcMove(dx < 0 ? 1 : -1);
        }, { passive: true });
    })();
    </script>
}
}
