@page
@model EventTicketSystem.Web.Pages.Events.CreateEventModel
@{
    ViewData["Title"] = "Tạo Sự Kiện";
}

<div class="container" style="max-width:720px">
    <h1 class="mb-4">Tạo Sự Kiện Mới</h1>

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label fw-bold">Tên Sự Kiện *</label>
            <input asp-for="Input.Title" class="form-control" placeholder="Tên sự kiện" />
            <span asp-validation-for="Input.Title" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Description" class="form-label fw-bold">Mô Tả</label>
            <textarea asp-for="Input.Description" class="form-control" rows="4" placeholder="Giới thiệu về sự kiện"></textarea>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Input.StartDate" class="form-label fw-bold">Ngày Bắt Đầu *</label>
                <input asp-for="Input.StartDate" type="datetime-local" class="form-control" />
                <span asp-validation-for="Input.StartDate" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Input.EndDate" class="form-label fw-bold">Ngày Kết Thúc</label>
                <input asp-for="Input.EndDate" type="datetime-local" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Venue" class="form-label fw-bold">Địa Điểm *</label>
            <input asp-for="Input.Venue" class="form-control" placeholder="Tên địa điểm và địa chỉ" />
            <span asp-validation-for="Input.Venue" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Category" class="form-label fw-bold">Danh Mục</label>
            <input asp-for="Input.Category" class="form-control" placeholder="VD: Âm Nhạc, Thể Thao, Công Nghệ" />
        </div>

        <div class="mb-3">
            <label asp-for="Input.BannerImage" class="form-label fw-bold">Ảnh Banner</label>
            <input asp-for="Input.BannerImage" type="file" class="form-control" accept="image/*" />
            <div class="form-text">Hỗ trợ: JPG, PNG, GIF, WebP. Tỷ lệ khuyến nghị 16:9.</div>
            <span asp-validation-for="Input.BannerImage" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">📸 Ảnh Mô Tả Sự Kiện <span class="text-muted fw-normal small">(tùy chọn)</span></label>
            <input type="file" name="GalleryImages" class="form-control" accept="image/*" multiple />
            <div class="form-text">Chọn nhiều ảnh cùng lúc. JPG, PNG, GIF, WebP.</div>
        </div>

        <hr />
        <h5>Loại Vé</h5>
        <p class="text-muted small">Thêm ít nhất một loại vé cho sự kiện này.</p>

        <div id="ticket-types">
            <div class="ticket-type-row border rounded p-3 mb-3">
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label class="form-label small fw-bold">Tên Loại Vé *</label>
                        <input name="TicketTypes[0].Name" class="form-control" required placeholder="VD: Vé Phổ Thông" />
                    </div>
                    <div class="col-md-2 mb-2">
                        <label class="form-label small fw-bold">Giá (đ) *</label>
                        <input name="TicketTypes[0].Price" type="number" min="0" class="form-control" required placeholder="0" />
                    </div>
                    <div class="col-md-2 mb-2">
                        <label class="form-label small fw-bold">Số Lượng *</label>
                        <input name="TicketTypes[0].TotalQuantity" type="number" min="1" class="form-control" required placeholder="100" value="100" />
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label small fw-bold">Mô Tả</label>
                        <input name="TicketTypes[0].Description" class="form-control" placeholder="Tùy chọn" />
                    </div>
                </div>
            </div>
        </div>

        <button type="button" class="btn btn-outline-secondary btn-sm mb-4" onclick="addTicketType()">+ Thêm Loại Vé</button>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success px-4">Tạo Sự Kiện</button>
            <a href="/Events" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let idx = 1;
        function addTicketType() {
            const container = document.getElementById('ticket-types');
            const row = document.createElement('div');
            row.className = 'ticket-type-row border rounded p-3 mb-3';
            row.innerHTML = `
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label class="form-label small fw-bold">Tên Loại Vé *</label>
                        <input name="TicketTypes[${idx}].Name" class="form-control" required placeholder="VD: Vé VIP" />
                    </div>
                    <div class="col-md-2 mb-2">
                        <label class="form-label small fw-bold">Giá (đ) *</label>
                        <input name="TicketTypes[${idx}].Price" type="number" min="0" class="form-control" required placeholder="0" />
                    </div>
                    <div class="col-md-2 mb-2">
                        <label class="form-label small fw-bold">Số Lượng *</label>
                        <input name="TicketTypes[${idx}].TotalQuantity" type="number" min="1" class="form-control" required placeholder="50" value="50" />
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="form-label small fw-bold">Mô Tả</label>
                        <input name="TicketTypes[${idx}].Description" class="form-control" placeholder="Tùy chọn" />
                    </div>
                    <div class="col-md-1 mb-2 d-flex align-items-end">
                        <button type="button" class="btn btn-danger btn-sm" onclick="this.closest('.ticket-type-row').remove()">✕</button>
                    </div>
                </div>`;
            container.appendChild(row);
            idx++;
        }
    </script>
}
