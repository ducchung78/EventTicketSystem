@page
@model EventTicketSystem.Web.Pages.Contact.ContactIndexModel
@{
    ViewData["Title"] = "Liên Hệ";
}

<style>
    .contact-wrap { padding: 2.5rem 0 4rem; }

    .contact-page-title { font-size: 2rem; font-weight: 800; color: #ede0ff; margin-bottom: .35rem; }
    .contact-page-sub   { color: rgba(210,195,255,.55); font-size: .95rem; margin-bottom: 2rem; }

    /* ── Form card ── */
    .contact-form-card {
        background: rgba(20,10,52,.82);
        border: 1px solid rgba(124,77,255,.28);
        border-radius: 18px;
        backdrop-filter: blur(16px);
        padding: 2rem 2rem 1.75rem;
    }
    .contact-form-card .form-label {
        color: rgba(220,210,255,.85); font-weight: 600; font-size: .85rem; margin-bottom: .3rem;
    }
    .contact-form-card .form-control {
        background: rgba(255,255,255,.05);
        border: 1.5px solid rgba(124,77,255,.25);
        border-radius: 10px; color: #ede0ff; font-size: .92rem;
        transition: border-color .18s, box-shadow .18s;
    }
    .contact-form-card .form-control[readonly] {
        background: rgba(255,255,255,.03);
        color: rgba(210,195,255,.55);
        border-color: rgba(124,77,255,.15);
        cursor: default;
    }
    .contact-form-card .form-control::placeholder { color: rgba(210,195,255,.3); }
    .contact-form-card .form-control:focus:not([readonly]) {
        background: rgba(255,255,255,.07);
        border-color: rgba(0,200,83,.55);
        box-shadow: 0 0 0 3px rgba(0,200,83,.12);
        color: #ede0ff;
    }
    .contact-form-card textarea.form-control { resize: vertical; min-height: 130px; }

    .btn-contact-send {
        width: 100%; background: linear-gradient(90deg,#00c853,#00bcd4);
        border: none; border-radius: 12px; color: #fff;
        font-weight: 700; font-size: 1rem; padding: .82rem;
        box-shadow: 0 4px 18px rgba(0,200,83,.3);
        transition: opacity .2s, transform .15s; cursor: pointer;
    }
    .btn-contact-send:hover { opacity: .88; transform: translateY(-1px); }
    .btn-contact-send:active { transform: translateY(0); }

    /* ── Success ── */
    .contact-success { text-align: center; padding: 2.5rem 1.5rem; }
    .contact-success-icon {
        font-size: 3.5rem; margin-bottom: 1rem; display: block;
        animation: popIn .4s cubic-bezier(.34,1.56,.64,1) both;
    }
    @@keyframes popIn {
        from { transform: scale(.5); opacity: 0; }
        to   { transform: scale(1);  opacity: 1; }
    }
    .contact-success-title { font-size: 1.5rem; font-weight: 800; color: #69f0ae; margin-bottom: .5rem; }
    .contact-success-sub   { color: rgba(210,195,255,.6); font-size: .92rem; }

    /* ── Admin notice ── */
    .contact-admin-notice {
        text-align: center; padding: 2.5rem 1.5rem;
    }
    .contact-admin-icon { font-size: 3rem; margin-bottom: 1rem; display: block; }
    .contact-admin-msg {
        font-size: 1rem; color: rgba(210,195,255,.75);
        margin-bottom: 1.5rem; line-height: 1.6;
    }

    /* ── Info card ── */
    .contact-info-card {
        background: rgba(20,10,52,.82);
        border: 1px solid rgba(124,77,255,.28);
        border-radius: 18px; backdrop-filter: blur(16px);
        padding: 1.8rem 1.75rem; height: 100%;
    }
    .contact-info-title {
        font-size: 1.1rem; font-weight: 800; color: #ede0ff;
        margin-bottom: 1.5rem; padding-bottom: .85rem;
        border-bottom: 1px solid rgba(124,77,255,.18);
    }
    .contact-info-item { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 1.25rem; }
    .contact-info-icon {
        width: 42px; height: 42px; border-radius: 10px; flex-shrink: 0;
        background: rgba(124,77,255,.18); border: 1px solid rgba(124,77,255,.28);
        display: flex; align-items: center; justify-content: center; font-size: 1.15rem;
    }
    .contact-info-text { flex: 1; }
    .contact-info-label {
        font-size: .72rem; font-weight: 700; text-transform: uppercase;
        letter-spacing: .06em; color: rgba(124,77,255,.75); margin-bottom: 2px;
    }
    .contact-info-value { font-size: .9rem; color: rgba(210,195,255,.85); line-height: 1.4; }
    .contact-info-value a { color: #69f0ae; text-decoration: none; font-weight: 600; }
    .contact-info-value a:hover { text-decoration: underline; }

    .contact-hours-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 4px 12px; font-size: .82rem;
    }
    .contact-hours-day  { color: rgba(210,195,255,.55); }
    .contact-hours-time { color: rgba(210,195,255,.85); font-weight: 600; }

    .contact-social-row {
        display: flex; gap: 10px; margin-top: 1.5rem; padding-top: 1.25rem;
        border-top: 1px solid rgba(124,77,255,.18);
    }
    .contact-social-btn {
        flex: 1; padding: 9px; border-radius: 10px; text-align: center;
        font-size: .8rem; font-weight: 700; text-decoration: none;
        border: 1px solid rgba(124,77,255,.3); background: rgba(124,77,255,.1);
        color: rgba(210,195,255,.8); transition: background .15s, border-color .15s;
    }
    .contact-social-btn:hover {
        background: rgba(124,77,255,.22); border-color: rgba(124,77,255,.55); color: #ede0ff;
    }

    .field-validation-error { color: #ef9a9a; font-size: .78rem; margin-top: .25rem; display: block; }
    .contact-form-card .alert-danger { border-radius: 8px; font-size: .85rem; }

    .btn-to-mailbox {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 11px 24px; border-radius: 50px;
        background: linear-gradient(90deg,#7c4dff,#448aff);
        color: #fff; font-weight: 700; font-size: .92rem;
        text-decoration: none; box-shadow: 0 3px 16px rgba(124,77,255,.4);
        transition: opacity .15s;
    }
    .btn-to-mailbox:hover { opacity: .87; color: #fff; }

    /* ── Refund section ── */
    .refund-section { margin-top: 2.5rem; }
    .refund-section-title {
        font-size: 1.35rem; font-weight: 800; color: #ede0ff; margin-bottom: .3rem;
    }
    .refund-section-sub { color: rgba(210,195,255,.5); font-size: .88rem; margin-bottom: 1.25rem; }
    .refund-form-card {
        background: rgba(20,10,52,.82);
        border: 1px solid rgba(124,77,255,.28);
        border-radius: 18px; backdrop-filter: blur(16px);
        padding: 2rem 2rem 1.75rem;
    }
    .refund-form-card .form-label {
        color: rgba(220,210,255,.85); font-weight: 600; font-size: .85rem; margin-bottom: .3rem;
    }
    .refund-form-card .form-control,
    .refund-form-card .form-select {
        background: rgba(255,255,255,.05);
        border: 1.5px solid rgba(124,77,255,.25);
        border-radius: 10px; color: #ede0ff; font-size: .92rem;
        transition: border-color .18s, box-shadow .18s;
    }
    .refund-form-card .form-select option { background: #1a0a40; color: #ede0ff; }
    .refund-form-card .form-control::placeholder { color: rgba(210,195,255,.3); }
    .refund-form-card .form-control:focus,
    .refund-form-card .form-select:focus {
        background: rgba(255,255,255,.07);
        border-color: rgba(255,167,38,.55);
        box-shadow: 0 0 0 3px rgba(255,167,38,.12);
        color: #ede0ff;
    }
    .refund-form-card textarea.form-control { resize: vertical; min-height: 100px; }
    .btn-refund-send {
        width: 100%; background: linear-gradient(90deg,#ff6d00,#ffa726);
        border: none; border-radius: 12px; color: #fff;
        font-weight: 700; font-size: 1rem; padding: .82rem;
        box-shadow: 0 4px 18px rgba(255,109,0,.3);
        transition: opacity .2s, transform .15s; cursor: pointer;
    }
    .btn-refund-send:hover { opacity: .88; transform: translateY(-1px); }

    .refund-success { text-align: center; padding: 2rem 1.5rem; }
    .refund-success-icon { font-size: 3rem; margin-bottom: .75rem; display: block; animation: popIn .4s cubic-bezier(.34,1.56,.64,1) both; }
    .refund-success-title { font-size: 1.3rem; font-weight: 800; margin-bottom: .5rem; }
    .refund-success-sub   { color: rgba(210,195,255,.6); font-size: .9rem; }
    .badge-ai-auto { display:inline-block; background:linear-gradient(90deg,#7c4dff,#448aff); color:#fff; font-size:.78rem; font-weight:700; padding:3px 12px; border-radius:20px; }
</style>

<div class="container-xl px-3 px-md-4 contact-wrap">
    <h1 class="contact-page-title">📬 Liên Hệ Với Chúng Tôi</h1>
    <p class="contact-page-sub">Chúng tôi luôn sẵn sàng lắng nghe và hỗ trợ bạn trong thời gian sớm nhất.</p>

    <div class="row g-4">

        @* ── Left: Form / Status ── *@
        <div class="col-lg-7">
            <div class="contact-form-card">

                @if (Model.IsAdmin)
                {
                    <div class="contact-admin-notice">
                        <span class="contact-admin-icon">🔐</span>
                        <p class="contact-admin-msg">
                            Bạn đang đăng nhập với tài khoản <strong style="color:#ffd740;">Admin</strong>.<br />
                            Vui lòng sử dụng <strong>Hòm Thư Admin</strong> để xem và quản lý tin nhắn từ người dùng.
                        </p>
                        <a href="/Admin/Messages" class="btn-to-mailbox">
                            📬 Vào Hòm Thư Admin
                        </a>
                    </div>
                }
                else if (Model.Sent)
                {
                    <div class="contact-success">
                        <span class="contact-success-icon">✅</span>
                        <div class="contact-success-title">Tin nhắn đã được gửi thành công!</div>
                        <p class="contact-success-sub">
                            Cảm ơn bạn đã liên hệ. Chúng tôi sẽ phản hồi trong vòng 24 giờ làm việc<br />
                            qua email <strong style="color:#ede0ff;">@Model.PrefillEmail</strong>.
                        </p>
                        <a href="/Contact" class="btn-to-mailbox mt-3" style="background:linear-gradient(90deg,#00c853,#00bcd4);box-shadow:0 3px 16px rgba(0,200,83,.35);">
                            ✉️ Gửi tin nhắn khác
                        </a>
                    </div>
                }
                else
                {
                    <h2 class="contact-info-title">Gửi Tin Nhắn</h2>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label">Họ và Tên</label>
                                <input type="text" class="form-control" value="@Model.PrefillName" readonly />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" value="@Model.PrefillEmail" readonly />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="Input.Phone" class="form-label">
                                    Số Điện Thoại
                                    <span style="color:rgba(200,185,255,.4);font-size:.78rem;font-weight:400;">(tùy chọn)</span>
                                </label>
                                <input asp-for="Input.Phone" class="form-control" placeholder="0901234567" autocomplete="tel" />
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Input.Subject" class="form-label">Chủ Đề <span class="text-danger">*</span></label>
                                <input asp-for="Input.Subject" class="form-control" placeholder="Hỏi về đặt vé, hoàn tiền..." />
                                <span asp-validation-for="Input.Subject" class="field-validation-error"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Message" class="form-label">Lời Nhắn <span class="text-danger">*</span></label>
                            <textarea asp-for="Input.Message" class="form-control"
                                      placeholder="Nhập nội dung tin nhắn của bạn..." rows="5"></textarea>
                            <span asp-validation-for="Input.Message" class="field-validation-error"></span>
                        </div>

                        <button type="submit" class="btn-contact-send">✉️ Gửi Tin Nhắn</button>
                    </form>
                }
            </div>
        </div>

        @* ── Right: Contact info ── *@
        <div class="col-lg-5">
            <div class="contact-info-card">
                <div class="contact-info-title">Thông Tin Liên Hệ</div>

                <div class="contact-info-item">
                    <div class="contact-info-icon">📍</div>
                    <div class="contact-info-text">
                        <div class="contact-info-label">Địa Chỉ</div>
                        <div class="contact-info-value">
                            Số nhà 48, Tổ 12, Phường Trung Thành<br />Thành phố Thái Nguyên
                        </div>
                    </div>
                </div>

                <div class="contact-info-item">
                    <div class="contact-info-icon">📧</div>
                    <div class="contact-info-text">
                        <div class="contact-info-label">Email Hỗ Trợ</div>
                        <div class="contact-info-value">
                            <a href="mailto:ducchung782004@gmail.com">ducchung782004@gmail.com</a>
                        </div>
                    </div>
                </div>

                <div class="contact-info-item">
                    <div class="contact-info-icon">📞</div>
                    <div class="contact-info-text">
                        <div class="contact-info-label">Số Điện Thoại</div>
                        <div class="contact-info-value">
                            <a href="tel:0946301374">0946 301 374</a>
                        </div>
                    </div>
                </div>

                <div class="contact-info-item" style="margin-bottom:0;">
                    <div class="contact-info-icon">✈️</div>
                    <div class="contact-info-text">
                        <div class="contact-info-label">Telegram</div>
                        <div class="contact-info-value">
                            <a href="https://t.me/dchung78" target="_blank" rel="noopener">@@dchung78</a>
                        </div>
                    </div>
                </div>

                <div class="contact-social-row">
                    <a href="mailto:ducchung782004@gmail.com" class="contact-social-btn">Email</a>
                    <a href="tel:0946301374" class="contact-social-btn">Gọi điện</a>
                    <a href="https://t.me/dchung78" target="_blank" rel="noopener" class="contact-social-btn">Telegram</a>
                </div>
            </div>
        </div>

    </div>

    @* ── Refund Request section (not shown for Admin) ── *@
    @if (!Model.IsAdmin)
    {
        <div class="refund-section">
            <h2 class="refund-section-title">🔄 Yêu Cầu Hoàn Vé</h2>
            <p class="refund-section-sub">Điền thông tin bên dưới để gửi yêu cầu hoàn vé. Một số trường hợp sẽ được duyệt tự động bởi AI.</p>

            <div class="refund-form-card">
                @if (Model.RefundSent)
                {
                    @if (Model.RefundAutoApproved)
                    {
                        <div class="refund-success">
                            <span class="refund-success-icon">🤖✅</span>
                            <div class="refund-success-title" style="color:#69f0ae;">Yêu cầu đã được duyệt tự động!</div>
                            <p class="refund-success-sub">
                                Hệ thống AI đã phê duyệt yêu cầu hoàn vé của bạn. <span class="badge-ai-auto">🤖 AI Tự Duyệt</span><br />
                                Tiền hoàn sẽ được xử lý trong 3–5 ngày làm việc. Email xác nhận đã được gửi đến hộp thư của bạn.
                            </p>
                            <a href="/Contact" class="btn-to-mailbox mt-3" style="background:linear-gradient(90deg,#00c853,#00bcd4);box-shadow:0 3px 16px rgba(0,200,83,.35);">
                                ✉️ Gửi yêu cầu khác
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="refund-success">
                            <span class="refund-success-icon">📋</span>
                            <div class="refund-success-title" style="color:#ffd740;">Yêu cầu đã được tiếp nhận!</div>
                            <p class="refund-success-sub">
                                Yêu cầu hoàn vé của bạn đang chờ admin xem xét.<br />
                                Chúng tôi sẽ phản hồi qua email trong 1–3 ngày làm việc.
                            </p>
                            <a href="/Contact" class="btn-to-mailbox mt-3">
                                🔄 Gửi yêu cầu khác
                            </a>
                        </div>
                    }
                }
                else
                {
                    var refundErrors = ViewData.ModelState["refund"]?.Errors;
                    if (refundErrors != null && refundErrors.Count > 0)
                    {
                        <div class="alert alert-danger py-2 mb-3 small">
                            @foreach (var e in refundErrors) { <div>⚠️ @e.ErrorMessage</div> }
                        </div>
                    }

                    <form method="post" asp-page-handler="Refund">
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label">Mã Đơn Hàng <span class="text-danger">*</span></label>
                                <input asp-for="RefundInput.ConfirmationCode" class="form-control"
                                       placeholder="VD: AB12CD34" />
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label">Email Đã Đặt Vé <span class="text-danger">*</span></label>
                                <input asp-for="RefundInput.Email" type="email" class="form-control"
                                       placeholder="email@example.com" value="@Model.PrefillEmail" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Lý Do Hoàn Vé <span class="text-danger">*</span></label>
                            <select asp-for="RefundInput.Reason" class="form-select" id="refundReason">
                                <option value="">-- Chọn lý do --</option>
                                <option value="WrongTicket">Mua nhầm vé</option>
                                <option value="ScheduleConflict">Trùng lịch, không thể tham dự</option>
                                <option value="EventChanged">Sự kiện thay đổi thời gian/địa điểm</option>
                                <option value="HealthReason">Lý do sức khỏe</option>
                                <option value="PersonalReason">Lý do cá nhân khác</option>
                                <option value="Other">Khác (ghi rõ bên dưới)</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">
                                Mô Tả Chi Tiết
                                <span id="descRequired" style="color:#ef9a9a;display:none;"> *</span>
                                <span style="color:rgba(200,185,255,.4);font-size:.78rem;font-weight:400;" id="descOptional">(tùy chọn)</span>
                            </label>
                            <textarea asp-for="RefundInput.Description" class="form-control" rows="3"
                                      placeholder="Mô tả thêm về lý do hoàn vé..." id="refundDesc"></textarea>
                        </div>

                        <div class="mb-3 p-3" style="background:rgba(255,167,38,.07);border:1px solid rgba(255,167,38,.2);border-radius:10px;font-size:.82rem;color:rgba(210,195,255,.6);">
                            🤖 <strong style="color:#ffa726;">AI tự duyệt</strong> nếu yêu cầu trong vòng <strong>1 giờ</strong> kể từ khi mua vé. Các trường hợp khác sẽ do admin xét duyệt thủ công trong 1–3 ngày.
                        </div>

                        <button type="submit" class="btn-refund-send">🔄 Gửi Yêu Cầu Hoàn Vé</button>
                    </form>
                }
            </div>
        </div>
    }

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const reasonSel = document.getElementById('refundReason');
        const descReq   = document.getElementById('descRequired');
        const descOpt   = document.getElementById('descOptional');
        const descArea  = document.getElementById('refundDesc');

        function updateDescRequired() {
            const isOther = reasonSel && reasonSel.value === 'Other';
            if (descReq) descReq.style.display = isOther ? 'inline' : 'none';
            if (descOpt) descOpt.style.display  = isOther ? 'none'  : 'inline';
            if (descArea) descArea.required = isOther;
        }
        if (reasonSel) {
            reasonSel.addEventListener('change', updateDescRequired);
            updateDescRequired();
        }

        const codeInput = document.querySelector('input[name="RefundInput.ConfirmationCode"]');
        if (codeInput) codeInput.addEventListener('input', () => {
            const pos = codeInput.selectionStart;
            codeInput.value = codeInput.value.toUpperCase();
            codeInput.setSelectionRange(pos, pos);
        });
    </script>
}
