@page "{id:int}"
@model EventTicketSystem.Web.Pages.Orders.PaymentModel
@{
    ViewData["Title"] = "Thanh Toán";
    var order = Model.Order;
    var item  = order?.OrderItems.FirstOrDefault();
    var tt    = item?.TicketType;
    var evt   = tt?.Event;
    var expiresAtMs = (long)(Model.ExpiresAt - DateTime.UtcNow).TotalMilliseconds;
    if (expiresAtMs < 0) expiresAtMs = 0;

    var transferNote = $"TICKETHUB {order?.ConfirmationCode}";
    var qrText = $"MB Bank|0987654321|CONG TY TICKETHUB|{(long)(order?.TotalAmount ?? 0)}|{transferNote}";
}

@if (order == null)
{
    <div class="container"><div class="alert alert-danger">Không tìm thấy đơn hàng.</div></div>
    return;
}

@* ===== HEADER STRIP ===== *@
<div class="mx-n4 mt-0 py-4" style="background:linear-gradient(90deg,#e91e63,#f44336);">
    <div class="container-fluid px-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-white rounded-circle d-flex align-items-center justify-content-center"
                 style="width:48px;height:48px;flex-shrink:0;">
                <span style="font-size:1.4rem;">🎟</span>
            </div>
            <div>
                <h4 class="text-white fw-bold mb-0">Hoàn Tất Thanh Toán</h4>
                <p class="text-white small mb-0 opacity-75">Mã đơn: #@order.ConfirmationCode</p>
            </div>
            @* Countdown *@
            <div class="ms-auto text-end">
                <div class="text-white small opacity-75">Còn lại</div>
                <div class="text-white fw-bold fs-4 font-monospace" id="countdown">05:00</div>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5 mt-4" style="max-width:900px;">
    @* Progress steps *@
    <div class="d-flex align-items-center justify-content-center gap-2 mb-4 small">
        <span class="badge bg-success rounded-pill px-3 py-2">1 Chọn vé</span>
        <span class="text-muted">──</span>
        <span class="badge rounded-pill px-3 py-2" style="background:#e91e63;">2 Thanh toán</span>
        <span class="text-muted">──</span>
        <span class="badge bg-secondary rounded-pill px-3 py-2">3 Xác nhận</span>
    </div>

    <div class="row g-4">
        @* LEFT: QR + Bank info *@
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="card-header border-0 py-3 fw-semibold" style="background:#f8f9fa;">
                    🏦 Chuyển Khoản Ngân Hàng
                </div>
                <div class="card-body p-4">
                    @* QR code *@
                    <div class="text-center mb-4">
                        <div id="qrcode" class="d-inline-block p-3 border rounded-3 bg-white"></div>
                        <p class="text-muted small mt-2 mb-0">Quét mã QR để chuyển khoản</p>
                    </div>

                    @* Bank details *@
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background:#f8f9fa;">
                            <div>
                                <div class="text-muted small">Ngân hàng</div>
                                <div class="fw-bold">MB Bank</div>
                            </div>
                            <img src="https://upload.wikimedia.org/wikipedia/commons/2/20/MB_Bank_logo_%282016%29.svg"
                                 alt="MB Bank" style="height:28px; opacity:.85;" onerror="this.style.display='none'" />
                        </div>

                        <div class="p-3 rounded-3" style="background:#f8f9fa;">
                            <div class="text-muted small mb-1">Số tài khoản</div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold font-monospace fs-5" id="bankAccount">0987654321</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        onclick="copyText('0987654321', this)">Sao chép</button>
                            </div>
                        </div>

                        <div class="p-3 rounded-3" style="background:#f8f9fa;">
                            <div class="text-muted small mb-1">Chủ tài khoản</div>
                            <div class="fw-bold">CONG TY TICKETHUB</div>
                        </div>

                        <div class="p-3 rounded-3 border" style="background:#fff5f5; border-color:#ffcdd2 !important;">
                            <div class="text-muted small mb-1">Số tiền</div>
                            <div class="fw-bold text-danger fs-4">@order.TotalAmount.ToString("N0")đ</div>
                        </div>

                        <div class="p-3 rounded-3" style="background:#f8f9fa;">
                            <div class="text-muted small mb-1">Nội dung chuyển khoản</div>
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <span class="fw-bold font-monospace" id="transferNote">@transferNote</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary flex-shrink-0"
                                        onclick="copyText('@transferNote', this)">Sao chép</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* RIGHT: Order summary + actions *@
        <div class="col-lg-6">
            @* Order summary *@
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header border-0 py-3 fw-semibold" style="background:#f8f9fa;">
                    📋 Tóm Tắt Đơn Hàng
                </div>
                <div class="card-body p-4">
                    @if (evt != null)
                    {
                        <div class="d-flex gap-3 mb-3">
                            @if (!string.IsNullOrEmpty(evt.ImageUrl))
                            {
                                <img src="@evt.ImageUrl" alt="@evt.Title"
                                     class="rounded-3 flex-shrink-0"
                                     style="width:64px;height:64px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="rounded-3 flex-shrink-0 d-flex align-items-center justify-content-center"
                                     style="width:64px;height:64px;background:linear-gradient(135deg,#e91e63,#f44336);">
                                    <span style="font-size:1.5rem;">🎟</span>
                                </div>
                            }
                            <div>
                                <div class="fw-bold">@evt.Title</div>
                                <div class="text-muted small">📅 @evt.StartDate.ToLocalTime().ToString("dd/MM/yyyy · HH:mm")</div>
                                <div class="text-muted small">📍 @evt.Venue</div>
                            </div>
                        </div>
                    }

                    <hr class="my-3" />

                    @if (item != null && tt != null)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Loại vé</span>
                            <span class="fw-semibold">@tt.Name</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Đơn giá</span>
                            <span>@item.UnitPrice.ToString("N0")đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Số lượng</span>
                            <span>×@item.Quantity</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between p-3 rounded-3"
                         style="background:#fff5f5; border:1px solid #ffcdd2;">
                        <span class="fw-bold">Tổng cộng</span>
                        <span class="fw-bold text-danger fs-5">@order.TotalAmount.ToString("N0")đ</span>
                    </div>

                    <div class="mt-3">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Khách hàng</span>
                            <span>@order.CustomerName</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Email</span>
                            <span>@order.CustomerEmail</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Instructions *@
            <div class="alert alert-warning border-0 rounded-3 small mb-4">
                <strong>Lưu ý:</strong> Vui lòng chuyển khoản <strong>đúng số tiền</strong> và <strong>đúng nội dung</strong>
                để đơn hàng được xác nhận tự động. Đơn hàng sẽ bị hủy sau <strong>5 phút</strong> nếu chưa thanh toán.
            </div>

            @* Action buttons *@
            <div class="d-grid gap-2">
                <form method="post" asp-page-handler="Confirm">
                    <input type="hidden" name="id" value="@order.Id" />
                    <button type="submit" class="btn btn-success w-100 py-3 fw-bold fs-5">
                        ✅ Tôi Đã Thanh Toán
                    </button>
                </form>
                <form method="post" asp-page-handler="Cancel" id="cancelForm">
                    <input type="hidden" name="id" value="@order.Id" />
                    <button type="submit" class="btn btn-outline-danger w-100 py-2"
                            onclick="return confirm('Bạn có chắc muốn hủy đơn hàng này?')">
                        Hủy Đơn Hàng
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"
        integrity="sha512-CNgIRecGo7nphbeZ04Sc13ka07paqdeTu0WR1IM4kNcpmBAUSHSi2jPQSCeQvc7pyRGmjIXdFe4L4CPibMuf1A=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>
// ── QR Code ──
new QRCode(document.getElementById('qrcode'), {
    text: '@Html.Raw(qrText)',
    width: 180,
    height: 180,
    colorDark: '#000000',
    colorLight: '#ffffff',
    correctLevel: QRCode.CorrectLevel.M
});

// ── Countdown ──
let remaining = Math.floor(@expiresAtMs / 1000);
const countdownEl = document.getElementById('countdown');

function tick() {
    if (remaining <= 0) {
        countdownEl.textContent = '00:00';
        countdownEl.classList.add('text-warning');
        document.getElementById('cancelForm').submit();
        return;
    }
    const m = Math.floor(remaining / 60).toString().padStart(2, '0');
    const s = (remaining % 60).toString().padStart(2, '0');
    countdownEl.textContent = m + ':' + s;
    if (remaining <= 60) countdownEl.classList.add('text-warning');
    remaining--;
    setTimeout(tick, 1000);
}

tick();

// ── Copy to clipboard ──
function copyText(text, btn) {
    navigator.clipboard.writeText(text).then(() => {
        const orig = btn.textContent;
        btn.textContent = 'Đã sao chép!';
        btn.classList.replace('btn-outline-secondary', 'btn-success');
        setTimeout(() => {
            btn.textContent = orig;
            btn.classList.replace('btn-success', 'btn-outline-secondary');
        }, 2000);
    });
}
</script>
}
