@page "{id:int}"
@model EventTicketSystem.Web.Pages.Orders.OrderDetailsModel
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
}

@if (Model.Order == null)
{
    <div class="container">
        <div class="alert alert-danger">Không tìm thấy đơn hàng.</div>
        <a href="/Orders" class="btn btn-secondary">Quay Lại</a>
    </div>
    return;
}

<div class="container" style="max-width:700px">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            @if (User.IsInRole("Admin"))
            {
                <li class="breadcrumb-item"><a href="/Orders">Tất Cả Đơn Hàng</a></li>
            }
            else
            {
                <li class="breadcrumb-item"><a href="/Orders/MyOrders">Vé Của Tôi</a></li>
            }
            <li class="breadcrumb-item active">Đơn #@Model.Order.Id</li>
        </ol>
    </nav>

    <div class="card shadow mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Đơn Hàng #@Model.Order.Id</h5>
            <span class="badge fs-6 @Model.Order.Status.ToBadgeClass()">
                @Model.Order.Status.ToVietnamese()
            </span>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-sm-4 text-muted">Mã Xác Nhận</div>
                <div class="col-sm-8"><code class="fs-5">@Model.Order.ConfirmationCode</code></div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-4 text-muted">Khách Hàng</div>
                <div class="col-sm-8">@Model.Order.CustomerName</div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-4 text-muted">Email</div>
                <div class="col-sm-8">@Model.Order.CustomerEmail</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Order.CustomerPhone))
            {
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Điện Thoại</div>
                    <div class="col-sm-8">@Model.Order.CustomerPhone</div>
                </div>
            }
            <div class="row mb-3">
                <div class="col-sm-4 text-muted">Ngày Đặt</div>
                <div class="col-sm-8">@Model.Order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header"><h6 class="mb-0">Danh Sách Vé</h6></div>
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Sự Kiện</th>
                        <th>Loại Vé</th>
                        <th class="text-center">SL</th>
                        <th class="text-end">Đơn Giá</th>
                        <th class="text-end">Thành Tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Order.OrderItems)
                    {
                        <tr>
                            <td>@item.TicketType.Event.Title</td>
                            <td>@item.TicketType.Name</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@item.UnitPrice.ToString("N0") đ</td>
                            <td class="text-end">@item.Subtotal.ToString("N0") đ</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="4" class="text-end fw-bold">Tổng Cộng</td>
                        <td class="text-end fw-bold fs-5">@Model.Order.TotalAmount.ToString("N0") đ</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    @if (Model.Order.Status == EventTicketSystem.Web.Models.OrderStatus.Confirmed)
    {
        <form method="post" asp-page-handler="Cancel" onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này không?')">
            <button type="submit" class="btn btn-outline-danger">Hủy Đơn Hàng</button>
        </form>
    }
</div>
