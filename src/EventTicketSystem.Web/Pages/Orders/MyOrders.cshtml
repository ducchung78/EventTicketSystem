@page
@model EventTicketSystem.Web.Pages.Orders.MyOrdersModel
@{
    ViewData["Title"] = "Vé Của Tôi";
}

<div class="container">
    @* Header row with title + quick search *@
    <div class="row align-items-center mb-4 g-3">
        <div class="col">
            <h1 class="mb-0">Vé Của Tôi</h1>
        </div>
        <div class="col-lg-auto">
            <form method="get" action="/tra-cuu-don-hang" class="d-flex gap-2">
                <input name="code"
                       class="form-control"
                       placeholder="Nhập mã xác nhận..."
                       autocomplete="off"
                       maxlength="20"
                       style="min-width:190px;text-transform:uppercase;letter-spacing:.06em;font-weight:600;" />
                <button type="submit" class="btn btn-outline-primary text-nowrap">🔍 Tra cứu</button>
            </form>
            <div class="text-muted small mt-1">
                Tìm đơn đặt ẩn danh bằng mã xác nhận + email
            </div>
        </div>
    </div>

    @if (!Model.Orders.Any())
    {
        <div class="text-center py-5">
            <div class="display-4 text-muted mb-3">🎟</div>
            <p class="fs-5 text-muted">Bạn chưa có vé nào.</p>
            <a href="/Events" class="btn btn-primary mt-2">Khám Phá Sự Kiện</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Mã Xác Nhận</th>
                        <th>Sự Kiện</th>
                        <th>Ngày Đặt</th>
                        <th class="text-center">Số Vé</th>
                        <th class="text-end">Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        var eventTitle = order.OrderItems.FirstOrDefault()?.TicketType?.Event?.Title ?? "—";
                        <tr>
                            <td><code class="fs-6">@order.ConfirmationCode</code></td>
                            <td class="text-truncate" style="max-width:200px;" title="@eventTitle">@eventTitle</td>
                            <td>@order.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">@order.OrderItems.Sum(i => i.Quantity)</td>
                            <td class="text-end fw-bold">@order.TotalAmount.ToString("N0") đ</td>
                            <td>
                                <span class="badge @order.Status.ToBadgeClass()">
                                    @order.Status.ToVietnamese()
                                </span>
                            </td>
                            <td>
                                <a href="/Orders/Details/@order.Id" class="btn btn-sm btn-outline-primary">
                                    Chi Tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small">Tổng cộng: @Model.Orders.Count đơn hàng</p>
    }
</div>
