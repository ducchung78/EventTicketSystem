@page
@model EventTicketSystem.Web.Pages.Admin.AISettings.AISettingsModel
@{
    ViewData["Title"] = "Cấu Hình AI";
    var cfg = Model.Config;
}

<style>
    .ais-wrap { padding: 2rem 0 3rem; }
    .ais-title { font-size:1.45rem; font-weight:800; color:#ede0ff; margin-bottom:.25rem; }
    .ais-sub   { color:rgba(210,195,255,.45); font-size:.88rem; margin-bottom:1.75rem; }

    .ais-card {
        background:rgba(20,10,52,.82); border:1px solid rgba(124,77,255,.25);
        border-radius:16px; margin-bottom:1.5rem; overflow:hidden;
    }
    .ais-card-hdr {
        padding:13px 20px; border-bottom:1px solid rgba(124,77,255,.15);
        font-size:.88rem; font-weight:700; color:rgba(124,77,255,.8);
        text-transform:uppercase; letter-spacing:.06em;
    }
    .ais-card-body { padding:1.5rem 1.75rem; }

    /* Metric tiles */
    .metric-tiles { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:1.25rem; }
    .metric-tile {
        background:rgba(10,4,30,.55); border:1px solid rgba(124,77,255,.18);
        border-radius:12px; padding:14px 18px; min-width:140px; text-align:center;
    }
    .metric-num  { font-size:1.6rem; font-weight:800; line-height:1; margin-bottom:4px; }
    .metric-lbl  { font-size:.68rem; color:rgba(210,195,255,.4); text-transform:uppercase; letter-spacing:.06em; }
    .metric-sub  { font-size:.72rem; color:rgba(210,195,255,.35); margin-top:3px; }

    /* Retrain button + progress */
    .btn-retrain {
        background:linear-gradient(90deg,#7c4dff,#448aff); border:none; border-radius:11px;
        color:#fff; font-weight:700; font-size:.92rem; padding:10px 28px;
        cursor:pointer; box-shadow:0 3px 14px rgba(124,77,255,.35); transition:opacity .15s;
    }
    .btn-retrain:hover:not(:disabled) { opacity:.88; }
    .btn-retrain:disabled { opacity:.45; cursor:not-allowed; }

    .progress-section { margin-top:1.25rem; display:none; }
    .progress-bar-wrap { height:8px; background:rgba(255,255,255,.08); border-radius:4px; overflow:hidden; margin-bottom:.5rem; }
    .progress-bar-fill { height:100%; border-radius:4px; background:linear-gradient(90deg,#7c4dff,#00c853); transition:width .4s; }
    .progress-msg { font-size:.82rem; color:rgba(210,195,255,.6); }

    .result-box {
        margin-top:1rem; padding:14px 18px; border-radius:12px; font-size:.85rem; display:none;
    }
    .result-improved { background:rgba(0,200,83,.08); border:1px solid rgba(0,200,83,.25); color:#69f0ae; }
    .result-worse    { background:rgba(255,167,38,.08); border:1px solid rgba(255,167,38,.25); color:#ffa726; }
    .result-error    { background:rgba(229,57,53,.08); border:1px solid rgba(229,57,53,.25); color:#ef9a9a; }

    /* Config form */
    .ais-field { margin-bottom:1.25rem; }
    .ais-label { font-size:.82rem; font-weight:600; color:rgba(210,195,255,.75); margin-bottom:.35rem; display:block; }
    .ais-hint  { font-size:.72rem; color:rgba(210,195,255,.35); margin-top:.2rem; }
    .ais-input {
        background:rgba(255,255,255,.05); border:1.5px solid rgba(124,77,255,.25);
        border-radius:10px; color:#ede0ff; font-size:.92rem; padding:8px 13px;
        width:100%; box-sizing:border-box; transition:border-color .18s;
    }
    .ais-input:focus { outline:none; border-color:rgba(124,77,255,.55); box-shadow:0 0 0 3px rgba(124,77,255,.12); }
    .ais-input-row { display:flex; gap:10px; align-items:center; }
    .ais-input-row .ais-input { flex:1; }
    .ais-unit { font-size:.8rem; color:rgba(210,195,255,.4); white-space:nowrap; }

    .field-err { color:#ef9a9a; font-size:.78rem; margin-top:.25rem; display:block; }

    .btn-save {
        background:linear-gradient(90deg,#00c853,#00bcd4); border:none; border-radius:11px;
        color:#fff; font-weight:700; font-size:.92rem; padding:10px 32px;
        cursor:pointer; box-shadow:0 3px 14px rgba(0,200,83,.3); transition:opacity .15s;
    }
    .btn-save:hover { opacity:.88; }

    .alert-ok  { background:rgba(0,200,83,.1); border:1px solid rgba(0,200,83,.25); border-radius:10px; padding:10px 16px; color:#69f0ae; font-size:.88rem; margin-bottom:1.25rem; }
    .alert-err { background:rgba(229,57,53,.1); border:1px solid rgba(229,57,53,.25); border-radius:10px; padding:10px 16px; color:#ef9a9a; font-size:.88rem; margin-bottom:1.25rem; }

    .last-trained { font-size:.8rem; color:rgba(210,195,255,.4); margin-top:.5rem; }
</style>

<div class="container-xl px-3 px-md-4 ais-wrap">
    <div class="ais-title">⚙️ Cấu Hình AI</div>
    <div class="ais-sub">Điều chỉnh tham số mô hình dự báo và chính sách hoàn vé tự động</div>

    @if (TempData["Success"] is string ok)  { <div class="alert-ok">✅ @ok</div> }
    @if (TempData["Error"]   is string err) { <div class="alert-err">⚠️ @err</div> }

    @* ── Section 1: Model Status + Retrain ── *@
    <div class="ais-card">
        <div class="ais-card-hdr">🤖 Trạng Thái Mô Hình</div>
        <div class="ais-card-body">

            <div class="metric-tiles">
                <div class="metric-tile">
                    <div class="metric-num" style="color:#69f0ae;">@Model.RealSamples</div>
                    <div class="metric-lbl">Mẫu thực tế</div>
                    <div class="metric-sub">TicketType có dữ liệu bán</div>
                </div>
                <div class="metric-tile">
                    <div class="metric-num" style="color:#b388ff;">@Model.TotalSamples</div>
                    <div class="metric-lbl">Tổng mẫu training</div>
                    <div class="metric-sub">Bao gồm mẫu tổng hợp</div>
                </div>
                <div class="metric-tile" id="tileMAE">
                    <div class="metric-num" style="color:#ffd740;">@(cfg.LastModelMAE?.ToString("F2") ?? "—")</div>
                    <div class="metric-lbl">MAE</div>
                    <div class="metric-sub">Sai số trung bình</div>
                </div>
                <div class="metric-tile" id="tileRMSE">
                    <div class="metric-num" style="color:#ef9a9a;">@(cfg.LastModelRMSE?.ToString("F2") ?? "—")</div>
                    <div class="metric-lbl">RMSE</div>
                </div>
                <div class="metric-tile" id="tileR2">
                    <div class="metric-num" style="color:#448aff;">@(cfg.LastModelR2?.ToString("F3") ?? "—")</div>
                    <div class="metric-lbl">R²</div>
                    <div class="metric-sub">Độ chính xác</div>
                </div>
            </div>

            @if (cfg.LastTrainedAt.HasValue)
            {
                <div class="last-trained">🕐 Lần huấn luyện gần nhất: @cfg.LastTrainedAt.Value.ToLocalTime().ToString("HH:mm – dd/MM/yyyy")</div>
            }

            <div class="mt-3">
                <button id="retrainBtn" class="btn-retrain" onclick="startRetrain()">
                    🔄 Huấn Luyện Lại Mô Hình
                </button>
            </div>

            <div class="progress-section" id="progressSection">
                <div class="progress-bar-wrap">
                    <div class="progress-bar-fill" id="progressFill" style="width:10%;"></div>
                </div>
                <div class="progress-msg" id="progressMsg">Đang huấn luyện mô hình...</div>
            </div>

            <div class="result-box" id="resultBox"></div>
        </div>
    </div>

    @* ── Section 2: Config Parameters ── *@
    <div class="ais-card">
        <div class="ais-card-hdr">🛠 Điều Chỉnh Tham Số</div>
        <div class="ais-card-body">
            <form method="post" asp-page-handler="Save">
                <div class="row g-3">

                    @* Refund threshold *@
                    <div class="col-md-6">
                        <div class="ais-field">
                            <label class="ais-label">⏱ Ngưỡng hoàn vé tự động</label>
                            <div class="ais-input-row">
                                <input asp-for="Input.AutoRefundThresholdMinutes" type="number"
                                       class="ais-input" min="5" max="1440" />
                                <span class="ais-unit">phút</span>
                            </div>
                            <div class="ais-hint">Đơn mua trong khoảng này sẽ được hoàn tự động. Phạm vi: 5–1440 phút.</div>
                            <span asp-validation-for="Input.AutoRefundThresholdMinutes" class="field-err"></span>
                        </div>
                    </div>

                    @* Min samples *@
                    <div class="col-md-6">
                        <div class="ais-field">
                            <label class="ais-label">📊 Số mẫu tối thiểu để training</label>
                            <div class="ais-input-row">
                                <input asp-for="Input.MinTrainingSamples" type="number"
                                       class="ais-input" min="10" max="2000" />
                                <span class="ais-unit">mẫu</span>
                            </div>
                            <div class="ais-hint">Nếu ít hơn, hệ thống tự tổng hợp thêm. Phạm vi: 10–2000.</div>
                            <span asp-validation-for="Input.MinTrainingSamples" class="field-err"></span>
                        </div>
                    </div>

                    @* Iterations *@
                    <div class="col-md-4">
                        <div class="ais-field">
                            <label class="ais-label">🔁 Số vòng lặp SDCA</label>
                            <input asp-for="Input.Iterations" type="number"
                                   class="ais-input" min="10" max="1000" />
                            <div class="ais-hint">Phạm vi: 10–1000. Cao hơn = chậm hơn nhưng chính xác hơn.</div>
                            <span asp-validation-for="Input.Iterations" class="field-err"></span>
                        </div>
                    </div>

                    @* L1 *@
                    <div class="col-md-4">
                        <div class="ais-field">
                            <label class="ais-label">L1 Regularization</label>
                            <input asp-for="Input.L1Regularization" type="number" step="0.01"
                                   class="ais-input" min="0" max="1" />
                            <div class="ais-hint">Sparse model. 0 = tắt, phạm vi: 0–1.</div>
                            <span asp-validation-for="Input.L1Regularization" class="field-err"></span>
                        </div>
                    </div>

                    @* L2 *@
                    <div class="col-md-4">
                        <div class="ais-field">
                            <label class="ais-label">L2 Regularization</label>
                            <input asp-for="Input.L2Regularization" type="number" step="0.01"
                                   class="ais-input" min="0" max="1" />
                            <div class="ais-hint">Weight decay. 0 = tắt, mặc định: 0.1.</div>
                            <span asp-validation-for="Input.L2Regularization" class="field-err"></span>
                        </div>
                    </div>

                </div>

                <div class="mt-3">
                    <button type="submit" class="btn-save">💾 Lưu Cấu Hình</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    let pollInterval = null;
    let progressPct  = 10;

    async function startRetrain() {
        const btn = document.getElementById('retrainBtn');
        btn.disabled = true;
        btn.textContent = '⏳ Đang khởi động...';
        document.getElementById('progressSection').style.display = 'block';
        document.getElementById('resultBox').style.display = 'none';
        progressPct = 10;
        updateProgress(progressPct, 'Đang chuẩn bị dữ liệu huấn luyện...');

        try {
            const res = await fetch('/api/ai/retrain', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            if (!res.ok) throw new Error(await res.text());
            const { jobId } = await res.json();
            startPolling(jobId);
        } catch (e) {
            showResult('error', '❌ Lỗi khi khởi động: ' + e.message);
            resetBtn();
        }
    }

    function startPolling(jobId) {
        pollInterval = setInterval(async () => {
            progressPct = Math.min(progressPct + 8, 90);
            updateProgress(progressPct, 'Đang huấn luyện mô hình SDCA...');

            try {
                const res  = await fetch('/api/ai/retrain-status/' + jobId);
                const data = await res.json();

                if (data.status === 'completed') {
                    clearInterval(pollInterval);
                    updateProgress(100, 'Hoàn tất!');

                    // Update metric tiles in-place
                    updateTile('tileMAE',  data.mae?.toFixed(2)  ?? '—');
                    updateTile('tileRMSE', data.rmse?.toFixed(2) ?? '—');
                    updateTile('tileR2',   data.r2?.toFixed(3)   ?? '—');

                    if (data.improved === true) {
                        showResult('improved',
                            `✅ Mô hình cải thiện! MAE: ${data.mae?.toFixed(2)} (trước: ${data.previousMae?.toFixed(2)})`);
                    } else if (data.improved === false) {
                        showResult('worse',
                            `⚠️ Mô hình kém hơn. MAE: ${data.mae?.toFixed(2)} (trước: ${data.previousMae?.toFixed(2)}). Bạn có thể điều chỉnh tham số và thử lại.`);
                    } else {
                        showResult('improved', `✅ Huấn luyện hoàn tất. MAE: ${data.mae?.toFixed(2)}, R²: ${data.r2?.toFixed(3)}`);
                    }
                    resetBtn('✅ Huấn luyện thành công');

                } else if (data.status === 'failed') {
                    clearInterval(pollInterval);
                    showResult('error', '❌ Huấn luyện thất bại: ' + (data.error ?? 'Lỗi không xác định'));
                    resetBtn();
                }
            } catch { /* keep polling */ }
        }, 1800);
    }

    function updateProgress(pct, msg) {
        document.getElementById('progressFill').style.width = pct + '%';
        document.getElementById('progressMsg').textContent   = msg;
    }

    function updateTile(id, val) {
        const el = document.querySelector(`#${id} .metric-num`);
        if (el) el.textContent = val;
    }

    function showResult(type, msg) {
        const box = document.getElementById('resultBox');
        box.className = 'result-box result-' + type;
        box.textContent = msg;
        box.style.display = 'block';
    }

    function resetBtn(label) {
        const btn = document.getElementById('retrainBtn');
        btn.disabled = false;
        btn.textContent = label ?? '🔄 Huấn Luyện Lại Mô Hình';
    }
    </script>
}
