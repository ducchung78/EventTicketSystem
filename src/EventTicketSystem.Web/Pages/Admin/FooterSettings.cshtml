@page
@model EventTicketSystem.Web.Pages.Admin.FooterSettingsModel
@{
    ViewData["Title"] = "Cài đặt Footer";
}

<div class="container py-4" style="max-width:640px;">
    <h2 class="mb-4" style="color:#fff; font-weight:700;">⚙️ Cài đặt Footer</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert mb-4" style="background:#0d2b18; border:1px solid #00C853; color:#00C853; border-radius:6px;">
            ✅ @TempData["Success"]
        </div>
    }

    <form method="post">
        <div class="mb-4 p-4" style="background:#1c1c1c; border:1px solid #2a2a2a; border-radius:8px;">
            <h6 style="color:#888; font-size:.78rem; text-transform:uppercase; letter-spacing:.08em; margin-bottom:1.2rem;">
                Thông tin liên hệ
            </h6>

            <div class="mb-3">
                <label asp-for="Settings.Hotline" class="form-label" style="color:#ccc; font-size:.88rem;">Hotline</label>
                <input asp-for="Settings.Hotline" class="form-control" style="background:#2a2a2a; border-color:#3a3a3a; color:#fff;" />
            </div>
            <div class="mb-3">
                <label asp-for="Settings.SupportHours" class="form-label" style="color:#ccc; font-size:.88rem;">Giờ hỗ trợ</label>
                <input asp-for="Settings.SupportHours" class="form-control" style="background:#2a2a2a; border-color:#3a3a3a; color:#fff;" />
            </div>
            <div class="mb-3">
                <label asp-for="Settings.Email" class="form-label" style="color:#ccc; font-size:.88rem;">Email</label>
                <input asp-for="Settings.Email" class="form-control" style="background:#2a2a2a; border-color:#3a3a3a; color:#fff;" />
            </div>
            <div class="mb-0">
                <label asp-for="Settings.Address" class="form-label" style="color:#ccc; font-size:.88rem;">Địa chỉ</label>
                <input asp-for="Settings.Address" class="form-control" style="background:#2a2a2a; border-color:#3a3a3a; color:#fff;" />
            </div>
        </div>

        <div class="mb-4 p-4" style="background:#1c1c1c; border:1px solid #2a2a2a; border-radius:8px;">
            <h6 style="color:#888; font-size:.78rem; text-transform:uppercase; letter-spacing:.08em; margin-bottom:1.2rem;">
                Thông tin pháp lý
            </h6>

            <div class="mb-3">
                <label asp-for="Settings.BusinessLicense" class="form-label" style="color:#ccc; font-size:.88rem;">Số giấy phép ĐKKD</label>
                <input asp-for="Settings.BusinessLicense" class="form-control" style="background:#2a2a2a; border-color:#3a3a3a; color:#fff;" />
            </div>
            <div class="mb-3">
                <label asp-for="Settings.LicenseDate" class="form-label" style="color:#ccc; font-size:.88rem;">Ngày cấp</label>
                <input asp-for="Settings.LicenseDate" class="form-control" style="background:#2a2a2a; border-color:#3a3a3a; color:#fff;" placeholder="vd: 01/01/2024" />
            </div>
            <div class="mb-0">
                <label asp-for="Settings.LicensePlace" class="form-label" style="color:#ccc; font-size:.88rem;">Nơi cấp</label>
                <input asp-for="Settings.LicensePlace" class="form-control" style="background:#2a2a2a; border-color:#3a3a3a; color:#fff;" />
            </div>
        </div>

        <button type="submit" class="btn w-100 fw-700"
                style="background:#00C853; color:#111; font-weight:700; padding:.75rem; border-radius:6px; font-size:.95rem;">
            💾 Lưu Cài Đặt
        </button>
    </form>
</div>
