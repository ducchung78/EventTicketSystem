@page
@model EventTicketSystem.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Đăng Ký";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<style>
    .tb-login-wrap {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 2.5rem 1rem 3rem;
        min-height: calc(100vh - 120px);
    }

    .tb-login-card {
        width: 100%;
        max-width: 440px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 8px 40px rgba(0,0,0,.18), 0 2px 8px rgba(0,0,0,.08);
        overflow: hidden;
        position: relative;
    }

    .tb-card-header {
        background: #00c853;
        padding: 1.45rem 1.5rem 2.2rem;
        position: relative;
        overflow: hidden;
    }
    .tb-card-header::after {
        content: '';
        position: absolute;
        bottom: -24px; left: -5%; right: -5%;
        height: 48px;
        background: #fff;
        border-radius: 50%;
    }

    .tb-header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: .5rem;
    }
    .tb-logo-text {
        color: #fff;
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: -.5px;
        line-height: 1;
    }
    .tb-header-right {
        display: flex;
        align-items: center;
        gap: .75rem;
    }
    .tb-mascot {
        font-size: 2rem;
        line-height: 1;
        filter: drop-shadow(0 2px 6px rgba(0,0,0,.18));
    }
    .tb-close-btn {
        width: 28px; height: 28px;
        border-radius: 50%;
        background: rgba(255,255,255,.25);
        border: none;
        color: #fff;
        font-size: 1rem;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        text-decoration: none;
        transition: background .15s;
        padding: 0;
        line-height: 1;
    }
    .tb-close-btn:hover { background: rgba(255,255,255,.4); color: #fff; }

    .tb-header-title {
        color: #fff;
        font-size: 1.5rem;
        font-weight: 800;
        margin: 0 0 .15rem;
    }
    .tb-header-sub {
        color: rgba(255,255,255,.85);
        font-size: .88rem;
        margin: 0;
    }

    .tb-card-body {
        padding: 2rem 1.75rem 1.5rem;
    }

    .tb-field-label {
        display: block;
        color: #555;
        font-size: .85rem;
        font-weight: 600;
        margin-bottom: .3rem;
    }
    .tb-field-label .tb-optional {
        color: #bbb;
        font-size: .78rem;
        font-weight: 400;
    }

    .tb-input-group {
        position: relative;
        margin-bottom: 1rem;
    }
    .tb-input {
        width: 100%;
        border: 1.5px solid #ddd;
        border-radius: 10px;
        padding: .72rem 2.6rem .72rem .95rem;
        font-size: .95rem;
        color: #222;
        outline: none;
        transition: border-color .18s, box-shadow .18s;
        background: #fff;
        box-sizing: border-box;
    }
    .tb-input:focus {
        border-color: #00c853;
        box-shadow: 0 0 0 3px rgba(0,200,83,.12);
    }
    .tb-input::placeholder { color: #bbb; }
    .tb-input-icon {
        position: absolute;
        right: .85rem; top: 50%;
        transform: translateY(-50%);
        color: #aaa;
        font-size: .95rem;
        cursor: pointer;
        user-select: none;
        background: none;
        border: none;
        padding: 0;
        display: flex; align-items: center;
        transition: color .15s;
    }
    .tb-input-icon:hover { color: #555; }

    .tb-btn-continue {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: .78rem;
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        cursor: pointer;
        transition: opacity .2s, box-shadow .2s, transform .12s;
        background: linear-gradient(90deg, #00c853, #00bcd4);
        box-shadow: 0 4px 16px rgba(0,200,83,.3);
        margin-bottom: .75rem;
        letter-spacing: .2px;
    }
    .tb-btn-continue:hover {
        opacity: .9;
        transform: translateY(-1px);
        box-shadow: 0 6px 22px rgba(0,200,83,.38);
    }
    .tb-btn-continue:active { transform: translateY(0); }

    .tb-card-footer-links {
        text-align: center;
        margin-bottom: .6rem;
        font-size: .88rem;
        color: #888;
    }
    .tb-card-footer-links a {
        color: #00c853;
        font-weight: 600;
        text-decoration: none;
        margin-left: .25rem;
    }
    .tb-card-footer-links a:hover { text-decoration: underline; }

    .tb-card-body .alert-danger {
        border-radius: 8px;
        font-size: .85rem;
        padding: .6rem .9rem;
    }

    .field-validation-error {
        color: #dc3545;
        font-size: .8rem;
        margin-top: .2rem;
        display: block;
    }
</style>

<div class="tb-login-wrap">
    <div class="tb-login-card">

        <div class="tb-card-header">
            <div class="tb-header-top">
                <span class="tb-logo-text">TicketHub</span>
                <div class="tb-header-right">
                    <span class="tb-mascot">🎟</span>
                    <a href="/" class="tb-close-btn" title="Đóng">✕</a>
                </div>
            </div>
            <h1 class="tb-header-title">Tạo Tài Khoản</h1>
            <p class="tb-header-sub">Đăng ký để đặt vé dễ dàng hơn</p>
        </div>

        <div class="tb-card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small"></div>

                <div style="display:flex; gap:.75rem;">
                    <div style="flex:1; min-width:0;">
                        <label class="tb-field-label" asp-for="Input.Ho">Họ</label>
                        <div class="tb-input-group">
                            <input asp-for="Input.Ho" class="tb-input" placeholder="Nguyễn Văn" autocomplete="family-name" />
                        </div>
                        <span asp-validation-for="Input.Ho" class="field-validation-error" style="margin-top:-.6rem; margin-bottom:.6rem;"></span>
                    </div>
                    <div style="flex:1; min-width:0;">
                        <label class="tb-field-label" asp-for="Input.Ten">Tên</label>
                        <div class="tb-input-group">
                            <input asp-for="Input.Ten" class="tb-input" placeholder="An" autocomplete="given-name" />
                        </div>
                        <span asp-validation-for="Input.Ten" class="field-validation-error" style="margin-top:-.6rem; margin-bottom:.6rem;"></span>
                    </div>
                </div>

                <label class="tb-field-label" asp-for="Input.UserName">Tên người dùng</label>
                <div class="tb-input-group">
                    <input asp-for="Input.UserName" class="tb-input" placeholder="vd: nguyenvana" autocomplete="username" />
                </div>
                <span asp-validation-for="Input.UserName" class="field-validation-error" style="margin-top:-.6rem; margin-bottom:.6rem;"></span>

                <label class="tb-field-label" asp-for="Input.Email">Email</label>
                <div class="tb-input-group">
                    <input asp-for="Input.Email" class="tb-input" placeholder="email@example.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Input.Email" class="field-validation-error" style="margin-top:-.6rem; margin-bottom:.6rem;"></span>

                <label class="tb-field-label" asp-for="Input.Password">Mật Khẩu</label>
                <div class="tb-input-group">
                    <input asp-for="Input.Password" id="regPassword" type="password"
                           class="tb-input" placeholder="Tối thiểu 6 ký tự, 1 chữ hoa, 1 ký tự đặc biệt" autocomplete="new-password" required minlength="6" />
                    <button type="button" class="tb-input-icon" onclick="togglePwd('regPassword','eyePwd')"
                            title="Hiện/ẩn mật khẩu">
                        <span id="eyePwd">👁</span>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="field-validation-error" style="margin-top:-.6rem; margin-bottom:.6rem;"></span>

                <label class="tb-field-label" asp-for="Input.ConfirmPassword">Xác Nhận Mật Khẩu</label>
                <div class="tb-input-group" style="margin-bottom:1.25rem;">
                    <input asp-for="Input.ConfirmPassword" id="regConfirm" type="password"
                           class="tb-input" placeholder="Nhập lại mật khẩu" autocomplete="new-password" required minlength="6" />
                    <button type="button" class="tb-input-icon" onclick="togglePwd('regConfirm','eyeConfirm')"
                            title="Hiện/ẩn mật khẩu">
                        <span id="eyeConfirm">👁</span>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error" style="margin-top:-.85rem; margin-bottom:.75rem;"></span>

                <button type="submit" class="tb-btn-continue">Đăng Ký</button>
            </form>

            <div class="tb-card-footer-links">
                <span>Đã có tài khoản?</span>
                <a asp-page="/Account/Login">Đăng nhập</a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    function togglePwd(inputId, iconId) {
        var inp = document.getElementById(inputId);
        var icon = document.getElementById(iconId);
        if (inp.type === 'password') {
            inp.type = 'text';
            icon.textContent = '🙈';
        } else {
            inp.type = 'password';
            icon.textContent = '👁';
        }
    }
    </script>
}

