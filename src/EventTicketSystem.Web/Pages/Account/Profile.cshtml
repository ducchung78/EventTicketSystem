@page
@model EventTicketSystem.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Thông Tin Tài Khoản";
}

<style>
    .prof-wrap {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 2.5rem 1rem 3rem;
        min-height: calc(100vh - 120px);
    }

    .prof-card {
        width: 100%;
        max-width: 520px;
        background: rgba(20,10,52,.92);
        border: 1px solid rgba(124,77,255,.32);
        border-radius: 18px;
        backdrop-filter: blur(18px);
        box-shadow: 0 8px 48px rgba(0,0,0,.45), 0 2px 12px rgba(124,77,255,.18);
        overflow: hidden;
    }

    .prof-header {
        background: linear-gradient(135deg, #7c4dff 0%, #448aff 100%);
        padding: 1.75rem 1.75rem 2.4rem;
        position: relative;
        overflow: hidden;
        text-align: center;
    }
    .prof-header::after {
        content: '';
        position: absolute;
        bottom: -24px; left: -5%; right: -5%;
        height: 48px;
        background: rgba(20,10,52,.92);
        border-radius: 50%;
    }
    .prof-avatar {
        width: 80px; height: 80px;
        border-radius: 50%;
        background: rgba(255,255,255,.2);
        border: 3px solid rgba(255,255,255,.45);
        display: flex; align-items: center; justify-content: center;
        font-size: 2rem; margin: 0 auto .85rem;
        position: relative; z-index: 1;
        overflow: hidden; cursor: pointer;
    }
    .prof-avatar img {
        width: 100%; height: 100%; object-fit: cover; display: block;
    }
    .prof-avatar-overlay {
        position: absolute; inset: 0; border-radius: 50%;
        background: rgba(0,0,0,.5);
        display: flex; align-items: center; justify-content: center;
        opacity: 0; transition: opacity .18s;
        font-size: .7rem; color: #fff; text-align: center;
        flex-direction: column; gap: 2px; cursor: pointer;
    }
    .prof-avatar:hover .prof-avatar-overlay { opacity: 1; }
    .prof-avatar-hint {
        font-size: .72rem; color: rgba(255,255,255,.55);
        margin-top: .3rem; margin-bottom: .5rem;
    }
    .prof-header-name {
        color: #fff; font-size: 1.3rem; font-weight: 800;
        margin: 0 0 .2rem; position: relative; z-index: 1;
    }
    .prof-header-email {
        color: rgba(255,255,255,.75); font-size: .85rem;
        position: relative; z-index: 1;
    }

    .prof-body { padding: 2rem 1.75rem 1.75rem; }

    .prof-stat-row {
        display: flex; gap: 10px; margin-bottom: 1.75rem;
    }
    .prof-stat {
        flex: 1;
        background: rgba(124,77,255,.1);
        border: 1px solid rgba(124,77,255,.22);
        border-radius: 12px;
        padding: 12px;
        text-align: center;
    }
    .prof-stat-num { font-size: 1.5rem; font-weight: 800; color: #ede0ff; line-height: 1; }
    .prof-stat-lbl { font-size: .7rem; color: rgba(210,195,255,.45); text-transform: uppercase; letter-spacing: .05em; margin-top: 3px; }

    .prof-section-title {
        font-size: .75rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: .07em;
        color: rgba(124,77,255,.75);
        margin-bottom: .85rem; padding-bottom: .6rem;
        border-bottom: 1px solid rgba(124,77,255,.15);
    }

    .prof-field { margin-bottom: 1.1rem; }
    .prof-label {
        display: block;
        font-size: .8rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: .06em;
        color: rgba(200,185,255,.6);
        margin-bottom: .32rem;
    }
    .prof-input {
        width: 100%;
        background: rgba(255,255,255,.06);
        border: 1.5px solid rgba(124,77,255,.28);
        border-radius: 10px;
        padding: .72rem .95rem;
        font-size: .95rem;
        color: #ede0ff;
        outline: none;
        transition: border-color .18s, box-shadow .18s;
        box-sizing: border-box;
    }
    .prof-input:focus {
        border-color: rgba(0,200,83,.6);
        box-shadow: 0 0 0 3px rgba(0,200,83,.12);
        background: rgba(255,255,255,.09);
    }
    .prof-input::placeholder { color: rgba(210,195,255,.28); }
    .prof-input[readonly] {
        background: rgba(255,255,255,.03);
        color: rgba(210,195,255,.45);
        border-color: rgba(124,77,255,.15);
        cursor: default;
    }
    .prof-validation {
        color: #ef9a9a; font-size: .78rem; margin-top: .25rem; display: block;
    }

    .prof-alert-success {
        background: rgba(0,200,83,.1);
        border: 1px solid rgba(0,200,83,.3);
        border-radius: 10px;
        padding: .65rem 1rem;
        margin-bottom: 1.25rem;
        font-size: .85rem;
        color: #69f0ae;
        display: flex; align-items: center; gap: 8px;
    }
    .prof-alert-error {
        background: rgba(229,57,53,.1);
        border: 1px solid rgba(229,57,53,.3);
        border-radius: 10px;
        padding: .65rem 1rem;
        margin-bottom: 1.25rem;
        font-size: .85rem;
        color: #ef9a9a;
    }

    .prof-btn {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: .8rem;
        font-size: .97rem; font-weight: 700;
        color: #fff; cursor: pointer;
        background: linear-gradient(90deg, #00c853, #00bcd4);
        box-shadow: 0 4px 18px rgba(0,200,83,.3);
        transition: opacity .2s, transform .12s;
        margin-top: .4rem;
    }
    .prof-btn:hover { opacity: .88; transform: translateY(-1px); }
    .prof-btn:active { transform: translateY(0); }

    .prof-links {
        display: flex; gap: 8px; margin-top: 1.25rem;
    }
    .prof-link-btn {
        flex: 1; text-align: center;
        padding: 9px;
        border-radius: 10px;
        font-size: .82rem; font-weight: 600;
        text-decoration: none;
        border: 1px solid rgba(124,77,255,.3);
        background: rgba(124,77,255,.1);
        color: rgba(210,195,255,.75);
        transition: background .15s, border-color .15s;
    }
    .prof-link-btn:hover {
        background: rgba(124,77,255,.2);
        border-color: rgba(124,77,255,.5);
        color: #ede0ff;
    }

    .prof-member-since {
        text-align: center;
        margin-top: 1.25rem;
        font-size: .78rem;
        color: rgba(210,195,255,.28);
    }
</style>

<div class="prof-wrap">
    <div class="prof-card">

        <div class="prof-header">
            <div class="prof-avatar" id="avatarCircle" onclick="document.getElementById('avatarFileInput').click()" title="Đổi ảnh đại diện">
                @if (!string.IsNullOrEmpty(Model.CurrentUser?.AvatarUrl))
                {
                    <img src="@Model.CurrentUser.AvatarUrl" alt="Ảnh đại diện" />
                }
                else
                {
                    <span>👤</span>
                }
                <div class="prof-avatar-overlay">
                    <span>📷</span>
                    <span>Đổi ảnh</span>
                </div>
            </div>
            <div class="prof-avatar-hint">Nhấn vào ảnh để thay đổi</div>
            <div class="prof-header-name">@(Model.CurrentUser?.HoTen ?? "Người dùng")</div>
            <div class="prof-header-email">@Model.CurrentUser?.Email</div>
        </div>

        <div class="prof-body">

            <div class="prof-stat-row">
                <div class="prof-stat">
                    <div class="prof-stat-num">@Model.OrderCount</div>
                    <div class="prof-stat-lbl">Đơn hàng</div>
                </div>
                <div class="prof-stat">
                    <div class="prof-stat-num" style="color:#69f0ae;">✓</div>
                    <div class="prof-stat-lbl">Đã xác minh</div>
                </div>
                <div class="prof-stat">
                    <div class="prof-stat-num" style="font-size:1rem;">@Model.CurrentUser?.NgayTao.ToString("MM/yyyy")</div>
                    <div class="prof-stat-lbl">Thành viên từ</div>
                </div>
            </div>

            <div class="prof-section-title">Chỉnh Sửa Thông Tin</div>

            @if (Model.SavedOk)
            {
                <div class="prof-alert-success">✅ Thông tin tài khoản đã được cập nhật thành công!</div>
            }

            <form method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="prof-alert-error"></div>
                <span asp-validation-for="AvatarFile" class="prof-validation" style="display:block;margin-bottom:.75rem;"></span>

                @* Hidden file input — triggered by clicking avatar circle *@
                <input type="file" id="avatarFileInput" name="AvatarFile" accept=".jpg,.jpeg,.png,.webp"
                       style="display:none;" onchange="this.form.submit()" />

                <div class="prof-field">
                    <label class="prof-label">Họ Và Tên <span style="color:#ef5350;">*</span></label>
                    <input asp-for="Input.HoTen" class="prof-input" placeholder="Nguyễn Văn A" autocomplete="name" />
                    <span asp-validation-for="Input.HoTen" class="prof-validation"></span>
                </div>

                <div class="prof-field">
                    <label class="prof-label">Email</label>
                    <input type="email" class="prof-input" value="@Model.CurrentUser?.Email" readonly />
                </div>

                <div class="prof-field">
                    <label class="prof-label">Số Điện Thoại</label>
                    <input asp-for="Input.PhoneNumber" class="prof-input" placeholder="0901234567 (tùy chọn)" autocomplete="tel" />
                    <span asp-validation-for="Input.PhoneNumber" class="prof-validation"></span>
                </div>

                <button type="submit" class="prof-btn">💾 Lưu Thay Đổi</button>
            </form>

            <div class="prof-links">
                <a href="/Account/ChangePassword" class="prof-link-btn">🔒 Đổi Mật Khẩu</a>
                <a href="/Orders/MyOrders" class="prof-link-btn">🎫 Vé Của Tôi</a>
            </div>

        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
