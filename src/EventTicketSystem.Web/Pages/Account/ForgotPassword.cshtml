@page
@model EventTicketSystem.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên Mật Khẩu";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<style>
    .tb-login-wrap {
        display: flex; justify-content: center; align-items: flex-start;
        padding: 2.5rem 1rem 3rem; min-height: calc(100vh - 120px);
    }
    .tb-login-card {
        width: 100%; max-width: 440px; background: #fff;
        border-radius: 16px; box-shadow: 0 8px 40px rgba(0,0,0,.18), 0 2px 8px rgba(0,0,0,.08);
        overflow: hidden;
    }
    .tb-card-header {
        background: linear-gradient(135deg,#7c4dff,#448aff);
        padding: 1.45rem 1.5rem 2.2rem; position: relative; overflow: hidden;
    }
    .tb-card-header::after {
        content: ''; position: absolute; bottom: -24px; left: -5%; right: -5%;
        height: 48px; background: #fff; border-radius: 50%;
    }
    .tb-header-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: .5rem; }
    .tb-logo-text  { color: #fff; font-size: 1.45rem; font-weight: 800; letter-spacing: -.5px; }
    .tb-close-btn  {
        width: 28px; height: 28px; border-radius: 50%; background: rgba(255,255,255,.25);
        border: none; color: #fff; font-size: 1rem; display: flex; align-items: center;
        justify-content: center; cursor: pointer; text-decoration: none; transition: background .15s;
    }
    .tb-close-btn:hover { background: rgba(255,255,255,.4); color: #fff; }
    .tb-header-title { color: #fff; font-size: 1.5rem; font-weight: 800; margin: 0 0 .15rem; }
    .tb-header-sub  { color: rgba(255,255,255,.85); font-size: .88rem; margin: 0; }
    .tb-card-body   { padding: 2rem 1.75rem 1.75rem; }
    .tb-input {
        width: 100%; border: 1.5px solid #ddd; border-radius: 10px;
        padding: .72rem .95rem; font-size: .95rem; color: #222;
        outline: none; transition: border-color .18s, box-shadow .18s;
        background: #fff; box-sizing: border-box; margin-bottom: .25rem;
    }
    .tb-input:focus { border-color: #7c4dff; box-shadow: 0 0 0 3px rgba(124,77,255,.12); }
    .tb-input::placeholder { color: #bbb; }
    .tb-btn {
        width: 100%; border: none; border-radius: 10px; padding: .78rem;
        font-size: 1rem; font-weight: 700; color: #fff; cursor: pointer;
        background: linear-gradient(90deg,#7c4dff,#448aff);
        box-shadow: 0 4px 16px rgba(124,77,255,.3); margin-top: .75rem;
        transition: opacity .2s, transform .12s;
    }
    .tb-btn:hover { opacity: .9; transform: translateY(-1px); }
    .field-err { color: #c0392b; font-size: .8rem; display: block; margin-bottom: .5rem; }
    .alert-danger { border-radius: 8px; font-size: .85rem; padding: .6rem .9rem; }
    .back-link { display: block; text-align: center; margin-top: 1rem; font-size: .85rem; color: #7c4dff; font-weight: 600; text-decoration: none; }
    .back-link:hover { text-decoration: underline; }
</style>

<div class="tb-login-wrap">
    <div class="tb-login-card">

        <div class="tb-card-header">
            <div class="tb-header-top">
                <span class="tb-logo-text">TicketHub</span>
                <a href="/Account/Login" class="tb-close-btn" title="Đóng">✕</a>
            </div>
            <h1 class="tb-header-title">🔑 Quên Mật Khẩu</h1>
            <p class="tb-header-sub">Nhập email để nhận liên kết đặt lại mật khẩu</p>
        </div>

        <div class="tb-card-body">
            @if (Model.EmailSent)
            {
                <div style="text-align:center; padding: 1rem 0;">
                    <div style="font-size:2.5rem; margin-bottom:.75rem;">📬</div>
                    <div style="font-size:1.05rem; font-weight:700; color:#2e7d32; margin-bottom:.5rem;">
                        Đã gửi liên kết đặt lại mật khẩu!
                    </div>
                    <p style="font-size:.88rem; color:#555; line-height:1.6;">
                        Nếu email <strong>@Model.Input.Email</strong> tồn tại trong hệ thống,
                        chúng tôi đã gửi một liên kết đặt lại mật khẩu.<br />
                        Vui lòng kiểm tra hộp thư (kể cả mục Spam).
                    </p>
                    <p style="font-size:.8rem; color:#999;">Liên kết có hiệu lực trong <strong>1 giờ</strong>.</p>
                </div>
                <a href="/Account/Login" class="tb-btn" style="display:block; text-align:center; text-decoration:none; margin-top:.5rem;">
                    ← Quay lại Đăng Nhập
                </a>
            }
            else
            {
                <p style="color:#555; font-size:.88rem; margin-bottom:1.25rem;">
                    Nhập địa chỉ email bạn đã dùng để đăng ký. Chúng tôi sẽ gửi liên kết đặt lại mật khẩu trong vòng vài giây.
                </p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small"></div>

                    <label style="display:block; color:#555; font-size:.85rem; font-weight:600; margin-bottom:.35rem;">
                        Email đã đăng ký
                    </label>
                    <input asp-for="Input.Email" class="tb-input" type="email"
                           placeholder="example@email.com" autocomplete="email" />
                    <span asp-validation-for="Input.Email" class="field-err"></span>

                    <button type="submit" class="tb-btn">📨 Gửi Liên Kết Đặt Lại</button>
                </form>

                <a href="/Account/Login" class="back-link">← Quay lại Đăng Nhập</a>
            }
        </div>

    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
