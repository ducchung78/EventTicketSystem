@page
@model EventTicketSystem.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt Lại Mật Khẩu";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<style>
    .tb-login-wrap {
        display: flex; justify-content: center; align-items: flex-start;
        padding: 2.5rem 1rem 3rem; min-height: calc(100vh - 120px);
    }
    .tb-login-card {
        width: 100%; max-width: 440px; background: #fff;
        border-radius: 16px; box-shadow: 0 8px 40px rgba(0,0,0,.18), 0 2px 8px rgba(0,0,0,.08);
        overflow: hidden;
    }
    .tb-card-header {
        background: linear-gradient(135deg,#00c853,#00bcd4);
        padding: 1.45rem 1.5rem 2.2rem; position: relative; overflow: hidden;
    }
    .tb-card-header::after {
        content: ''; position: absolute; bottom: -24px; left: -5%; right: -5%;
        height: 48px; background: #fff; border-radius: 50%;
    }
    .tb-header-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: .5rem; }
    .tb-logo-text  { color: #fff; font-size: 1.45rem; font-weight: 800; letter-spacing: -.5px; }
    .tb-header-title { color: #fff; font-size: 1.5rem; font-weight: 800; margin: 0 0 .15rem; }
    .tb-header-sub  { color: rgba(255,255,255,.85); font-size: .88rem; margin: 0; }
    .tb-card-body   { padding: 2rem 1.75rem 1.75rem; }
    .tb-input-group { position: relative; margin-bottom: .9rem; }
    .tb-input {
        width: 100%; border: 1.5px solid #ddd; border-radius: 10px;
        padding: .72rem 2.6rem .72rem .95rem; font-size: .95rem; color: #222;
        outline: none; transition: border-color .18s, box-shadow .18s;
        background: #fff; box-sizing: border-box;
    }
    .tb-input:focus { border-color: #00c853; box-shadow: 0 0 0 3px rgba(0,200,83,.12); }
    .tb-input::placeholder { color: #bbb; }
    .tb-input-icon {
        position: absolute; right: .85rem; top: 50%; transform: translateY(-50%);
        color: #aaa; font-size: .95rem; cursor: pointer; user-select: none;
        background: none; border: none; padding: 0; display: flex; align-items: center;
        transition: color .15s;
    }
    .tb-input-icon:hover { color: #555; }
    .tb-btn {
        width: 100%; border: none; border-radius: 10px; padding: .78rem;
        font-size: 1rem; font-weight: 700; color: #fff; cursor: pointer;
        background: linear-gradient(90deg,#00c853,#00bcd4);
        box-shadow: 0 4px 16px rgba(0,200,83,.3); margin-top: .25rem;
        transition: opacity .2s, transform .12s;
    }
    .tb-btn:hover { opacity: .9; transform: translateY(-1px); }
    .field-err { color: #c0392b; font-size: .8rem; display: block; margin-top: .2rem; }
    .alert-danger { border-radius: 8px; font-size: .85rem; padding: .6rem .9rem; }
    .strength-bar { height: 4px; border-radius: 2px; background: #eee; margin-top: 6px; overflow: hidden; }
    .strength-fill { height: 100%; border-radius: 2px; transition: width .3s, background .3s; }
    .strength-hint { font-size: .72rem; color: #aaa; margin-top: 3px; }
    .invalid-link-box {
        text-align: center; padding: 1.5rem 1rem;
        background: #fff5f5; border: 1px solid #ffcdd2; border-radius: 12px;
    }
</style>

<div class="tb-login-wrap">
    <div class="tb-login-card">

        <div class="tb-card-header">
            <div class="tb-header-top">
                <span class="tb-logo-text">TicketHub</span>
            </div>
            <h1 class="tb-header-title">🔐 Đặt Lại Mật Khẩu</h1>
            <p class="tb-header-sub">Tạo mật khẩu mới cho tài khoản của bạn</p>
        </div>

        <div class="tb-card-body">
            @if (Model.InvalidLink)
            {
                <div class="invalid-link-box">
                    <div style="font-size:2rem; margin-bottom:.75rem;">⛔</div>
                    <div style="font-size:1rem; font-weight:700; color:#c62828; margin-bottom:.5rem;">
                        Liên kết không hợp lệ
                    </div>
                    <p style="font-size:.88rem; color:#555;">
                        Liên kết đặt lại mật khẩu không hợp lệ hoặc đã hết hạn.<br />
                        Vui lòng gửi yêu cầu mới.
                    </p>
                    <a href="/Account/ForgotPassword"
                       style="display:inline-block; margin-top:.75rem; padding:.6rem 1.5rem;
                              background:#7c4dff; color:#fff; border-radius:8px; font-weight:600;
                              text-decoration:none; font-size:.9rem;">
                        Yêu cầu link mới
                    </a>
                </div>
            }
            else
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small"></div>

                <form method="post">
                    <input asp-for="Input.Token" type="hidden" />
                    <input asp-for="Input.Email" type="hidden" />

                    <label style="display:block; color:#555; font-size:.85rem; font-weight:600; margin-bottom:.35rem;">
                        Mật khẩu mới
                    </label>
                    <div class="tb-input-group">
                        <input asp-for="Input.Password" id="newPwd" type="password"
                               class="tb-input" placeholder="Ít nhất 6 ký tự"
                               autocomplete="new-password" oninput="checkStrength(this.value)" />
                        <button type="button" class="tb-input-icon" onclick="togglePwd('newPwd','eye1')">
                            <span id="eye1">👁</span>
                        </button>
                    </div>
                    <div class="strength-bar"><div class="strength-fill" id="strengthFill" style="width:0%"></div></div>
                    <div class="strength-hint" id="strengthHint"></div>
                    <span asp-validation-for="Input.Password" class="field-err"></span>

                    <label style="display:block; color:#555; font-size:.85rem; font-weight:600; margin:.85rem 0 .35rem;">
                        Xác nhận mật khẩu
                    </label>
                    <div class="tb-input-group">
                        <input asp-for="Input.ConfirmPassword" id="confirmPwd" type="password"
                               class="tb-input" placeholder="Nhập lại mật khẩu"
                               autocomplete="new-password" />
                        <button type="button" class="tb-input-icon" onclick="togglePwd('confirmPwd','eye2')">
                            <span id="eye2">👁</span>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="field-err"></span>

                    <button type="submit" class="tb-btn">✅ Đặt Lại Mật Khẩu</button>
                </form>
            }
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    function togglePwd(inputId, eyeId) {
        const inp = document.getElementById(inputId);
        const eye = document.getElementById(eyeId);
        if (inp.type === 'password') { inp.type = 'text'; eye.textContent = '🙈'; }
        else { inp.type = 'password'; eye.textContent = '👁'; }
    }

    function checkStrength(val) {
        const fill = document.getElementById('strengthFill');
        const hint = document.getElementById('strengthHint');
        let score = 0;
        if (val.length >= 6)  score++;
        if (val.length >= 10) score++;
        if (/[A-Z]/.test(val)) score++;
        if (/[0-9]/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;

        const levels = [
            { w: '0%',   bg: '#eee',    txt: '' },
            { w: '25%',  bg: '#e53935', txt: 'Quá yếu' },
            { w: '50%',  bg: '#ffa726', txt: 'Trung bình' },
            { w: '75%',  bg: '#ffd740', txt: 'Khá mạnh' },
            { w: '90%',  bg: '#66bb6a', txt: 'Mạnh' },
            { w: '100%', bg: '#00c853', txt: 'Rất mạnh 💪' },
        ];
        const lv = levels[Math.min(score, 5)];
        fill.style.width = lv.w;
        fill.style.background = lv.bg;
        hint.textContent = lv.txt;
        hint.style.color = lv.bg;
    }
    </script>
}
