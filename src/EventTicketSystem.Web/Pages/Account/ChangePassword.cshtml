@page
@model EventTicketSystem.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Đổi Mật Khẩu";
}

<style>
    .chpwd-wrap {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 2.5rem 1rem 3rem;
        min-height: calc(100vh - 120px);
    }

    .chpwd-card {
        width: 100%;
        max-width: 460px;
        background: rgba(20,10,52,.92);
        border: 1px solid rgba(124,77,255,.32);
        border-radius: 18px;
        backdrop-filter: blur(18px);
        box-shadow: 0 8px 48px rgba(0,0,0,.45), 0 2px 12px rgba(124,77,255,.18);
        overflow: hidden;
    }

    .chpwd-header {
        background: linear-gradient(135deg, #7c4dff 0%, #448aff 100%);
        padding: 1.5rem 1.75rem 2.2rem;
        position: relative;
        overflow: hidden;
    }
    .chpwd-header::after {
        content: '';
        position: absolute;
        bottom: -24px; left: -5%; right: -5%;
        height: 48px;
        background: rgba(20,10,52,.92);
        border-radius: 50%;
    }
    .chpwd-header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: .5rem;
    }
    .chpwd-logo { color: #fff; font-size: 1.3rem; font-weight: 800; letter-spacing: -.4px; }
    .chpwd-close {
        width: 28px; height: 28px;
        border-radius: 50%;
        background: rgba(255,255,255,.22);
        border: none; color: #fff;
        font-size: .95rem;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; text-decoration: none;
        transition: background .15s; padding: 0; line-height: 1;
    }
    .chpwd-close:hover { background: rgba(255,255,255,.38); color: #fff; }
    .chpwd-header-title { color: #fff; font-size: 1.45rem; font-weight: 800; margin: 0 0 .15rem; }
    .chpwd-header-sub { color: rgba(255,255,255,.8); font-size: .88rem; margin: 0; }

    .chpwd-body { padding: 2rem 1.75rem 1.75rem; }

    .chpwd-field { margin-bottom: 1.15rem; }
    .chpwd-label {
        display: block;
        font-size: .8rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: .06em;
        color: rgba(200,185,255,.65);
        margin-bottom: .35rem;
    }
    .chpwd-input-wrap { position: relative; }
    .chpwd-input {
        width: 100%;
        background: rgba(255,255,255,.06);
        border: 1.5px solid rgba(124,77,255,.28);
        border-radius: 10px;
        padding: .72rem 2.6rem .72rem .95rem;
        font-size: .95rem;
        color: #ede0ff;
        outline: none;
        transition: border-color .18s, box-shadow .18s;
        box-sizing: border-box;
    }
    .chpwd-input:focus {
        border-color: rgba(0,200,83,.6);
        box-shadow: 0 0 0 3px rgba(0,200,83,.12);
        background: rgba(255,255,255,.09);
    }
    .chpwd-input::placeholder { color: rgba(210,195,255,.28); }
    .chpwd-eye {
        position: absolute;
        right: .82rem; top: 50%;
        transform: translateY(-50%);
        background: none; border: none;
        color: rgba(180,165,255,.5);
        font-size: .95rem;
        cursor: pointer;
        padding: 0;
        display: flex; align-items: center;
        transition: color .15s;
    }
    .chpwd-eye:hover { color: rgba(180,165,255,.85); }

    .chpwd-validation {
        color: #ef9a9a;
        font-size: .78rem;
        margin-top: .3rem;
        display: block;
    }

    .chpwd-alert {
        background: rgba(229,57,53,.1);
        border: 1px solid rgba(229,57,53,.3);
        border-radius: 10px;
        padding: .65rem 1rem;
        margin-bottom: 1.25rem;
        font-size: .85rem;
        color: #ef9a9a;
    }

    .chpwd-btn {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: .82rem;
        font-size: 1rem; font-weight: 700;
        color: #fff;
        cursor: pointer;
        background: linear-gradient(90deg, #00c853, #00bcd4);
        box-shadow: 0 4px 18px rgba(0,200,83,.32);
        transition: opacity .2s, transform .12s;
        margin-top: .5rem;
    }
    .chpwd-btn:hover { opacity: .88; transform: translateY(-1px); }
    .chpwd-btn:active { transform: translateY(0); }

    .chpwd-back {
        text-align: center;
        margin-top: 1.1rem;
    }
    .chpwd-back a {
        color: rgba(180,165,255,.6);
        font-size: .85rem;
        text-decoration: none;
        transition: color .15s;
    }
    .chpwd-back a:hover { color: rgba(180,165,255,.9); }

    /* Success state */
    .chpwd-success {
        text-align: center;
        padding: 2rem 1.5rem 1.5rem;
    }
    .chpwd-success-icon {
        font-size: 3.5rem; display: block; margin-bottom: 1rem;
        animation: popIn .4s cubic-bezier(.34,1.56,.64,1) both;
    }
    @@keyframes popIn {
        from { transform: scale(.5); opacity: 0; }
        to   { transform: scale(1);  opacity: 1; }
    }
    .chpwd-success-title {
        font-size: 1.4rem; font-weight: 800;
        color: #69f0ae; margin-bottom: .5rem;
    }
    .chpwd-success-sub {
        color: rgba(210,195,255,.6); font-size: .9rem;
        margin-bottom: 1.5rem; line-height: 1.6;
    }
    .chpwd-success-btn {
        display: inline-block;
        padding: .72rem 1.75rem;
        border-radius: 50px;
        background: linear-gradient(90deg, #00c853, #00bcd4);
        color: #fff; font-weight: 700; font-size: .92rem;
        text-decoration: none;
        box-shadow: 0 3px 16px rgba(0,200,83,.35);
        transition: opacity .15s;
    }
    .chpwd-success-btn:hover { opacity: .87; color: #fff; }
</style>

<div class="chpwd-wrap">
    <div class="chpwd-card">

        <div class="chpwd-header">
            <div class="chpwd-header-top">
                <span class="chpwd-logo">TicketHub</span>
                <a href="/Account/Profile" class="chpwd-close" title="Quay lại">✕</a>
            </div>
            <h1 class="chpwd-header-title">🔒 Đổi Mật Khẩu</h1>
            <p class="chpwd-header-sub">Cập nhật mật khẩu để bảo vệ tài khoản của bạn.</p>
        </div>

        <div class="chpwd-body">

            @if (Model.Success)
            {
                <div class="chpwd-success">
                    <span class="chpwd-success-icon">✅</span>
                    <div class="chpwd-success-title">Đổi mật khẩu thành công!</div>
                    <p class="chpwd-success-sub">Mật khẩu của bạn đã được cập nhật.<br />Vui lòng sử dụng mật khẩu mới cho lần đăng nhập tiếp theo.</p>
                    <a href="/" class="chpwd-success-btn">🏠 Về trang chủ</a>
                </div>
            }
            else
            {
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="chpwd-alert"></div>

                    <div class="chpwd-field">
                        <label class="chpwd-label">Mật Khẩu Hiện Tại</label>
                        <div class="chpwd-input-wrap">
                            <input asp-for="Input.CurrentPassword"
                                   id="pwdCurrent"
                                   type="password"
                                   class="chpwd-input"
                                   placeholder="Nhập mật khẩu hiện tại"
                                   autocomplete="current-password" />
                            <button type="button" class="chpwd-eye" onclick="toggleEye('pwdCurrent','eyeCurrent')">
                                <span id="eyeCurrent">👁</span>
                            </button>
                        </div>
                        <span asp-validation-for="Input.CurrentPassword" class="chpwd-validation"></span>
                    </div>

                    <div class="chpwd-field">
                        <label class="chpwd-label">Mật Khẩu Mới</label>
                        <div class="chpwd-input-wrap">
                            <input asp-for="Input.NewPassword"
                                   id="pwdNew"
                                   type="password"
                                   class="chpwd-input"
                                   placeholder="Ít nhất 6 ký tự, chữ hoa, số, ký tự đặc biệt"
                                   autocomplete="new-password" />
                            <button type="button" class="chpwd-eye" onclick="toggleEye('pwdNew','eyeNew')">
                                <span id="eyeNew">👁</span>
                            </button>
                        </div>
                        <span asp-validation-for="Input.NewPassword" class="chpwd-validation"></span>
                    </div>

                    <div class="chpwd-field">
                        <label class="chpwd-label">Xác Nhận Mật Khẩu Mới</label>
                        <div class="chpwd-input-wrap">
                            <input asp-for="Input.ConfirmPassword"
                                   id="pwdConfirm"
                                   type="password"
                                   class="chpwd-input"
                                   placeholder="Nhập lại mật khẩu mới"
                                   autocomplete="new-password" />
                            <button type="button" class="chpwd-eye" onclick="toggleEye('pwdConfirm','eyeConfirm')">
                                <span id="eyeConfirm">👁</span>
                            </button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="chpwd-validation"></span>
                    </div>

                    <button type="submit" class="chpwd-btn">🔒 Đổi Mật Khẩu</button>
                </form>

                <div class="chpwd-back">
                    <a href="/Account/Profile">← Quay lại thông tin tài khoản</a>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    function toggleEye(inputId, iconId) {
        var inp = document.getElementById(inputId);
        var icon = document.getElementById(iconId);
        if (inp.type === 'password') {
            inp.type = 'text';
            icon.textContent = '🙈';
        } else {
            inp.type = 'password';
            icon.textContent = '👁';
        }
    }
    </script>
}
